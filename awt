def cmd_find(a):
    term, hits = a.term.lower(), []

    def snip(text, i):
        return text[max(0, i - 40):i + 80].replace("\n", " ")

    for r in load()["rows"]:
        text = " ".join(str(v) if not isinstance(v, list) else " ".join(map(str, v)) for k, v in r.items() if k not in ("v", "ts", "type", "host", "by"))
        i = text.lower().find(term)
        if i >= 0:
            hits.append("event:%s: %s" % (r.get("id") or r["type"], snip(text, i)))
    me = os.path.realpath(__file__)
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = sorted(d for d in dns if d not in (".git", "scratch") and not (dp == ROOT and d == ".awt") and not os.path.islink(os.path.join(dp, d))
                        and not is_node_dir(os.path.join(dp, d)))
        for n in sorted(fns):
            p = os.path.join(dp, n)
            if os.path.islink(p) or os.path.realpath(p) == me or (dp == ROOT and n == "awt"):
                continue
            try:
                if not os.path.isfile(p) or os.path.getsize(p) > K["big"]:
                    continue
                with open(p, "rb") as g:
                    b = g.read()
            except OSError:
                continue
            if b"\0" in b:
                continue
            for ln, line in enumerate(b.decode("utf-8", "replace").splitlines(), 1):
                i = line.lower().find(term)
                if i >= 0:
                    hits.append("%s:%d: %s" % (rel(p), ln, snip(line, i)))
    for h in hits[:K["hits"]]:
        out(h)
    if len(hits) > K["hits"]:
        out("+%d more" % (len(hits) - K["hits"]))


def cmd_state(a):
