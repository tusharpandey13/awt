def netmount(path):
    try:
        best = ("", "")
        for ln in subprocess.run(["mount"], capture_output=True, text=True, timeout=5).stdout.splitlines():
            m = re.match(r"(.+?) on (.+?) \((\w[\w.]*)", ln)
            if m and (path == m.group(2) or path.startswith(m.group(2).rstrip("/") + "/")) and len(m.group(2)) >= len(best[0]):
                best = (m.group(2), m.group(3))
        return best[1] in ("nfs", "smbfs", "afpfs", "cifs", "webdav", "osxfuse", "macfuse") or best[1].startswith("fuse.")
    except Exception:
        return False


def tree_problems(root):
    """Defects in the tree below root, as (level, message)."""
    probs = []
    ds, over = descendants(root)
    nodes = [root] + [p for p, _ in ds]
    if over:
        probs.append(("warn", LIMIT))
    keys = {}
    for node in nodes:
        pk, key = node_info(node)["kind"], node_info(node)["key"]
        has_projects = pk == "root" and any(node_info(c)["kind"] == "project" for c in children(node))
        if key:
            if key in keys:
                probs.append(("fail", "duplicate key %s: %s and %s" % (key, os.path.relpath(keys[key], root), os.path.relpath(node, root))))
            keys.setdefault(key, node)
        for plural in PLURAL.values():
            d = os.path.join(node, plural)
            if os.path.islink(d):
                probs.append(("warn", "%s is a symlink; it is not followed" % os.path.relpath(d, root)))
                continue
            if not os.path.isdir(d):
                continue
            try:
                names = sorted(os.listdir(d))
            except OSError:
                probs.append(("warn", "%s is unreadable; its nodes were not checked" % os.path.relpath(d, root)))
                continue
            for n in names:
                p = os.path.join(d, n)
                where = os.path.relpath(p, root)
                if n.startswith(".new-"):
                    probs.append(("warn", "leftover %s from an interrupted init; remove it" % where))
                elif os.path.islink(p):
                    probs.append(("warn", "%s is a symlink; it is not followed" % where))
                elif is_node_dir(p):
                    i = node_info(p)
                    if i["legacy"]:
                        probs.append(("warn", "%s has no node row; it is read as a task" % where))
                    if PLURAL.get(i["kind"]) != plural:
                        probs.append(("warn", "%s: a %s sits in %s/, which does not match its node row" % (where, i["kind"], plural)))
                    if i["kind"] not in LEGAL.get(pk, ()):
                        probs.append(("fail", "%s: a %s does not belong in a %s" % (where, i["kind"], pk)))
                    elif pk == "root" and i["kind"] == "workspace" and has_projects:
                        probs.append(("warn", "%s: a workspace directly under the root is the legacy placement; run migrate-paseo, or move it under a project" % where))
                else:
                    probs.append(("warn", "%s is not a node; reserved directories hold nodes only" % where))
        seen = 0
        for dp, dns, _ in os.walk(node):
            seen += 1
            keep = []
            for n in sorted(dns):
                p = os.path.join(dp, n)
                if os.path.islink(p) or n in (".git", ".awt", "scratch") or (dp == node and n in PLURAL.values()):
                    continue
                if is_node_dir(p):
                    probs.append(("warn", "%s is a node outside a reserved directory; it has no parent" % os.path.relpath(p, root)))
                else:
                    keep.append(n)
            dns[:] = keep
            if seen > K["walk"]:
                break
        if load_at(node)["status"] == "done":
            for p in children(node):
                if node_info(p)["kind"] in ("project", "workspace", "task") and load_at(p)["status"] == "active":
                    probs.append(("warn", "%s is done but %s is still active" % (os.path.relpath(node, root) if node != root else ".", os.path.relpath(p, root))))
    return probs


def cmd_doctor(a):
    global ROOT
    res = []

    def line(level, msg):
        res.append(level)
        out("%s %s" % (level, msg))

    line("ok" if sys.version_info >= (3, 9) else "fail", "python %d.%d" % sys.version_info[:2])
    ROOT = find_root(a.dir)
    if not ROOT:
        line("fail", "no task root (./awt init)")
        sys.exit(1)
    line("ok", "task root " + ROOT)
    pr = P(".awt", ".probe-%d" % os.getpid())
    try:
        fd = os.open(pr, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL, 0o644)
        os.write(fd, b"a")
        os.lseek(fd, 0, 0)
        os.write(fd, b"b")
        os.close(fd)
        with open(pr, "rb") as g:
            good = g.read() == b"ab"
        try:
            os.close(os.open(pr, os.O_WRONLY | os.O_CREAT | os.O_EXCL))
            good = False
        except FileExistsError:
            pass
        os.unlink(pr)
        line("ok" if good else "fail", "O_APPEND and O_EXCL behave")
    except OSError as x:
        line("fail", "O_APPEND/O_EXCL probe failed: %s" % x)
    intree = not node_info(ROOT)["legacy"]

    def has_block(d):
        ag = os.path.join(d, "AGENTS.md")
        return os.path.exists(ag) and BLOCK_BEGIN in open(ag, encoding="utf-8", errors="replace").read()
    has = has_block(ROOT) or (intree and any(has_block(p) for p in ancestors(ROOT)))
    line("ok" if has else "fail", "AGENTS.md has the awt block" if has else "AGENTS.md lacks the awt block (./awt init)")
    try:
        r = subprocess.run([sys.executable, os.path.realpath(__file__), "--dir", ROOT, "resume", "--hook"], capture_output=True, text=True, timeout=30)
        line("ok" if r.returncode == 0 and r.stdout.strip() else "fail", "resume --hook prints a brief")
    except Exception as x:
        line("fail", "resume --hook did not run: %s" % x)
    D = load()
    line("fail" if D["unread"] else "ok", "events.jsonl unreadable: %s (fix .awt/events.jsonl)" % D["unread"] if D["unread"] else "events.jsonl is readable")
    line("warn" if D["bad"] else "ok", "%d quarantined rows%s" % (D["bad"], " (.awt/events.jsonl lines: %s)" % ", ".join(map(str, D["bad_lines"][:20])) if D["bad_lines"] else ""))
    odd = any(m in ROOT for m in ("iCloud", "Dropbox", "OneDrive", "Google Drive")) or netmount(ROOT)
    line("warn" if odd else "ok", "path is a sync folder or network mount" if odd else "path is local")
    cm = find_claude_md(ROOT)
    line("warn" if cm else "ok", "CLAUDE.md at %s may hide AGENTS.md (add @AGENTS.md)" % cm if cm else "no CLAUDE.md in the way")
    if not intree:
        try:
            with open(P(".claude", "settings.json"), encoding="utf-8") as g:
                st = g.read()
            good = "awt resume --hook" in st
        except OSError:
            good = False
        line("ok" if good else "warn", "settings has the awt hook" if good else ".claude/settings.json lacks the awt hook")
        x = os.access(P("awt"), os.X_OK)
        line("ok" if x else "warn", "awt is executable" if x else "awt is not executable here (chmod +x awt)")
    if intree or children(ROOT):
        probs = tree_problems(ROOT)
        if os.environ.get("AWT_DIR") and not shutil.which("awt"):
            probs.append(("warn", "AWT_DIR is set but awt is not on PATH; agents calling awt will not find it"))
        for lvl, x in probs:
            line(lvl, x)
        if not probs:
            line("ok", "node tree is consistent")
    try:
        rem = git(ROOT, "remote").stdout.split() if git(ROOT, "rev-parse", "--show-toplevel").stdout.strip() == ROOT else []
    except Exception:
        rem = []
    line("warn" if rem else "ok", "git remote %s: task data would be pushed if committed; check it is private" % rem[0] if rem else "no git remote")
    try:
        with open(P(".claude", "settings.json"), encoding="utf-8", errors="replace") as g:
            old = ["line %d: %s" % (n, x.strip()) for n, x in enumerate(g.read().splitlines(), 1) if "awt effect apply" in x]
    except OSError:
        old = []
    for x in old:
        line("warn", "obsolete ask rule for 'effect apply' in .claude/settings.json; remove %s (awt does not edit it)" % x)
    bad = [e["id"] for e in D["eff"].values() if e["state"] in ("begun", "unknown")]
    line("warn" if bad else "ok", "open begun/unknown effects: " + " ".join(bad) if bad else "no begun or unknown effects")
    sys.exit(1 if "fail" in res else 0)


def cmd_save(a):
    def g(*x):
        try:
            return subprocess.run(["git", "-C", ROOT] + list(x), capture_output=True, text=True)
        except FileNotFoundError:
            die("git is not installed or not on PATH", "install git; awt never installs it")
    r = g("rev-parse", "--show-toplevel")
    if r.returncode:
        die("not a git repo", "git init  (in %s; awt never runs it)" % ROOT)
    if os.path.realpath(r.stdout.strip()) != ROOT:
        die("task sits inside another repo (%s)" % r.stdout.strip(), "git init  (in %s)" % ROOT)
    nested = []
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = [d for d in dns if d != ".git"]
        if dp != ROOT and (".git" in os.listdir(dp) or is_node_dir(dp)):
            nested.append(rel(dp))
            dns[:] = []
    if g("add", "-A", "--", ".", *[":(exclude)" + n for n in nested]).returncode:
        die("git add failed", "run git status in " + ROOT)
    held = []
    for f in [x for x in g("diff", "--cached", "--name-only", "-z").stdout.split("\0") if x]:
        try:
            if os.path.getsize(P(f)) > K["big"]:
                continue
            with open(P(f), "rb") as fh:
                b = fh.read()
        except OSError:
            continue
        n = None if b"\0" in b else secret(b.decode("utf-8", "replace"))
        if n:
            g("reset", "-q", "--", f)
            held.append("%s (%s)" % (f, n))
    for n in nested:
        print("note: nested %s not saved: %s" % ("git repo" if os.path.exists(P(n, ".git")) else "node", n), file=sys.stderr)
    for h in held:
        print("note: unstaged, looks like a secret: " + h, file=sys.stderr)
    if g("diff", "--cached", "--quiet").returncode == 0:
        return out("nothing to commit")
    r = g("commit", "--no-gpg-sign", "-q", "-m", a.message)
    if r.returncode:
        die("git commit failed: " + (r.stderr or r.stdout).strip(), "set git user.name and user.email")
    out("saved %s" % g("rev-parse", "--short", "HEAD").stdout.strip())


# ---------- main ----------
def build():
    p = argparse.ArgumentParser(prog="awt", add_help=False)
    sp = p.add_subparsers(dest="verb")

    def V(parent, name, pos=(), opt=()):
        q = parent.add_parser(name)
        for n, kw in pos:
            q.add_argument(n, **kw)
        for fl, kw in opt:
            q.add_argument(*fl, **kw)
        return q
    T, F = {}, dict(action="store_true")
    V(sp, "init", opt=[(("--goal",), T), (("--done",), T), (("--kind",), dict(choices=KINDS)), (("--name",), T), (("--key",), T)])
    V(sp, "resume", opt=[(("--hook",), F), (("--scope",), {}), (("--json",), F)])
    V(sp, "list", [("section", dict(nargs="?", choices=LISTS))], [(("--all",), F), (("--json",), F), (("--since",), T), (("--down",), F)])
    V(sp, "find", [("term", dict(nargs="?"))], [(("--up",), F), (("--down",), F), (("--tree",), F), (("--like",), T), (("--limit",), dict(type=int))])
    V(sp, "state", opt=[(("--now",), dict(required=True)), (("--next",), dict(required=True)), (("--scope",), T)])
    V(sp, "note", [("text", T)])
    V(sp, "decide", [("choice", T)], [(("--why",), dict(required=True)), (("--supersedes",), T), (("--tag",), dict(action="append")), (("--related",), dict(type=int))])
    V(sp, "ask", [("text", T)], [(("--related",), dict(type=int))])
    V(sp, "answer", [("id", T), ("text", T)])
    V(sp, "ref", [("target", T)], [(("--title",), dict(required=True)), (("--why",), T), (("--kind",), T), (("--no-access",), F)])
    V(sp, "capture", [("file", dict(nargs="?"))], [(("--from",), dict(required=True, dest="from_")), (("--title",), dict(required=True)), (("--ref",), T)])
    V(sp, "supersede", [("old", T), ("new", T)], [(("--why",), T)])
    V(sp, "status", [("value", dict(choices=ENUM["status.status"]))])
    V(sp, "doctor")
    V(sp, "save", [("message", T)])
    V(sp, "help")
    es = V(sp, "effect").add_subparsers(dest="eop")
    V(es, "plan", opt=[(("--target",), dict(required=True)), (("--body",), T), (("--how",), T), (("--after",), dict(action="append")), (("--again",), F), (("--why",), T)])
    V(es, "begin", [("id", T)])
    V(es, "show", [("id", T)])
    V(es, "mark", [("id", T), ("to", dict(choices=["sent", "not-sent", "unknown", "dropped"]))], [(("--ref",), T), (("--why",), T)])
    return p


def main(argv):
    global ROOT, BY
    BY = os.environ.get("AWT_BY") or "agent"
    for f in (sys.stdout, sys.stderr):
        f.reconfigure(encoding="utf-8", errors="backslashreplace")
    rest, d, i = [], None, 0
    while i < len(argv):
        x = argv[i]
        if x in ("--dir", "--by") and i + 1 < len(argv):
            if x == "--dir":
                d = argv[i + 1]
            else:
                BY = argv[i + 1]
            i += 2
            continue
        if x.startswith("--dir=") or x.startswith("--by="):
            if x.startswith("--dir="):
                d = x[6:]
            else:
                BY = x[5:]
        else:
            rest.append(x)
        i += 1
    if rest[:1] == ["--version"]:
        return out("awt " + VERSION)
    if rest[:2] == ["help", "agents"]:
        return out(AGENT_REF)
    if not rest or rest[0] in ("help", "--help", "-h"):
        return out(USAGE)
    if rest[:1] == ["effect"]:
        gone = rest[1:2] == ["apply"] or any(x.split("=")[0] in ("--run", "--snapshot", "--verify", "--class", "--timeout") for x in rest[1:])
        if gone:
            die("effect apply, --run, --snapshot, --verify, --class and --timeout were removed: awt never runs commands",
                "send it yourself; ./awt effect plan --target T [--body FILE] [--how TEXT], ./awt effect begin ID, then ./awt effect mark ID sent", 2)
    a = build().parse_args(rest)
    a.dir = d
    if a.verb is None or (a.verb == "effect" and not a.eop):
        die("missing verb", USAGE.splitlines()[0], 2)
    if a.verb == "help":
        return out(USAGE)
    if a.verb == "init":
        return cmd_init(a)
    if a.verb == "resume" and a.hook:
        return cmd_resume(a)
    ROOT = find_root(d)
    set_cmd()
    if not ROOT:
        if a.verb == "doctor":
            return cmd_doctor(a)
        die("no task found", "./awt init", 4)
    globals()[("eff_" + a.eop) if a.verb == "effect" else ("cmd_" + a.verb)](a)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
        sys.stdout.flush()
    except PermissionError as x:
        print("error: permission denied: %s" % x.filename, file=sys.stderr)
        print("fix: a person should run: %s" % shlex.join(["./awt"] + sys.argv[1:]), file=sys.stderr)
        sys.exit(3)
    except BrokenPipeError:
        sys.exit(0)
    except Exception as x:
        die("%s: %s" % (type(x).__name__, x), "run ./awt doctor; if the cause is not the path or file named above, report this line")
