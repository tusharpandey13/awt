def eff_mark(a):
    lock()
    e = get_eff(load(), a.id)
    st, n = e["state"], e["attempt"]
    legal = {"planned": ["sent", "dropped"], "begun": ["sent", "not-sent", "unknown"], "unknown": ["sent", "not-sent"]}.get(st, [])
    if a.to not in legal:
        die("cannot mark %s %s from %s" % (a.id, a.to, st), "legal marks from %s: %s" % (st, ", ".join(legal) or "none (terminal)"))
    if a.to in ("not-sent", "unknown") and not a.why:
        die("mark %s needs --why" % a.to, "say what you know, e.g. --why 'the command timed out'", 2)
    if a.to == "not-sent":
        emit("effect", id=a.id, step="planned", attempt=n + 1, why=a.why)
    else:
        emit("effect", id=a.id, step=a.to, attempt=n, ref=a.ref, why=a.why)
    out("%s %s" % (a.id, a.to))


