# Canonical raw store (docs/adr/0003-canonical-raw-jsonl.md). Rows are never redacted or cut; secret matches are only counted.
ADAPTER = 1
STALE_DAYS = 7


def store_dir():
    return os.environ.get("AWT_STORE") or os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "awt-store")


def claude_home():
    return os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")


def claude_dir():
    return os.environ.get("AWT_CLAUDE_PROJECTS") or os.path.join(claude_home(), "projects")


def pi_agent_dir():
    return os.path.expanduser(os.environ.get("PI_CODING_AGENT_DIR") or "~/.pi/agent")


def pi_dir():
    """The first pi session root, whose files are keyed by their path below it: AWT_PI_SESSIONS, else the default `<agent dir>/sessions`."""
    return os.environ.get("AWT_PI_SESSIONS") or os.path.join(pi_agent_dir(), "sessions")


def pi_settings_dir(settings, base):
    """The `sessionDir` of a pi settings.json (a relative one is taken from base), or None."""
    try:
        with open(settings, encoding="utf-8") as g:
            d = json.load(g).get("sessionDir")
    except (OSError, ValueError, AttributeError):
        return None
    return os.path.join(base, os.path.expanduser(d)) if isinstance(d, str) and d else None


def pi_sources():
    """(path, key, session name) of pi transcripts outside the first root: the other places pi can keep sessions (PI_CODING_AGENT_SESSION_DIR; `sessionDir` in `<agent dir>/settings.json` and,
    for a Paseo pi agent, in `<its cwd>/.pi/settings.json`; the default `<agent dir>/sessions`, unless AWT_PI_SESSIONS names the root) and the exact file of a Paseo pi agent (`persistence.nativeHandle`). Read-only.
    The key is the absolute path. A file is yielded once, however many places name it."""
    agent = pi_agent_dir()
    dirs = []
    if not os.environ.get("AWT_PI_SESSIONS"):
        dirs = [os.path.expanduser(os.environ.get("PI_CODING_AGENT_SESSION_DIR") or ""), pi_settings_dir(os.path.join(agent, "settings.json"), agent), os.path.join(agent, "sessions")]
    files = []
    base = os.path.join(paseo_home(), "agents")
    for d in sorted(os.listdir(base)) if os.path.isdir(base) else ():
        for f in sorted(os.listdir(os.path.join(base, d))) if os.path.isdir(os.path.join(base, d)) else ():
            try:
                with open(os.path.join(base, d, f), encoding="utf-8") as g:
                    a = json.load(g)
                if not f.endswith(".json") or a.get("provider") != "pi":
                    continue
            except (OSError, ValueError, AttributeError):
                continue
            if isinstance(a.get("cwd"), str) and os.path.isabs(a["cwd"]):
                dirs.append(pi_settings_dir(os.path.join(a["cwd"], ".pi", "settings.json"), a["cwd"]))
            h = (a.get("persistence") or {}).get("nativeHandle") if isinstance(a.get("persistence"), dict) else None
            if isinstance(h, str) and os.path.isabs(h):
                files.append(h)
    seen = {os.path.realpath(pi_dir())}
    for d in dirs:
        if d and os.path.realpath(d) not in seen:
            seen.add(os.path.realpath(d))
            for p, _, name in claude_sessions(d) if os.path.isdir(d) else ():
                yield p, os.path.abspath(p), name
    for p in files:
        if p.endswith(".jsonl") and os.path.isfile(p) and not os.path.islink(p) and not any(os.path.realpath(p).startswith(r + os.sep) for r in seen):
            seen.add(os.path.realpath(p))
            yield p, os.path.abspath(p), os.path.basename(p)[:-6]


def opencode_db():
    return os.environ.get("AWT_OPENCODE_DB") or os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "opencode", "opencode.db")


def paseo_home():
    return os.environ.get("AWT_PASEO_HOME") or os.path.expanduser("~/.paseo")


def private_dir(path, top=None):
    """Create path mode 700 and the missing directories between top (the store, default path) and it.
    Missing parents of top get the default mode; an existing directory is never chmodded (doctor warns instead)."""
    top = top or path
    if os.path.isdir(path):
        return
    if path == top:
        os.makedirs(os.path.dirname(path), exist_ok=True)
    else:
        private_dir(os.path.dirname(path), top)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    os.chmod(path, 0o700)


def secret_flags(o):
    if isinstance(o, str):
        return sum(len(rx.findall(o)) for _, rx in SECRETS)
    if isinstance(o, dict):
        return sum(secret_flags(k) + secret_flags(v) for k, v in o.items())
    if isinstance(o, list):
        return sum(secret_flags(v) for v in o)
    return 0


def canon(o):
    return sha(json.dumps(o, sort_keys=True).encode())


def tail_rows(path):
    """(last good seq or -1, torn) for a canonical file; heals a torn tail by ending it with a newline."""
    try:
        fd = os.open(path, os.O_RDWR)
    except FileNotFoundError:
        return -1, False
    try:
        size, torn = os.fstat(fd).st_size, False
        if size and os.pread(fd, 1, size - 1) != b"\n":
            os.pwrite(fd, b"\n", size)
            torn = True
        blk = 1 << 20
        while True:
            start = max(0, size - blk)
            chunk = os.pread(fd, size - start + 1, start)
            lines = chunk.split(b"\n")
            if start:
                lines = lines[1:]
            for ln in reversed(lines):
                try:
                    return int(json.loads(ln)["seq"]), torn
                except Exception:
                    continue
            if not start:
                return -1, torn
            blk *= 4
    finally:
        os.close(fd)


def claude_sessions(root):
    """(path, relpath, session name) for every transcript below root. Read-only; symlinks are not followed."""
    for dp, dns, fns in os.walk(root):
        dns.sort()
        for f in sorted(fns):
            p = os.path.join(dp, f)
            if f.endswith(".jsonl") and os.path.isfile(p) and not os.path.islink(p):
                r = os.path.relpath(p, root)
                parts = r.split(os.sep)
                name = f[:-6]
                if len(parts) >= 4 and parts[-2] == "subagents":
                    name = parts[-3] + "." + name
                yield p, r, name


def first_month(path, rows):
    for r in rows:
        ts = r.get("timestamp") if isinstance(r, dict) else None
        if isinstance(ts, str) and re.match(r"\d{4}-\d\d", ts):
            return ts[:7]
    return datetime.datetime.fromtimestamp(os.stat(path).st_mtime, datetime.timezone.utc).strftime("%Y-%m")


def ingest_claude(store):
    return ingest_jsonl(store, "claude", claude_dir())


def ingest_pi(store):
    return ingest_jsonl(store, "pi", pi_dir(), pi_sources)


def load_state(offp):
    try:
        with open(offp, encoding="utf-8") as g:
            state = json.load(g)
        files = state["files"]
        errors = state.get("errors")
        return files, errors if isinstance(errors, dict) else {}
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {}, {}


def ingest_jsonl(store, src, root, more=lambda: ()):
    """Append new source lines (one JSONL transcript per session: claude, pi) as canonical rows. Returns (rows written, files seen, files that failed).
    A file that fails is recorded under `errors` in the offsets file and the rest are still ingested."""
    private_dir(os.path.join(store, "ingest"), store)
    private_dir(os.path.join(store, "log", src), store)
    lock = os.open(os.path.join(store, "ingest", src + ".lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        offp = os.path.join(store, "ingest", src + ".offsets.json")
        files, errors = load_state(offp)
        used = {v.get("out") for v in files.values()}
        total, seen = 0, 0
        for path, rel_, name in itertools.chain(claude_sessions(root) if os.path.isdir(root) else (), more()):
            seen += 1
            try:
                st = os.stat(path)
                e = files.get(rel_)
                reset = e is not None and (e["inode"] != st.st_ino or st.st_size < e["offset"] or not head_ok(path, e))
                e = dict(e or dict(inode=st.st_ino, offset=0, seq=0, out=None, month=None))
                if reset:
                    e.update(inode=st.st_ino, offset=0, head=None)
                if e["offset"] == st.st_size and not reset:
                    errors.pop(rel_, None)
                    continue
                n, e2 = ingest_one(store, src, path, rel_, name, e, reset, used)
                total += n
                if e2 != files.get(rel_) or rel_ in errors:
                    files[rel_] = e2
                    errors.pop(rel_, None)
                    save_offsets(offp, files, errors)
            except FileNotFoundError:
                continue
            except Exception as x:
                errors[rel_] = "%s: %s" % (type(x).__name__, str(x)[:200])
        save_offsets(offp, files, errors, now())
        return total, seen, len(errors)
    finally:
        os.close(lock)


HEAD = 64


def head_of(path, offset):
    """Short hash of the (up to) 64 source bytes just before offset: tells a rewrite in place from an append."""
    with open(path, "rb") as g:
        g.seek(max(0, offset - HEAD))
        return sha(g.read(min(HEAD, offset)))[:16]


def head_ok(path, e):
    if not e.get("head") or not e["offset"]:
        return True  # nothing to compare (entry from before the check, or nothing read yet)
    try:
        return head_of(path, e["offset"]) == e["head"]
    except OSError:
        return True


def save_offsets(offp, files, errors, last=None):
    prev = None
    if last is None:
        try:
            with open(offp, encoding="utf-8") as g:
                prev = json.load(g).get("last_run")
        except (OSError, ValueError, AttributeError):
            pass
    tmp = "%s.%d.tmp" % (offp, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as g:
        json.dump(dict(adapter=ADAPTER, last_run=last or prev, files=files, errors=errors), g)
    os.rename(tmp, offp)


def row_bytes(row):
    """One canonical line. UTF-8 as is; a record with a lone surrogate (not encodable) is written with \\u escapes
    instead, so the file stays valid UTF-8 and valid JSON and the parsed raw is unchanged."""
    try:
        return json.dumps(row, ensure_ascii=False, separators=(",", ":")).encode() + b"\n"
    except UnicodeEncodeError:
        return json.dumps(row, ensure_ascii=True, separators=(",", ":")).encode() + b"\n"


def ingest_one(store, src, path, rel_, name, e, reset, used):
    batch, pos, lineno = [], e["offset"], 0 if reset else e.get("lines", 0)
    try:
        with open(path, "rb") as g:
            g.seek(pos)
            for raw in g:
                txt = raw.decode("utf-8", "replace").strip()
                if not raw.endswith(b"\n"):
                    try:
                        ok = isinstance(json.loads(txt), dict)
                    except ValueError:
                        ok = False
                    if not ok:
                        break  # a record still being written: wait for it
                pos += len(raw)
                lineno += 1
                if txt:
                    try:
                        batch.append((lineno - 1, json.loads(txt)))
                    except ValueError:
                        batch.append((lineno - 1, {"_unparsed": txt}))
            e["head"] = head_of(path, pos) if pos else None
    except OSError:
        return 0, e  # the source vanished or is unreadable; the store is untouched
    if e["out"] is None:
        month = first_month(path, [r for _, r in batch])
        out = name
        if out + ".jsonl" in {os.path.basename(u or "") for u in used}:
            out = "%s~%s" % (name, sha(rel_.encode())[:8])
        e["out"] = os.path.join("log", src, month, out + ".jsonl")
        used.add(e["out"])
    outp = os.path.join(store, e["out"])
    last, _ = tail_rows(outp)
    skip = {}
    if reset and last >= 0:
        with open(outp, "rb") as g:
            for ln in g:
                try:
                    h = canon(json.loads(ln)["raw"])
                    skip[h] = skip.get(h, 0) + 1
                except Exception:
                    pass
    rows, seq = [], last + 1 if reset else e["seq"]
    ts = now()
    for ref, r in batch:
        if reset and skip.get(canon(r)):
            skip[canon(r)] -= 1
            continue
        if seq <= last:
            seq += 1  # written by a run that died before saving its offset
            continue
        rows.append(row_bytes(dict(v=1, src=src, adapter=ADAPTER, session=name, seq=seq, ingested=ts,
                                   src_ref="%s:%d" % (rel_, ref), secret_flags=secret_flags(r), raw=r)))
        seq += 1
    if rows:
        private_dir(os.path.dirname(outp), store)
        fd = os.open(outp, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            for b in rows:
                os.write(fd, b)  # one append per row
        finally:
            os.close(fd)
    e.update(offset=pos, seq=seq, lines=lineno)
    return len(rows), e


def run_source(store, src, work):
    """Lock, load and save the offsets file around work(files, errors, save) -> (rows written, sources seen). Returns (rows, seen, failed)."""
    private_dir(os.path.join(store, "ingest"), store)
    private_dir(os.path.join(store, "log", src), store)
    lock = os.open(os.path.join(store, "ingest", src + ".lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        offp = os.path.join(store, "ingest", src + ".offsets.json")
        files, errors = load_state(offp)
        total, seen = work(files, errors, lambda: save_offsets(offp, files, errors))
        save_offsets(offp, files, errors, now())
        return total, seen, len(errors)
    finally:
        os.close(lock)


def append_rows(store, out, src, session, items, ref, ts):
    """Append items (raw records) to the canonical file `out` (relative to the store) as rows continuing its seq. Returns the count."""
    outp = os.path.join(store, out)
    seq = tail_rows(outp)[0] + 1
    rows = []
    for k, r in enumerate(items):
        rows.append(row_bytes(dict(v=1, src=src, adapter=ADAPTER, session=session, seq=seq + k, ingested=ts, src_ref=ref(r), secret_flags=secret_flags(r), raw=r)))
    if rows:
        private_dir(os.path.dirname(outp), store)
        fd = os.open(outp, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            for b in rows:
                os.write(fd, b)
        finally:
            os.close(fd)
    return len(rows)


def safe_name(s):
    return re.sub(r"[^A-Za-z0-9._-]", "_", str(s))[:120] or "_"


OC_COLS = {"session": ("id", "directory", "time_created", "time_updated"), "message": ("id", "session_id", "time_created", "time_updated", "data"),
           "part": ("id", "message_id", "session_id", "time_created", "time_updated", "data")}


def iso_ms(ms):
    return datetime.datetime.fromtimestamp(ms / 1000, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + "%03dZ" % (int(ms) % 1000)


def oc_known(store, out):
    """({(table, id) live in the canonical file after its tombstones}, {(table, id) ever in it})."""
    alive, seen = set(), set()
    try:
        with open(os.path.join(store, out), "rb") as g:
            for ln in g:
                try:
                    r = json.loads(ln)["raw"]
                    k = (r["table"], r["id"])
                except (ValueError, KeyError, TypeError):
                    continue
                seen.add(k)
                alive.discard(k) if r.get("deleted") else alive.add(k)
    except OSError:
        pass
    return alive, seen


def ingest_opencode(store):
    """opencode.db (read-only) as canonical rows: one per session, message and part row, raw = its columns with `data` parsed.
    Incremental per session by max time_updated; a row changed since is appended again and the store keeps the last one. A row opencode deleted since (revert, deleted session) is appended as a tombstone
    `{table, id, session_id, deleted: true}` (found by comparing the ids it still holds with the file's, only when their count changed); the file keeps the history, the derivation drops the row. Unknown schema: recorded as an error, nothing read."""
    path = opencode_db()

    def work(files, errors, save):
        if not os.path.isfile(path):
            return 0, 0
        total, ts = 0, now()
        errors.pop("opencode.db", None)
        try:
            # a WAL database without its -wal file is idle: immutable=1 stops sqlite creating -wal and -shm beside the user's file; with them present opencode is live, so mode=ro only
            db = sqlite3.connect("file:%s?mode=ro%s" % (urllib.parse.quote(path), "" if os.path.exists(path + "-wal") else "&immutable=1"), uri=True)
        except sqlite3.Error as x:
            errors["opencode.db"] = "%s: %s" % (type(x).__name__, str(x)[:200])
            return 0, 0
        try:
            try:
                for t, need in OC_COLS.items():
                    have = {r[1] for r in db.execute("PRAGMA table_info(%s)" % t)}
                    if not set(need) <= have:
                        raise ValueError("unknown opencode schema: %s lacks %s" % (t, ", ".join(sorted(set(need) - have)) if have else "the table"))
                scols = [r[1] for r in db.execute("PRAGMA table_info(session)")]
                sessions = db.execute("SELECT * FROM session ORDER BY id").fetchall()
            except (sqlite3.Error, ValueError) as x:
                errors["opencode.db"] = "%s: %s" % (type(x).__name__, str(x)[:200])
                return 0, 0
            for sid in sorted(set(files) - {r[0] for r in sessions}):  # a session opencode deleted: tombstone everything of it that is still live
                e = files[sid]
                if e.get("out") and not e.get("gone"):
                    alive, _ = oc_known(store, e["out"])
                    total += append_rows(store, e["out"], "opencode", sid, [dict(table=t, id=i, session_id=sid, deleted=True) for t, i in sorted(alive)], lambda r: "opencode.db:%s:%s" % (r["table"], r["id"]), ts)
                    e["gone"], e["n"] = True, -1
                    save()
            for srow in sessions:
                srec = dict(zip(scols, srow))
                sid = srec["id"]
                try:
                    e = dict(files.get(sid) or dict(out=None, cursor=0, at=[]))
                    e.pop("gone", None)
                    cur, at = e["cursor"], set(e["at"])
                    live = {("session", sid)} | {(t, r[0]) for t in ("message", "part") for r in db.execute("SELECT id FROM %s WHERE session_id=?" % t, (sid,))}
                    tomb, back = [], set()
                    if e["out"] and e.get("n") != len(live):
                        alive, seen = oc_known(store, e["out"])
                        tomb = [dict(table=t, id=i, session_id=sid, deleted=True) for t, i in sorted(alive - live)]
                        back = (live & seen) - alive  # deleted earlier, back now: read again whatever its time_updated
                    items = []
                    if srec["time_updated"] >= cur:
                        items.append(("session", sid, sid, srec["time_created"], srec["time_updated"], srec, None))
                    for tbl in ("message", "part"):
                        for rid, tc, tu, data, mid in db.execute("SELECT id, time_created, time_updated, data, %s FROM %s WHERE session_id=? AND time_updated>=? ORDER BY time_created, id" % ("message_id" if tbl == "part" else "NULL", tbl), (sid, cur)):
                            try:
                                d = json.loads(data)
                            except (TypeError, ValueError):
                                d = {"_unparsed": data}
                            items.append((tbl, rid, sid, tc, tu, d, mid))
                    for tbl, rid in sorted(back):  # same columns as above, by id
                        if tbl == "session":
                            if not items or items[0][0] != "session":
                                items.insert(0, ("session", sid, sid, srec["time_created"], srec["time_updated"], srec, None))
                        elif not any(i[0] == tbl and i[1] == rid for i in items):
                            r = db.execute("SELECT time_created, time_updated, data, %s FROM %s WHERE id=?" % ("message_id" if tbl == "part" else "NULL", tbl), (rid,)).fetchone()
                            try:
                                d = json.loads(r[2])
                            except (TypeError, ValueError):
                                d = {"_unparsed": r[2]}
                            items.append((tbl, rid, sid, r[0], r[1], d, r[3]))
                    keys = lambda i: "%s:%s:%s" % (i[0], i[1], i[4])
                    new = [i for i in items if keys(i) not in at or (i[0], i[1]) in back]
                    top = max([cur] + [i[4] for i in items])
                    e["at"] = sorted(keys(i) for i in items if i[4] == top)
                    e["n"] = len(live)
                    if not new and not tomb:
                        e["cursor"] = top
                        if e != files.get(sid):
                            files[sid] = e
                            save()
                        errors.pop(sid, None)
                        continue
                    if e["out"] is None:
                        e["out"] = os.path.join("log", "opencode", iso_ms(srec["time_created"])[:7], safe_name(sid) + ".jsonl")
                    raws = tomb + [dict(table=i[0], id=i[1], session_id=i[2], **({"message_id": i[6]} if i[0] == "part" else {}), time_created=i[3], time_updated=i[4], data=i[5]) for i in new]
                    total += append_rows(store, e["out"], "opencode", sid, raws, lambda r: "opencode.db:%s:%s" % (r["table"], r["id"]), ts)
                    e["cursor"] = top
                    files[sid] = e
                    errors.pop(sid, None)
                    save()
                except sqlite3.Error as x:
                    errors[sid] = "%s: %s" % (type(x).__name__, str(x)[:200])
            return total, len(sessions)
        finally:
            db.close()
    return run_source(store, "opencode", work)


PASEO_KEYS = ("id", "provider", "cwd", "workspaceId", "createdAt")


def ingest_paseo(store):
    """The join keys of each Paseo agent (`agents/*/*.json`): id, provider, session id, cwd, workspace, creation time. Nothing else is copied (the files also hold MCP credentials)."""
    root = os.path.join(paseo_home(), "agents")

    def work(files, errors, save):
        total, seen, ts = 0, 0, now()
        for d in sorted(os.listdir(root)) if os.path.isdir(root) else ():
            dp = os.path.join(root, d)
            for f in sorted(os.listdir(dp)) if os.path.isdir(dp) and not os.path.islink(dp) else ():
                p, rel_ = os.path.join(dp, f), os.path.join(d, f)
                if not f.endswith(".json") or os.path.islink(p) or not os.path.isfile(p):
                    continue
                seen += 1
                try:
                    with open(p, encoding="utf-8") as g:
                        a = json.load(g)
                    if not isinstance(a, dict):
                        raise ValueError("not an object")
                    pers = a.get("persistence") if isinstance(a.get("persistence"), dict) else {}
                    raw = {k: a.get(k) for k in PASEO_KEYS if isinstance(a.get(k), str)}
                    raw.setdefault("id", f[:-5])
                    if isinstance(pers.get("sessionId"), str):
                        raw["sessionId"] = pers["sessionId"]
                    raw = dict(sorted(raw.items()))
                    h = canon(raw)
                    if (files.get(rel_) or {}).get("hash") == h:
                        errors.pop(rel_, None)
                        continue
                    out = os.path.join("log", "paseo", safe_name(raw["id"]) + ".jsonl")
                    total += append_rows(store, out, "paseo", raw["id"], [raw], lambda r: "agents/" + rel_, ts)
                    files[rel_] = dict(hash=h, out=out)
                    errors.pop(rel_, None)
                    save()
                except (OSError, ValueError) as x:
                    errors[rel_] = "%s: %s" % (type(x).__name__, str(x)[:200])
        return total, seen
    return run_source(store, "paseo", work)


PASEO_EVENTS = {"turn", "permission", "permission_resolved"}
PASEO_EVENT_KEYS = ("event", "eid", "agentId", "turnId", "provider", "model", "startedAt", "endedAt", "outcome", "code", "requestId", "tool", "target", "ts", "decision", "decidedBy")
STDIN_CAP = 8 << 20


def ingest_paseo_events(store, text, cut=False):
    """The Paseo pipe: JSON lines from the plugin on stdin (turn outcomes, permission requests and answers) as canonical rows in the agent's `log/paseo/<agent id>.jsonl`.
    Only known keys of an event are kept. An event id (`eid`) already stored is skipped, so a retry or a replay adds nothing."""
    def work(files, errors, save):
        total, seen, ts, by = 0, 0, now(), {}
        errors.pop("stdin", None)
        for ln in text.splitlines():
            if not ln.strip():
                continue
            seen += 1
            try:
                e = json.loads(ln)
                if not isinstance(e, dict) or not isinstance(e.get("event"), str) or e["event"] not in PASEO_EVENTS or not all(isinstance(e.get(k), str) and e[k] for k in ("eid", "agentId")):
                    raise ValueError("not a paseo event")
                by.setdefault(e["agentId"], []).append({k: e[k] for k in PASEO_EVENT_KEYS if isinstance(e.get(k), str)})
            except (ValueError, TypeError, RecursionError) as x:
                errors["stdin"] = "%s: %s (line %d of the last piped input)" % (type(x).__name__, str(x)[:100], seen)
        if cut:
            errors["stdin"] = "input over %d MiB: the rest was not read" % (STDIN_CAP >> 20)
        for aid, evs in sorted(by.items()):
            out = os.path.join("log", "paseo", safe_name(aid) + ".jsonl")
            have = set()
            try:
                with open(os.path.join(store, out), "rb") as g:
                    for ln in g:
                        try:
                            have.add(json.loads(ln)["raw"]["eid"])
                        except (ValueError, KeyError, TypeError):
                            pass
            except OSError:
                pass
            new = []
            for e in evs:
                if e["eid"] not in have:
                    have.add(e["eid"])
                    new.append(e)
            total += append_rows(store, out, "paseo", aid, new, lambda r: "stdin:" + r["eid"], ts)
        save()
        return total, seen
    return run_source(store, "paseo", work)


def ingest_paseo_all(store, piped=None, cut=False):
    """Agent files, then (when piped is not None) the piped events."""
    a = ingest_paseo(store)
    if piped is None:
        return a
    b = ingest_paseo_events(store, piped, cut)
    return (a[0] + b[0], a[1] + b[1], b[2])


CCUSAGE_KEYS = ("inputTokens", "outputTokens", "cacheCreationTokens", "cacheReadTokens", "cost", "modelName")


def ccusage_cmd():
    return os.environ.get("AWT_CCUSAGE") or "ccusage"


def ingest_ccusage(store):
    """`ccusage session --json` (run with no shell and no network of awt's own; ccusage reads the provider logs itself) as canonical rows: one per (agent, session), raw = its
    per-model token counts and cost. Only a changed session is appended again; the store keeps the last row. Not part of `all`: it runs another program over every provider log."""
    exe = shutil.which(ccusage_cmd())
    if not exe:
        die("ccusage not found (looked for %s)" % ccusage_cmd(), "install it with: npm install -g ccusage (or set AWT_CCUSAGE to its path), then: awt ingest --source ccusage")
    try:
        # own process group: the npm `ccusage` is a Node wrapper around a native binary, and a timeout must stop both
        p = subprocess.Popen([exe, "session", "--json", "--offline"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, stdin=subprocess.DEVNULL, start_new_session=True)
        try:
            so, se = p.communicate(timeout=900)
        except BaseException:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass
            p.communicate()
            raise
        r = subprocess.CompletedProcess(p.args, p.returncode, so, se)
        if r.returncode != 0:
            raise ValueError("exit %d: %s" % (r.returncode, (r.stderr or "").strip()[:200]))
        data = json.loads(r.stdout)
        sessions = data["session"]
        if not isinstance(sessions, list):
            raise ValueError("`session` is not a list")
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as x:
        die("ccusage output not usable: %s: %s" % (type(x).__name__, str(x)[:200]), "run `ccusage session --json` yourself; awt reads the `session` list (agent, period, modelBreakdowns)")

    def work(files, errors, save):
        total, seen, ts = 0, 0, now()
        for sess in sessions:
            seen += 1
            try:
                if not isinstance(sess, dict) or not all(isinstance(sess.get(k), str) and sess[k] for k in ("agent", "period")) or not isinstance(sess.get("modelBreakdowns"), list):
                    raise ValueError("not a ccusage session")
                bd = [{k: b[k] for k in CCUSAGE_KEYS if k in b} for b in sess["modelBreakdowns"] if isinstance(b, dict) and isinstance(b.get("modelName"), str)]
                raw = {"agent": sess["agent"], "period": sess["period"], "modelBreakdowns": sorted(bd, key=lambda b: b["modelName"])}
                if isinstance(sess.get("totalCost"), (int, float)):
                    raw["totalCost"] = sess["totalCost"]
                if isinstance(sess.get("metadata"), dict) and isinstance(sess["metadata"].get("lastActivity"), str):
                    raw["lastActivity"] = sess["metadata"]["lastActivity"]
                key = safe_name("%s_%s" % (raw["agent"], raw["period"]))
                h = canon(raw)
                if (files.get(key) or {}).get("hash") == h:
                    continue
                out = os.path.join("log", "ccusage", key + ".jsonl")
                total += append_rows(store, out, "ccusage", key, [raw], lambda r: "ccusage:" + key, ts)
                files[key] = dict(hash=h, out=out)
                errors.pop(key, None)
                save()
            except ValueError as x:
                errors["session#%d" % seen] = "%s: %s" % (type(x).__name__, str(x)[:100])
        return total, seen
    return run_source(store, "ccusage", work)


