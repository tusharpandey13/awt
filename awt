def lock():
    fcntl.flock(os.open(P(".awt", "events.jsonl"), os.O_RDONLY | os.O_CREAT, 0o644), fcntl.LOCK_EX)  # held to exit: check-then-write must not interleave


def body_changed(e):
    try:
        with open(P(e["body"]), "rb") as g:
            return sha(g.read()) != e.get("body_sha")
    except OSError:
        return True


def eff_plan(a):
    lock()
    D = load()
    body = bsha = None
    if a.body:
        p = inside(a.body)
        if not os.path.isfile(p):
            die("--body must be a regular file: " + a.body, "write the draft into outbox/ first")
        body = rel(p)
        with open(p, "rb") as g:
            bsha = sha(g.read())
    for x in a.after or []:
        get_eff(D, x)
    nonce = os.urandom(8).hex() if a.again else ""
    key = sha(json.dumps([a.target, bsha or "", nonce]).encode())
    for e in D["eff"].values():
        if e["key"] == key:
            if e["state"] == "dropped":
                die("%s was dropped" % e["id"], "plan it again with --again")
            return out("%s %s (already planned, nothing written)" % (e["id"], e["state"]))
    if not a.again:
        for e in D["eff"].values():
            if e["target"] == a.target and e["state"] == "unknown":
                die("%s on %s is unknown; it may already have been sent" % (e["id"], a.target),
                    "check with a person, ./awt effect mark %s sent|not-sent, or plan with --again" % e["id"])
    i = new_id("e")
    emit("effect", id=i, step="planned", attempt=1, target=a.target, key=key, body=body, body_sha=bsha, how=a.how, after=a.after, why=a.why)
    out(c("%s planned; next: ./awt effect begin %s, send it yourself, then ./awt effect mark %s sent" % (i, i, i)))


def eff_begin(a):
    lock()
    D = load()
    e = get_eff(D, a.id)
    if e["state"] != "planned":
        die("%s is %s, not planned" % (a.id, e["state"]), "only a planned effect can begin; see ./awt effect show %s" % a.id)
    for x in e.get("after") or []:
        if D["eff"].get(x, {}).get("state") != "sent":
            die("prerequisite %s is not sent" % x, "send %s first" % x)
    if e.get("body") and body_changed(e):
        die("body changed since planning", "plan again: ./awt effect plan --target %s --body %s ..." % (shlex.quote(e["target"]), e["body"]))
    os.makedirs(P(".awt", "claims"), exist_ok=True)
    try:
        os.close(os.open(claim_path(e), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
    except FileExistsError:
        die("someone else is sending %s" % a.id, "check ./awt effect show " + a.id)
    emit("effect", id=a.id, step="begun", attempt=e["attempt"])
    out("%s begun (attempt %d)" % (a.id, e["attempt"]))
    if e.get("body"):
        out("body: " + e["body"])
    if e.get("how") or e.get("run"):
        out("how: " + (e.get("how") or e["run"]))
    out("send it yourself, then ./awt effect mark %s sent [--ref URL] | not-sent --why T | unknown --why T" % a.id)


def eff_show(a):
    e = get_eff(load(), a.id)
    old = ("class", "snapshot", "verify")
    for k, v in e.items():
        if k not in ("hist", "run", "how") + old:
            out("%s: %s" % (k, v))
    if e.get("how") or e.get("run"):
        out("how: %s" % (e.get("how") or e["run"]))
    for k in old:
        if k in e:
            out("legacy %s: %s" % (k, e[k]))
    out("history:")
    for r in e["hist"]:
        out("  %s %s attempt=%s %s" % (r["ts"], r["step"], r.get("attempt", 1), r.get("reason") or r.get("ref") or r.get("why") or ""))
    for sub in ("runs", "blobs"):
        try:
            names = sorted(n for n in os.listdir(P(".awt", sub)) if sub == "blobs" or n.startswith(a.id + "."))
        except OSError:
            continue
        for n in names[:20]:
            out("legacy file: .awt/%s/%s" % (sub, n))
    if e.get("body"):
        out("body path: " + e["body"])
