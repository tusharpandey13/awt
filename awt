# Datasette over store.db (ARCHITECTURE-v2 section 4, ADR 0005). Nothing is vendored: awt writes a metadata file from docs/recipes and starts datasette when it is installed.
def recipe_dir():
    return os.path.join(os.path.dirname(os.path.realpath(__file__)), "docs", "recipes")


def read_recipes():
    """[(name, header dict, sql)] for every docs/recipes/*.sql that is a SQLite recipe, sorted by name."""
    res = []
    d = recipe_dir()
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else ():
        if not f.endswith(".sql"):
            continue
        with open(os.path.join(d, f), encoding="utf-8") as g:
            sql = g.read()
        h = {}
        for ln in sql.splitlines():
            m = re.match(r"-- (\w+): (.*)$", ln)
            if not m:
                break
            h[m.group(1)] = m.group(2)
        if h.get("kind") != "duckdb":
            res.append((f[:-4], h, sql))
    return res


def ui_metadata():
    qs = {}
    for name, h, sql in read_recipes():
        flag = {"stub": "[needs data] ", "partial": "[partial] "}.get(h.get("status"), "")
        desc = " ".join(x for x in (h.get("notes"), ("Needs data: " + h["needs"]) if h.get("needs") else None, "Tables: " + h["tables"] if h.get("tables") else None) if x)
        qs[name.replace("-", "_")] = {"title": flag + h.get("question", name), "description": desc, "sql": sql}
    return {"title": "awt store (read-only, local)", "description": "Derived from the canonical logs by awt ingest; docs/schema.md describes the tables. Nothing here can change the store.",
            "databases": {"store": {"queries": qs, "tables": {"records": {"facets": ["type", "origin", "model"]}, "sessions": {"facets": ["provider_name", "request_model"]},
                                                              "usage": {"facets": ["grain", "cost_source", "response_model"]}, "turns": {"facets": ["outcome"]}}}}}


UI_GUARD = """from datasette import hookimpl
pm = __import__("datasette.plugins", fromlist=["pm"]).pm

OK = ("127.0.0.1", "localhost")

# Installed third-party plugins are switched off: one that writes (saved queries, edit-schema) would write into the live store. Datasette's own plugins stay.
for _name, _plug in list(pm.list_name_plugin()):
    if not _name.startswith("datasette.") and getattr(_plug, "__name__", "") != __name__:
        try:
            pm.unregister(name=_name)
        except Exception:
            pass


@hookimpl
def asgi_wrapper(datasette):
    def wrap(app):
        async def guard(scope, receive, send):
            if scope["type"] in ("http", "websocket"):
                host = dict(scope.get("headers") or []).get(b"host", b"").decode("latin-1").lower()
                name = host.rsplit(":", 1)[0] if host.count(":") == 1 else host
                if name not in OK or scope.get("path", "").endswith(".db"):
                    if scope["type"] == "http":
                        await send({"type": "http.response.start", "status": 400, "headers": [(b"content-type", b"text/plain")]})
                        await send({"type": "http.response.body", "body": b"awt ui: only 127.0.0.1 and localhost, and no raw database\\n"})
                    else:
                        await send({"type": "websocket.close"})
                    return
            await app(scope, receive, send)
        return guard
    return wrap
"""


def free_port(want):
    """want if 127.0.0.1:want can be bound, else a port the system gives (0 asks for any)."""
    for port in (want, 0):
        sk = socket.socket()
        try:
            sk.bind(("127.0.0.1", port))
            return sk.getsockname()[1]
        except OSError:
            pass
        finally:
            sk.close()
    return want


def datasette_major(exe):
    """The major version of the datasette at exe, None when it will not say."""
    try:
        r = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        m = re.search(r"(\d+)\.\d+", r.stdout)
        return int(m.group(1)) if m else None
    except (OSError, subprocess.SubprocessError):
        return None


def cmd_ui(a):
    db = os.path.join(store_dir(), "store.db")
    if a.print_metadata:
        return out(json.dumps(ui_metadata(), indent=1))
    if not os.path.isfile(db):
        die("no store.db at %s" % db, "awt ingest --source claude (AWT_STORE overrides the location)")
    exe = shutil.which(os.environ.get("AWT_DATASETTE") or "datasette")
    if not exe:
        die("datasette is not installed", "pipx install 'datasette<1' (or: uv tool install 'datasette<1'), then: awt ui")
    if (datasette_major(exe) or 0) >= 1:
        die("datasette 1.x ignores the canned queries awt writes as metadata (the recipes would not show)", "pipx install --force 'datasette<1' (or: uv tool install --force 'datasette<1'), then: awt ui")
    meta = store_meta(store_dir())
    why = store_old(meta)
    if store_newer(meta):
        die(why, NEWER_FIX + ", then: awt ui")
    if why:
        die("%s: the recipes need the current schema" % why, "%s   (one time; about %s of free disk), then: awt ui" % (REBUILD_FIX, human(rebuild_need(store_dir()))))
    tmp = tempfile.mkdtemp(prefix="awt-ui-")
    proc = None
    stop = lambda *_: (_ for _ in ()).throw(KeyboardInterrupt())
    for sg in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sg, stop)
    code = 0
    try:
        os.chmod(tmp, 0o700)
        with open(os.path.join(tmp, "metadata.json"), "w", encoding="utf-8") as g:
            json.dump(ui_metadata(), g)
        os.mkdir(os.path.join(tmp, "plugins"))
        with open(os.path.join(tmp, "plugins", "awt_ui_guard.py"), "w", encoding="utf-8") as g:
            g.write(UI_GUARD)
        port = free_port(a.port)
        cmd = [exe, "serve", db, "-h", "127.0.0.1", "-p", str(port), "-m", os.path.join(tmp, "metadata.json"), "--plugins-dir", os.path.join(tmp, "plugins"),
               "--setting", "allow_download", "off", "--setting", "default_page_size", "100", "--setting", "sql_time_limit_ms", "10000"]
        if port != a.port:
            out("awt ui: port %d is taken, using %d" % (a.port, port))
        out("awt ui: http://127.0.0.1:%d/  (read-only view of %s, live: new ingests show on reload; Ctrl-C stops it)" % (port, db))
        sys.stdout.flush()
        proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, start_new_session=True)
        code = proc.wait()
    except KeyboardInterrupt:
        code = 0
    except (OSError, sqlite3.Error) as x:
        die("awt ui could not start: %s: %s" % (type(x).__name__, x), "check that the store is readable and datasette runs: %s --version" % exe)
    finally:
        if proc is not None and proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
        shutil.rmtree(tmp, ignore_errors=True)
    if code:
        die("datasette exited with %d" % code, "try another port: awt ui --port %d" % free_port(0))


