def shown(p, top, short=False):
    """Hit prefix usable from the cwd: "" for the cwd itself; relative when the hit is under the cwd or the cwd is in the tree; else absolute, or with short relative to the tree top."""
    c, r = cwd(), os.path.realpath(p)
    under = lambda x, d: x == d or x.startswith(d.rstrip(os.sep) + os.sep)
    far = os.path.relpath(r, os.path.realpath(top)) if short else r
    if not c:
        return far
    if r == c:
        return ""
    return os.path.relpath(r, c) if under(r, c) or under(c, os.path.realpath(top)) else far


def scope_nodes(tree, up, down, deadline=None):
    """The nodes a cross-node read covers, ROOT first, and whether a limit cut the walk: the --tree set, or --up and --down alone."""
    start = ROOT
    top = tree_top(start) if tree else start
    targets, over = [], False
    if tree and top != start and node_info(top)["kind"] == "root":
        ds, over = descendants(top, deadline)
        targets = [top] + [p for p, _ in ds if p != start]
    else:
        if up or tree:
            targets += ancestors(start)
        if down or tree:
            ds, over = descendants(start, deadline)
            targets += [p for p, _ in ds]
    return [start] + targets, over


