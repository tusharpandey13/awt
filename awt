def cmd_ingest(a):
    if a.event:  # one tool-call event on stdin (a host hook or the plugin): the ledger only, no transcript copy
        try:
            return cmd_event(a)
        except BaseException as x:
            if a.hook and not isinstance(x, KeyboardInterrupt):
                return
            if isinstance(x, (SystemExit, KeyboardInterrupt)):
                raise
            die("event failed: %s: %s" % (type(x).__name__, x), "pipe one hook event as JSON on stdin")
    res = []
    if a.rebuild:  # a killed rebuild must not leave its temp store.db (GBs): SIGTERM and SIGHUP unwind like Ctrl-C, so build_store removes it
        for sg in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sg, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    try:
        store = store_dir()
        private_dir(store)
        piped, cut = None, False
        if a.stdin:
            if a.source != "paseo" or a.rebuild:
                die("--stdin takes events for the paseo source only", "awt ingest --source paseo --stdin")
            piped = sys.stdin.buffer.read(STDIN_CAP).decode("utf-8", "replace")
            cut = bool(sys.stdin.buffer.read(1))
        if not a.rebuild:
            for name, fn, what in SOURCES:
                if name == "paseo" and piped is not None:
                    fn = lambda st, piped=piped, cut=cut: ingest_paseo_all(st, piped, cut)
                if a.source == name or (a.source == "all" and name != "ccusage"):
                    try:
                        res.append((fn(store), what))
                    except Exception as x:
                        if a.source != "all":
                            raise
                        res.append(((0, 0, 1), what))  # one source failing must not stop the rest
        private_dir(os.path.join(store, "ingest"))
        built = sync_store(store, ingest_tree(store, a.dir), a.rebuild, quiet=bool(a.hook or a.stdin))
    except BaseException as x:
        if isinstance(x, KeyboardInterrupt):
            raise
        if a.hook:
            return
        if isinstance(x, SystemExit):
            raise
        die("ingest failed: %s: %s" % (type(x).__name__, x), "check that %s is writable (AWT_STORE overrides it) and run: awt ingest --source %s" % (store_dir(), a.source))
    if not a.hook:
        for (n, f, bad), what in res:
            out("ingested %d rows from %d %s into %s%s" % (n, f, what, store, "; %d files failed (awt doctor shows which)" % bad if bad else ""))
        if built:
            out("%s store.db: %d sessions, %d messages, %d records" % ("rebuilt" if a.rebuild else "updated", built["sessions"], built["messages"], built["records"]))


