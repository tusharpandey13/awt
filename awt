def netmount(path):
    try:
        best = ("", "")
        for ln in subprocess.run(["mount"], capture_output=True, text=True, timeout=5).stdout.splitlines():
            m = re.match(r"(.+?) on (.+?) \((\w[\w.]*)", ln)
            if m and (path == m.group(2) or path.startswith(m.group(2).rstrip("/") + "/")) and len(m.group(2)) >= len(best[0]):
                best = (m.group(2), m.group(3))
        return best[1] in ("nfs", "smbfs", "afpfs", "cifs", "webdav", "osxfuse", "macfuse") or best[1].startswith("fuse.")
    except Exception:
        return False


def tree_problems(root):
    """Defects in the tree below root, as (level, message)."""
    probs = []
    ds, over = descendants(root)
    nodes = [root] + [p for p, _ in ds]
    if over:
        probs.append(("warn", LIMIT))
    keys = {}
    for node in nodes:
        pk, key = node_info(node)["kind"], node_info(node)["key"]
        has_projects = pk == "root" and any(node_info(c)["kind"] == "project" for c in children(node))
        if key:
            if key in keys:
                probs.append(("fail", "duplicate key %s: %s and %s" % (key, os.path.relpath(keys[key], root), os.path.relpath(node, root))))
            keys.setdefault(key, node)
        for plural in PLURAL.values():
            d = os.path.join(node, plural)
            if os.path.islink(d):
                probs.append(("warn", "%s is a symlink; it is not followed" % os.path.relpath(d, root)))
                continue
            if not os.path.isdir(d):
                continue
            try:
                names = sorted(os.listdir(d))
            except OSError:
                probs.append(("warn", "%s is unreadable; its nodes were not checked" % os.path.relpath(d, root)))
                continue
            for n in names:
                p = os.path.join(d, n)
                where = os.path.relpath(p, root)
                if n.startswith(".new-"):
                    probs.append(("warn", "leftover %s from an interrupted init; remove it" % where))
                elif os.path.islink(p):
                    probs.append(("warn", "%s is a symlink; it is not followed" % where))
                elif is_node_dir(p):
                    i = node_info(p)
                    if i["legacy"]:
                        probs.append(("warn", "%s has no node row; it is read as a task" % where))
                    if PLURAL.get(i["kind"]) != plural:
                        probs.append(("warn", "%s: a %s sits in %s/, which does not match its node row" % (where, i["kind"], plural)))
                    if i["kind"] not in LEGAL.get(pk, ()):
                        probs.append(("fail", "%s: a %s does not belong in a %s" % (where, i["kind"], pk)))
                    elif pk == "root" and i["kind"] == "workspace" and has_projects:
                        probs.append(("warn", "%s: a workspace directly under the root is the legacy placement; run migrate-paseo, or move it under a project" % where))
                else:
                    probs.append(("warn", "%s is not a node; reserved directories hold nodes only" % where))
        seen = 0
        for dp, dns, _ in os.walk(node):
            seen += 1
            keep = []
            for n in sorted(dns):
                p = os.path.join(dp, n)
                if os.path.islink(p) or n in (".git", ".awt", "scratch") or (dp == node and n in PLURAL.values()):
                    continue
                if is_node_dir(p):
                    probs.append(("warn", "%s is a node outside a reserved directory; it has no parent" % os.path.relpath(p, root)))
                else:
                    keep.append(n)
            dns[:] = keep
            if seen > K["walk"]:
                break
        if load_at(node)["status"] == "done":
            for p in children(node):
                if node_info(p)["kind"] in ("project", "workspace", "task") and load_at(p)["status"] == "active":
                    probs.append(("warn", "%s is done but %s is still active" % (os.path.relpath(node, root) if node != root else ".", os.path.relpath(p, root))))
    return probs


def store_checks(line):
    """Store path, modes, ingest freshness and Claude retention. Never creates anything."""
    try:
        store = store_dir()
        if os.path.isdir(store):
            mode = stat.S_IMODE(os.stat(store).st_mode)
            line("ok" if not mode & 0o077 else "warn", "store mode %o (%s)" % (mode, store) if not mode & 0o077 else
                 "store %s has mode %o, expected 700 (chmod 700 it; it holds full conversation text)" % (store, mode))
            allf = [os.stat(os.path.join(dp, f)) for dp, _, fns in os.walk(store) for f in fns]
            loose = [os.path.join(dp, f) for dp, _, fns in os.walk(store) for f in fns if os.stat(os.path.join(dp, f)).st_mode & 0o077]
            size = float(sum(x.st_size for x in allf))
            for unit in ("B", "KB", "MB", "GB"):
                if size < 1024 or unit == "GB":
                    break
                size /= 1024
            line("ok", "store size %s %s in %d files (awt never deletes; remove old months by hand)" % (("%d" % size) if unit == "B" else "%.1f" % size, unit, len(allf)))
            why = store_old(store_meta(store)) if os.path.isfile(os.path.join(store, "store.db")) else None
            if why and store_newer(store_meta(store)):
                line("warn", "%s" % why + " (this awt never rebuilds, writes or migrates it; fix: %s)" % NEWER_FIX)
            elif why:
                line("warn", "%s: run `%s` once (find and ingest keep using the old store.db until then; the build needs about %s of free disk)" % (why, REBUILD_FIX, human(rebuild_need(store))))
            if loose:
                line("warn", "%d store files are readable by others, expected 600 (chmod 600 %s)" % (len(loose), loose[0]))
            top = os.path.realpath(store)
            left = stale_tmp(store)
            if left:
                line("warn", "%d leftover temp file(s) from a killed build, e.g. %s (the next awt ingest that builds deletes them)" % (len(left), os.path.join(store, left[0])))
        else:
            line("ok", "store %s not created yet" % store)
            top = os.path.realpath(os.path.dirname(store))
        sync = [m for m in ("iCloud", "Dropbox", "OneDrive", "Google Drive", "Mobile Documents") if m in store or m in top]
        if sync or netmount(top):
            line("warn", "store is in a sync folder or network mount; it holds full conversation text (set AWT_STORE elsewhere)")
        d = top
        while d and not os.path.exists(os.path.join(d, ".git")) and d != os.path.dirname(d):
            d = os.path.dirname(d)
        if os.path.exists(os.path.join(d, ".git")):
            try:
                target = os.path.join(top if os.path.isdir(store) else os.path.join(top, os.path.basename(store)), "")  # trailing slash: a directory, also before it exists
                ign = subprocess.run(["git", "-C", d, "check-ignore", "-q", target], capture_output=True).returncode == 0
            except OSError:
                ign = False
            if not ign:
                line("warn", "store is inside a git work tree (%s) and not git-ignored; it holds full conversation text and could be committed" % d)
        try:
            with open(os.path.join(store, "ingest", "claude.offsets.json"), encoding="utf-8") as g:
                st = json.load(g)
            last, errs = st.get("last_run"), st.get("errors")
            errs = errs if isinstance(errs, dict) else {}
        except (OSError, ValueError, AttributeError):
            last, errs = None, {}
        for src in ("claude", "pi", "opencode", "paseo"):
            offp = os.path.join(store, "ingest", src + ".offsets.json")
            if src != "claude":
                errs = load_state(offp)[1]
            for k in sorted(errs)[:5]:
                line("warn", "ingest error for %s: %s (fix it, then awt ingest --source %s)" % (k, errs[k], src))
            if len(errs) > 5:
                line("warn", "%d more ingest errors in %s" % (len(errs) - 5, offp))
        age = (time.time() - epoch(last)) / 86400 if last else None
        if last is None:
            line("warn", "claude ingest has never run (awt ingest --source claude; init's SessionEnd hook runs it)")
        elif age > STALE_DAYS:
            line("warn", "claude ingest last ran %d days ago (awt ingest --source claude)" % age)
        else:
            line("ok", "claude ingest ran %s" % ago(last))
        keep = 30
        try:
            with open(os.environ.get("AWT_CLAUDE_SETTINGS") or os.path.join(claude_home(), "settings.json"), encoding="utf-8") as g:
                v = json.load(g).get("cleanupPeriodDays")
            if isinstance(v, int) and not isinstance(v, bool) and v > 0:
                keep = v
        except (OSError, ValueError, AttributeError):
            pass
        root = claude_dir()
        old = min([os.stat(p).st_mtime for p, _, _ in claude_sessions(root)] or [None]) if os.path.isdir(root) else None
        if old is not None:
            days = int((time.time() - old) / 86400)
            risk = days > keep - STALE_DAYS and (age is None or age > 1)
            line("warn" if risk else "ok", "oldest Claude transcript is %d days old; Claude deletes at %d days%s" % (
                days, keep, " and ingest is not current (awt ingest --source claude)" if risk else ""))
    except Exception as x:
        line("warn", "store check failed: %s" % x)


def doctor_staged(a):
    """Secret scan of the staged blobs of the git repo at --dir (default: cwd). For a pre-commit hook."""
    d = a.dir or os.getcwd()

    def g(*x):
        try:
            return subprocess.run(["git", "-C", d] + list(x), capture_output=True)
        except FileNotFoundError:
            die("git is not installed or not on PATH", "install git; awt never installs it")
    if g("rev-parse", "--show-toplevel").returncode:
        die("not a git repo: " + d, "run awt doctor --staged inside a git work tree")
    held = []
    for f in [x.decode("utf-8", "replace") for x in g("diff", "--cached", "--name-only", "--diff-filter=ACMRT", "-z").stdout.split(b"\0") if x]:
        r = g("cat-file", "blob", ":" + f)
        b = r.stdout
        if r.returncode or len(b) > K["big"] or b"\0" in b:
            continue
        n = secret(b.decode("utf-8", "replace"))
        if n:
            held.append("%s (%s)" % (f, n))
    if held:
        for h in held:
            print("error: staged file looks like it holds a secret: " + h, file=sys.stderr)
        die("%d staged file(s) look like secrets" % len(held), "git restore --staged FILE, remove the secret, and commit again")
    out("ok no secrets in staged files")


