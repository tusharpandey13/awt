# ---------- basics ----------
def die(msg, fix=None, code=1):
    print("error: " + msg, file=sys.stderr)
    if fix:
        print("fix: " + fix, file=sys.stderr)
    sys.exit(code)


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def epoch(ts):
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0


def ago(ts):
    s = max(0, int(time.time() - epoch(ts)))
    return "just now" if s < 60 else "%dm ago" % (s // 60) if s < 3600 else "%dh ago" % (s // 3600) if s < 86400 else "%dd ago" % (s // 86400)


def sha(b):
    return hashlib.sha256(b).hexdigest()


def secret(s):
    return next((n for n, rx in SECRETS if rx.search(s)), None)


def new_id(p):
    return "%s-%s" % (p, os.urandom(4).hex())


def P(*a):
    return os.path.join(ROOT, *a)


def out(s):
    print(s)


def inside(path):
    p = os.path.realpath(path)
    if not os.path.lexists(path) and not os.path.isabs(path):
        p = os.path.realpath(P(path))
    if p != ROOT and not p.startswith(ROOT + os.sep):
        die("path escapes the task root: " + path, "keep it inside " + ROOT)
    return p


def rel(p):
    return os.path.relpath(p, ROOT)


def cwd():
    try:
        return os.path.realpath(os.getcwd())
    except OSError:
        return None


def realdir(d):
    if os.path.realpath(P(d)) != P(d):
        die("%s/ is a symlink or sits behind one" % d, "replace it with a real directory inside " + ROOT)


def find_root(explicit=None):
    c = explicit or os.environ.get("AWT_DIR")
    if c:
        c = os.path.realpath(os.path.expanduser(c))
        return c if os.path.isdir(os.path.join(c, ".awt")) else None
    d = os.path.dirname(os.path.realpath(__file__))
    if os.path.isdir(os.path.join(d, ".awt")):
        return d
    d = cwd()
    while d:
        if os.path.isdir(os.path.join(d, ".awt")):
            return d
        if os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


def is_node_dir(path):
    return os.path.isdir(os.path.join(path, ".awt"))


def node_info(path):
    """kind, name and key of the node at path, from its first row. No node row reads as a legacy task."""
    info = dict(kind="task", name=os.path.basename(path), key=None, legacy=True)
    try:
        with open(os.path.join(path, ".awt", "events.jsonl"), "rb") as g:
            for ln in g:
                if not ln.strip():
                    continue
                try:
                    r = json.loads(ln.decode("utf-8"))
                except (ValueError, RecursionError):
                    return info
                if isinstance(r, dict) and r.get("type") == "node" and valid(r):
                    info.update(kind=r["kind"], name=r["name"], key=r.get("key"), legacy=False)
                return info
    except OSError:
        pass
    return info


# ---------- the one writer ----------
def check(typ, f):
    for k in REQ[typ]:
        if k not in f:
            die("%s needs %s" % (typ, k), "give a value for " + k, 2)
    for k, v in f.items():
        for s in (v if isinstance(v, list) else [v]):
            if not isinstance(s, str):
                continue
            try:
                s.encode("utf-8")
            except UnicodeEncodeError:
                die("%s.%s is not valid UTF-8" % (typ, k), "pass UTF-8 text")
            if not s.strip():
                die("%s.%s is empty" % (typ, k), "give it a value")
            cap = CAPS.get("%s.%s" % (typ, k))
            if cap and len(s) > cap:
                die("%s.%s is %d chars, cap is %d" % (typ, k, len(s), cap),
                    "use %s of at most %d chars" % (k, cap) if typ == "node" else "put the detail in docs/ and reference it from a shorter text")
            n = secret(s)
            if n:
                die("%s.%s matches secret pattern %s" % (typ, k, n), "remove the secret; reference where it lives instead")


def emit(typ, **f):
    f = {k: v for k, v in f.items() if v is not None}
    check(typ, dict(f, by=BY))
    row = dict(v=1, ts=now(), type=typ, host=HOST, by=BY)
    row.update(f)
    data = (json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
    if len(data) > ROWMAX:
        die("event is %d bytes, max %d" % (len(data), ROWMAX), "put the detail in docs/ and reference it")
    p = P(".awt", "events.jsonl")
    fd = os.open(p, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        with open(p, "rb") as g:
            if g.seek(0, 2):
                g.seek(-1, 2)
                if g.read(1) != b"\n":
                    data = b"\n" + data
        if os.write(fd, data) != len(data):
            die("short write to events.jsonl", "check disk space and rerun")
    finally:
        os.close(fd)
    return row


# ---------- the one reader ----------
def valid(r):
    if not isinstance(r, dict):
        return False
    for k, v in r.items():
        if k in ("v", "attempt", "pid", "timeout"):
            ok = type(v) is int
        elif k in ("tags", "after"):
            ok = isinstance(v, list) and all(isinstance(x, str) for x in v)
        else:
            ok = isinstance(v, str)
        if not ok:
            return False
    t = r.get("type")
    if "ts" not in r or t not in REQ or any(k not in r for k in REQ[t]):
        return False
    for k, vals in ENUM.items():
        if k.split(".")[0] == t and r.get(k.split(".")[1]) not in vals:
            return False
    try:
        json.dumps(r, ensure_ascii=False).encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


def claim_path(e):
    return P(".awt", "claims", "%s.%s" % (e["key"], e["attempt"]))


def alive(e):
    pid = e.get("pid")
    if e.get("chost") != HOST or not isinstance(pid, int) or not 0 < pid < 2 ** 31:
        return False
    if time.time() > e["cts"] + e["to"] + K["margin"]:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def fold_effect(D, r):
    i, s, n = r["id"], r["step"], r.get("attempt", 1)
    e = D["eff"].get(i)
    if e is None:
        if s != "planned" or not r.get("target") or not r.get("key"):
            return False
        e = D["eff"][i] = dict(r, attempt=n, hist=[], claims=0, manual=not r.get("run"))
    else:
        cur, crashed = e["step"], e["step"] == "planned" and os.path.exists(claim_path(e))
        if s == "planned":
            ok = n == e["attempt"] + 1 and (cur in ("unknown", "claimed") or crashed)
        else:
            ok = n == e["attempt"] and (
                (s == "claimed" and cur in ("planned", "claimed") and not e["manual"])
                or (s == "sent" and (cur == "unknown" or cur == "claimed" or (cur == "planned" and (e["manual"] or crashed))))
                or (s == "unknown" and cur == "claimed") or (s == "dropped" and cur == "planned"))
        if not ok:
            return False
        e["attempt"] = n
        if s == "planned":
            e["claims"] = 0
    e["step"] = s
    if s == "claimed":
        e["claims"] += 1
        e["pid"], e["chost"], e["cts"], e["to"] = r.get("pid"), r.get("host"), epoch(r["ts"]), r.get("timeout", K["timeout"])
    e["hist"].append(r)
    return True


def derive(e):
    s = e["step"]
    if s == "claimed":
        return "conflict" if e["claims"] > 1 else "claimed" if alive(e) else "unknown"
    if s == "planned" and os.path.exists(claim_path(e)):
        return "unknown"
    return s


def load():
    unread = None
    try:
        with open(P(".awt", "events.jsonl"), "rb") as g:
            raw = g.read()
    except FileNotFoundError:
        raw = b""
    except OSError as x:
        raw, unread = b"", x.strerror or str(x)
    rows, bad, bad_lines = [], 0, []
    for n, ln in enumerate(raw.split(b"\n"), 1):
        if not ln.strip():
            continue
        try:
            r = json.loads(ln.decode("utf-8"))
        except (ValueError, RecursionError):
            bad += 1
            bad_lines.append(n)
            continue
        if valid(r):
            rows.append(r)
        else:
            bad += 1
            bad_lines.append(n)
    D = dict(rows=rows, task=None, status="active", states={}, hist=[], notes=[], dec={}, sup={}, q={}, ans={},
             refs={}, caps=[], docs=[], eff={}, bad_lines=bad_lines, unread=unread)
    for r in rows:
        t = r["type"]
        if t == "task":
            D["task"] = r
        elif t == "status":
            D["status"] = r["status"]
        elif t == "state":
            D["states"].pop(r.get("scope", "main"), None)
            D["states"][r.get("scope", "main")] = r
            D["hist"].append(r)
        elif t == "note":
            D["notes"].append(r)
        elif t == "decision":
            D["dec"][r["id"]] = r
            if "supersedes" in r:
                D["sup"][r["supersedes"]] = r["id"]
        elif t == "question":
            D["q"][r["id"]] = r
        elif t == "answer":
            D["ans"].setdefault(r["ref"], r)
        elif t == "ref":
            D["refs"][r["target"]] = r
        elif t == "capture":
            D["caps"].append(r)
        elif t == "doc":
            D["docs"].append(r)
        elif t == "effect" and not fold_effect(D, r):
            bad += 1
    for e in D["eff"].values():
        e["state"] = derive(e)
    D["bad"] = bad
    D["open_q"] = [q for i, q in D["q"].items() if i not in D["ans"]]
    D["cur_dec"] = [d for i, d in D["dec"].items() if i not in D["sup"]]
    return D


def current_superseder(D, i):
    while i in D["sup"]:
        i = D["sup"][i]
    return i


def get_eff(D, i):
    if i not in D["eff"]:
        die("no effect " + i, "./awt list effects", 4)
    return D["eff"][i]


# ---------- filesystem views ----------
def entries(tops):
    res = []
    for top in tops:
        p = P(top)
        if os.path.islink(p) or os.path.isfile(p):
            res.append(top)
            continue
        for dp, dns, fns in os.walk(p):
            dns[:] = sorted(d for d in dns if d != ".git")
            for n in list(dns):
                if os.path.islink(os.path.join(dp, n)):
                    dns.remove(n)
                    res.append(rel(os.path.join(dp, n)))
            res += [rel(os.path.join(dp, n)) for n in fns]
    return sorted(res)


def section_files(name, all_):
    if name == "misc":
        skip = SKIPTOP | (set(PLURAL.values()) if not node_info(ROOT)["legacy"] else set())
        tops = ["misc", "legacy"] + sorted(n for n in os.listdir(ROOT) if n not in skip)
    else:
        tops = [name]
    res = entries([t for t in tops if os.path.lexists(P(t))])
    if not all_:
        res = [x for x in res if not x.startswith("docs/_superseded/")]
    return res


def file_title(path, caps):
    p = P(path)
    if os.path.islink(p):
        return "-> " + os.readlink(p)
    if path in caps:
        return caps[path][:K["title"]]
    if not os.path.isfile(p):
        return "(not a regular file)"
    try:
        with open(p, "rb") as g:
            b = g.read(K["head"])
    except OSError:
        return "(unreadable)"
    if b"\0" in b:
        return "(binary)"
    lines = [x.strip() for x in b.decode("utf-8", "replace").splitlines() if x.strip()]
    h = next((x for x in lines if x.startswith("# ")), lines[0] if lines else "")
    return h.lstrip("# ")[:K["title"]] if h.startswith("# ") else h[:K["title"]]


def newer_files(since):
    found, seen = [], 0
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = [d for d in dns if d != ".git" and not (dp == ROOT and d in (".awt", "scratch")) and not is_node_dir(os.path.join(dp, d))]
        for n in fns:
            seen += 1
            try:
                m = os.lstat(os.path.join(dp, n)).st_mtime
            except OSError:
                continue
            if m > since:
                found.append((m, rel(os.path.join(dp, n))))
        if seen > K["walk"]:
            break
    return [p for _, p in sorted(found, reverse=True)]


def git(path, *args):
    return subprocess.run(["git", "-C", path] + list(args), capture_output=True, text=True, timeout=10)


# ---------- brief and listing ----------
def cut(s, n=None):
    n = n or K["line"]
    return s if len(s) <= n else s[:n - 1] + "~"


def fit(head, lines, key, sect):
    budget, o, n = BUDGET[key], [head], len(head) + 1
    reserve = len("+999 more: ./awt list " + sect) + 1
    for i, ln in enumerate(lines):
        if n + len(ln) + 1 + (reserve if i < len(lines) - 1 else 0) > budget:
            o.append("+%d more: ./awt list %s" % (len(lines) - i, sect))
            break
        o.append(ln)
        n += len(ln) + 1
    return "\n".join(o) + "\n"


def eff_next(e):
    q = shlex.quote
    if e["state"] == "planned":
        return ("./awt effect apply %s --target %s" % (e["id"], q(e["target"]))) if e.get("run") else \
            ("send %s by hand, then ./awt effect mark %s sent" % (e.get("body", "it"), e["id"]))
    return "ask a person, then ./awt effect mark %s sent|not-sent  (see ./awt effect show %s)" % (e["id"], e["id"])


def brief(scope=None):
    D, o = load(), []
    t = D["task"]
    o.append(fit("# awt task", ["Goal: " + cut(t["goal"], 250), "Done means: " + cut(t["done_means"], 250), "Status: " + D["status"]]
                 if t else ["Goal: (none recorded) ./awt init --goal \"...\" --done \"...\"", "Status: " + D["status"]], "goal", "state"))
    sts = sorted(reversed(list(D["states"].values())), key=lambda r: not scope or r.get("scope", "main") == scope, reverse=True)
    if sts:
        s = sts[0]
        o.append(fit("## State", ["[%s] %s\nnow: %s\nnext: %s" % (s.get("scope", "main"), ago(s["ts"]), s["now"], s["next"])] +
                     ["[%s] %s: %s" % (x.get("scope", "main"), ago(x["ts"]), cut(x["now"], 100)) for x in sts[1:]], "state", "state"))
    if D["open_q"]:
        o.append(fit("## Open questions", ["%s: %s" % (q["id"], cut(q["text"])) for q in D["open_q"]], "questions", "questions"))
    att = [e for e in D["eff"].values() if e["state"] in ("planned", "unknown", "conflict")]
    if att:
        o.append(fit("## Effects needing attention", [cut("%s %s %s: %s" % (e["id"], e["state"], e["target"], eff_next(e))) for e in att], "effects", "effects"))
    ch = []
    if sts:
        since = epoch(sts[0]["ts"])
        nf = newer_files(since)
        if nf:
            ch += ["%d files newer than state:" % len(nf)] + ["  " + cut(x) for x in nf[:K["newer"]]]
        for r in D["refs"].values():
            if r["kind"] == "repo" and r.get("host") == HOST and r.get("path"):
                try:
                    lg = git(r["path"], "log", "--since=%d" % int(since), "--format=%s", "-n", "5")
                    dirty = git(r["path"], "status", "--porcelain")
                    if lg.returncode or dirty.returncode:
                        raise OSError("git failed")
                    subj = [x for x in lg.stdout.splitlines() if x]
                    ch.append(cut("repo %s: %d new commits%s; %d dirty" % (os.path.basename(r["path"]), len(subj), (" (" + "; ".join(subj) + ")") if subj else "", len(dirty.stdout.splitlines()))))
                except Exception:
                    ch.append("repo %s: git unavailable (degraded)" % os.path.basename(r["path"]))
    else:
        ch.append("No state yet; cannot tell what changed.")
    o.append(fit("## Changes since newest state", ch, "changes", "context"))
    if D["cur_dec"]:
        ds = D["cur_dec"][::-1]
        ds.sort(key=lambda d: "rule" not in (d.get("tags") or []))
        o.append(fit("## Decisions", ["%s %s%s" % (d["id"], "[rule] " if "rule" in (d.get("tags") or []) else "", cut(d["choice"], 120)) for d in ds], "decisions", "decisions"))
    refs = list(D["refs"].values())
    inv = "Inventory: %d refs (%d no-access), " % (len(refs), sum(r["access"] == "none" for r in refs)) + ", ".join(
        "%d %s" % (len(section_files(s, False)), s) for s in ("context", "docs", "outbox", "misc"))
    if D["bad"]:
        inv += "; %d quarantined rows" % D["bad"]
    o.append(fit("## More", [cut(inv, 140), "./awt list | ./awt find <term>"] + (["WARNING: .awt/events.jsonl is unreadable (%s); showing nothing from it" % D["unread"]] if D["unread"] else []), "inventory", "state"))
    if not sts:
        o.append('No handoff yet. Before stopping: ./awt state --now "..." --next "..."\n')
    return "".join(o)


def listing(name, D, all_):
    if name in ("context", "docs", "outbox", "misc"):
        caps = {c["path"]: c["title"] for c in D["caps"]}
        est = {e["body"]: e["state"] for e in D["eff"].values() if e.get("body")}
        return [("%s  %s" % (f, file_title(f, caps))).rstrip() + ("  [%s]" % est[f] if f in est else "") if not os.path.islink(P(f))
                else "%s %s" % (f, file_title(f, caps)) for f in section_files(name, all_)]
    if name == "refs":
        return ["%s [%s%s] %s  %s" % (r["kind"], r["access"], ", " + r["path"] + "@" + r.get("branch", "") if r["kind"] == "repo" else "", r["title"], r["target"]) for r in D["refs"].values()]
    if name == "decisions":
        return ["%s%s %s -- %s" % (d["id"], " [%s]" % ",".join(d["tags"]) if d.get("tags") else "", d["choice"], d["why"]) + (" (superseded by %s)" % current_superseder(D, d["id"]) if d["id"] in D["sup"] else "")
                for d in D["dec"].values() if all_ or d["id"] not in D["sup"]]
    if name == "questions":
        return ["%s %s" % (q["id"], q["text"]) + (" => " + D["ans"][i]["text"] if i in D["ans"] else "") for i, q in D["q"].items() if all_ or i not in D["ans"]]
    if name == "effects":
        return ["%s %s %s attempt=%s%s" % (e["id"], e["state"], e["target"], e["attempt"], " body=" + e["body"] if e.get("body") else "")
                for e in D["eff"].values() if all_ or e["state"] not in ("sent", "dropped")]
    if name == "notes":
        return ["%s %s" % (n["id"], n["text"]) for n in D["notes"]]
    rows = D["hist"] if all_ else list(D["states"].values())
    return ["[%s] %s now: %s | next: %s" % (s.get("scope", "main"), ago(s["ts"]), s["now"], s["next"]) for s in rows]


# ---------- verbs ----------
def create(path, text):
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        return False
    with os.fdopen(fd, "w", encoding="utf-8") as g:
        g.write(text)
    return True


def find_claude_md(d):
    home = os.path.realpath(os.path.expanduser("~/.claude"))
    while True:
        if os.path.realpath(d) != home and os.path.isfile(os.path.join(d, "CLAUDE.md")):
            return os.path.join(d, "CLAUDE.md")
        if os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


def slugify(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:50].strip("-") or "node"


def ensure_gitignore():
    gi = P(".gitignore")
    have = open(gi, encoding="utf-8", errors="replace").read() if os.path.exists(gi) else ""
    miss = [x for x in IGNORE if x not in have.splitlines()]
    if miss:
        with open(gi, "a", encoding="utf-8") as g:
            g.write(("" if not have or have.endswith("\n") else "\n") + "\n".join(miss) + "\n")
    return bool(miss)


def build_node(path, kind, name, key, goal, done):
    """Write a complete node at path. Rows go through emit(), so the secret scan and caps apply."""
    global ROOT
    old, ROOT = ROOT, path
    try:
        for d in NODE_DIRS[kind] + (".awt/claims", ".awt/blobs", ".awt/runs"):
            os.makedirs(P(d), exist_ok=True)
        os.close(os.open(P(".awt", "events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644))
        emit("node", kind=kind, name=name, key=key)
        if goal:
            emit("task", goal=goal, done_means=done)
        ensure_gitignore()
    finally:
        ROOT = old


def tree_top(node):
    """The topmost node above node, walking up through reserved child directories (at most 8 levels)."""
    for _ in range(8):
        d = os.path.dirname(node)
        up = os.path.dirname(d)
        if os.path.basename(d) in PLURAL.values() and not os.path.islink(d) and is_node_dir(up):
            node = up
        else:
            break
    return node


def find_key(top, key):
    """Path of the node under top (top included) whose key matches, or None. Reserved dirs only, no symlinks, limits as in SPEC."""
    todo, seen = [(top, 0)], 0
    while todo:
        node, depth = todo.pop()
        seen += 1
        if node_info(node)["key"] == key:
            return node
        if depth >= 8 or seen > 2000:
            continue
        for plural in PLURAL.values():
            d = os.path.join(node, plural)
            if os.path.islink(d) or not os.path.isdir(d):
                continue
            for n in sorted(os.listdir(d), reverse=True):
                p = os.path.join(d, n)
                if not n.startswith(".new-") and not os.path.islink(p) and is_node_dir(p):
                    todo.append((p, depth + 1))
    return None


def init_child(a):
    global ROOT
    kind = a.kind
    ROOT = find_root(a.dir)
    if not ROOT:
        die("no parent node", "cd into a node, set AWT_DIR or pass --dir; make a root with: awt init --kind root", 4)
    if not a.name:
        die("--kind %s needs --name" % kind, "give --name NAME", 2)
    if bool(a.goal) != bool(a.done):
        die("--goal and --done go together", "give both", 2)
    pk = node_info(ROOT)["kind"]
    if kind not in LEGAL[pk]:
        die("a %s cannot contain a %s" % (pk, kind), "a %s may contain: %s" % (pk, ", ".join(LEGAL[pk])))
    if kind == "task" and not a.goal:
        die("a task needs --goal and --done", "give both")
    goal = a.goal or a.name
    done = a.done or ("ongoing" if kind == "workspace" else "agent work recorded")
    check("node", dict(kind=kind, name=a.name, key=a.key, by=BY))
    check("task", dict(goal=goal, done_means=done, by=BY))
    base = P(PLURAL[kind])
    if os.path.islink(base):
        die("%s/ is a symlink" % PLURAL[kind], "replace it with a real directory inside " + ROOT)
    os.makedirs(base, exist_ok=True)
    lockfd = None
    if a.key:
        top = tree_top(ROOT)
        lockfd = os.open(os.path.join(top, ".awt", "events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lockfd, fcntl.LOCK_EX)
        except OSError:
            os.close(lockfd)
            die("cannot lock %s" % top, "keyed init needs a local filesystem; put the tree on one")
    try:
        if a.key:
            p = find_key(top, a.key)
            if p:
                return out("init %s %s" % (os.path.relpath(p, ROOT), node_info(p)["kind"]))
        tmp = os.path.join(base, ".new-" + os.urandom(4).hex())
        os.mkdir(tmp)
        try:
            build_node(tmp, kind, a.name, a.key, goal, done)
            slug, n = slugify(a.name), 1
            while True:
                final = os.path.join(base, slug if n == 1 else "%s-%d" % (slug, n))
                try:
                    os.rename(tmp, final)
                    break
                except OSError as x:
                    if x.errno in (errno.ENOTEMPTY, errno.EEXIST, errno.ENOTDIR) or os.path.lexists(final):
                        n += 1
                        continue
                    raise
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
        out("init %s %s" % (rel(final), kind))
    finally:
        if lockfd is not None:
            os.close(lockfd)


def cmd_init(a):
    global ROOT
    if a.kind and a.kind != "root":
        return init_child(a)
    ROOT = a.dir or os.environ.get("AWT_DIR") or cwd()
    if not ROOT:
        die("the current directory no longer exists", "cd to a real directory or pass --dir PATH")
    ROOT = os.path.realpath(os.path.expanduser(ROOT))
    if bool(a.goal) != bool(a.done):
        die("--goal and --done go together", "give both", 2)
    if (a.name or a.key) and not a.kind:
        die("--name and --key need --kind", "give --kind root|workspace|task|agent, or drop them", 2)
    tree = a.kind == "root"
    ni = node_info(ROOT)
    if not ni["legacy"] and ni["kind"] != a.kind:
        die("%s is a %s node; init cannot turn it into %s" % (ROOT, ni["kind"], "a " + a.kind if a.kind else "a standalone task"),
            "add children with: awt init --kind KIND --name NAME")
    if tree and ni["legacy"]:
        try:
            has_rows = os.path.getsize(os.path.join(ROOT, ".awt", "events.jsonl")) > 0
        except OSError:
            has_rows = False
        if has_rows:
            die("%s already has records and no node row" % ROOT, "a root needs a directory without .awt records; use an empty one")
    for d in (("workspaces",) if tree else ("context", "docs", "outbox", "misc", "scratch")) + (".awt/claims", ".awt/blobs", ".awt/runs"):
        os.makedirs(P(d), exist_ok=True)
    os.close(os.open(P(".awt", "events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644))
    made = []
    ag = P("AGENTS.md")
    block = TREE_BLOCK if tree else AGENTS_BLOCK
    if not os.path.exists(ag):
        create(ag, block)
        made.append("AGENTS.md")
    else:
        with open(ag, encoding="utf-8", errors="replace") as g:
            txt = g.read()
        if BLOCK_BEGIN not in txt:
            with open(ag, "a", encoding="utf-8") as g:
                g.write(("" if not txt or txt.endswith("\n") else "\n") + "\n" + block)
            made.append("AGENTS.md(block)")
    D0 = load()
    t = D0["task"]
    if create(P("README.md"), (TREE_README if tree else README).format(goal=(a.goal or (t or {}).get("goal") or ("Node tree" if tree else "Task workspace")).splitlines()[0])):
        made.append("README.md")
    if ensure_gitignore():
        made.append(".gitignore")
    if not tree:
        os.makedirs(P(".claude"), exist_ok=True)
        if create(P(".claude", "settings.json"), SETTINGS):
            made.append(".claude/settings.json")
        else:
            print("note: .claude/settings.json exists; merge this snippet yourself:\n" + SETTINGS)
    cm = find_claude_md(ROOT)
    if cm:
        print("warning: %s exists; Claude Code may then skip AGENTS.md. Add the line @AGENTS.md to it." % cm, file=sys.stderr)
    if tree and not any(r["type"] == "node" for r in D0["rows"]):
        emit("node", kind="root", name=a.name or os.path.basename(ROOT) or "root", key=a.key)
        made.append("node")
    if a.goal and (not t or (t["goal"], t["done_means"]) != (a.goal, a.done)):
        emit("task", goal=a.goal, done_means=a.done)
        made.append("task")
    out("init %s: %s" % (ROOT, " ".join(made) or "nothing to change"))


def cmd_resume(a):
    if a.hook:
        try:
            r = find_root(a.dir)
            if r:
                globals()["ROOT"] = r
                sys.stdout.write(brief())
        except BaseException as x:
            if isinstance(x, KeyboardInterrupt):
                raise
        return
    sys.stdout.write(brief(getattr(a, "scope", None)))


def cmd_list(a):
