        except Exception:
            br = "unknown"
        extra = dict(path=p, branch=br)
    if kind == "node":
        t = os.path.realpath(os.path.expanduser(a.target))
        extra = dict(path=os.path.relpath(t, ROOT), key=node_info(t)["key"])
    emit("ref", target=a.target, title=a.title, kind=kind, why=a.why, access="none" if a.no_access else "ok", **extra)
    out("ref %s %s" % (kind, a.target))


def cmd_capture(a):
    if a.file and a.file != "-":
        try:
            with open(a.file, "rb") as g:
                raw = g.read()
        except OSError as x:
            die("cannot read %s: %s" % (a.file, x.strerror), "give a readable FILE, or pipe the text in", 4)
    else:
        raw = sys.stdin.buffer.read()
    body, n = raw.decode("utf-8", "replace").strip(), 0
    if not body:
        die("capture body is empty", "pipe the text in or pass FILE")
    for name, rx in SECRETS:
        body, k = rx.subn("[REDACTED:%s]" % name, body)
        n += k
    h = sha(body.encode("utf-8"))
    D = load()
    for c in D["caps"]:
        if c["sha"] == h:
            return out("%s already captured (no change)" % c["path"])
    slug = re.sub(r"[^a-z0-9]+", "-", a.title.lower()).strip("-")[:50].strip("-") or "capture"
    base = time.strftime("%Y%m%d", time.gmtime()) + "-" + slug
    path, i = "context/%s.md" % base, 1
    while os.path.exists(P(path)):
        i += 1
        path = "context/%s-%d.md" % (base, i)
    check("capture", dict(path=path, **{"from": a.from_, "title": a.title, "sha": h}, **({"ref": a.ref} if a.ref else {})))
    head = "---\nsource: %s\ntitle: %s\ncaptured: %s\nref: %s\n---\n\n" % (a.from_, a.title, now(), a.ref or "")
    realdir("context")
    tmp = P("context", ".tmp-" + os.urandom(4).hex())
    create(tmp, head + body + "\n")
    os.rename(tmp, P(path))
    emit("capture", path=path, title=a.title, sha=h, ref=a.ref, **{"from": a.from_})
    out("%s captured%s" % (path, " (%d secrets redacted)" % n if n else ""))


def cmd_supersede(a):
    old, new = inside(a.old), inside(a.new)
    for p in (old, new):
        if not p.startswith(P("docs") + os.sep):
            die("%s is not under docs/" % rel(p), "only docs/ files can be superseded")
        if not os.path.isfile(p):
            die("%s does not exist" % rel(p), "check the path", 4)
    if old == new:
        die("OLD and NEW are the same file", "give two different docs")
    dst = P("docs", "_superseded", os.path.basename(old))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    realdir("docs/_superseded")
    stem, ext = os.path.splitext(dst)
    i = 1
    while os.path.lexists(dst):
        i += 1
        dst = "%s-%d%s" % (stem, i, ext)
    check("doc", dict(path=rel(old), action="supersede", by_doc=rel(new), **({"why": a.why} if a.why else {})))
    os.rename(old, dst)
    emit("doc", path=rel(old), action="supersede", by_doc=rel(new), why=a.why)
    out("%s superseded by %s (moved to %s)" % (rel(old), rel(new), rel(dst)))


def cmd_status(a):
    if a.value == "done":
        D = load()
        bl = ["question %s open" % q["id"] for q in D["open_q"]] + ["effect %s is %s" % (e["id"], e["state"]) for e in attention(D)]
        ds, over = descendants(ROOT)
        if over:
            bl.append(LIMIT + "; cannot verify the rest")
        for p, _ in ds:
            d, i = load_at(p), node_info(p)
            where = rel(p)
            if i["kind"] in ("project", "workspace", "task") and d["status"] == "active":
                bl.append("%s %s is active (%s)" % (i["kind"], i["name"], where))
            bl += ["question %s open in %s" % (q["id"], where) for q in d["open_q"]]
            bl += ["effect %s is %s in %s" % (e["id"], e["state"], where) for e in attention(d)]
        if len(bl) > 20:
            bl = bl[:20] + ["+%d more (list nodes, list questions, list effects show the rest)" % (len(bl) - 20)]
        if bl:
            die("cannot mark done: " + "; ".join(bl), "answer the questions and mark or drop the effects first (a begun effect: ./awt effect mark ID sent|not-sent|unknown)")
    emit("status", status=a.value)
    out("status " + a.value)


