def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def epoch(ts):
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0


def ago(ts):
    s = max(0, int(time.time() - epoch(ts)))
    return "just now" if s < 60 else "%dm ago" % (s // 60) if s < 3600 else "%dh ago" % (s // 3600) if s < 86400 else "%dd ago" % (s // 86400)


def sha(b):
    return hashlib.sha256(b).hexdigest()


def secret(s):
    return next((n for n, rx in SECRETS if rx.search(s)), None)


def new_id(p):
    return "%s-%s" % (p, os.urandom(4).hex())


def P(*a):
    return os.path.join(ROOT, *a)


def out(s):
