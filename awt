# ---------- basics ----------
def die(msg, fix=None, code=1):
    print("error: " + msg, file=sys.stderr)
    if fix:
        print("fix: " + c(fix), file=sys.stderr)
    sys.exit(code)


def set_cmd():
    global A
    if ROOT and (not node_info(ROOT)["legacy"] or parent(ROOT)):
        A = "awt"


def c(s):
    """Printed commands name the shared awt in a tree node and ./awt in a standalone one."""
    return s.replace("./awt", A)


def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")


def epoch(ts):
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0


def ago(ts):
    s = max(0, int(time.time() - epoch(ts)))
    return "just now" if s < 60 else "%dm ago" % (s // 60) if s < 3600 else "%dh ago" % (s // 3600) if s < 86400 else "%dd ago" % (s // 86400)


def sha(b):
    return hashlib.sha256(b).hexdigest()


def secret(s):
    return next((n for n, rx in SECRETS if rx.search(s)), None)


def new_id(p):
    return "%s-%s" % (p, os.urandom(4).hex())


def P(*a):
    return os.path.join(ROOT, *a)


def out(s):
    print(s)


def inside(path):
    p = os.path.realpath(path)
    if not os.path.lexists(path) and not os.path.isabs(path):
        p = os.path.realpath(P(path))
    if p != ROOT and not p.startswith(ROOT + os.sep):
        die("path escapes the task root: " + path, "keep it inside " + ROOT)
    return p


def rel(p):
    return os.path.relpath(p, ROOT)


def cwd():
    try:
        return os.path.realpath(os.getcwd())
    except OSError:
        return None


def realdir(d):
    if os.path.realpath(P(d)) != P(d):
        die("%s/ is a symlink or sits behind one" % d, "replace it with a real directory inside " + ROOT)


def find_root(explicit=None):
    c = explicit or os.environ.get("AWT_DIR")
    if c:
        c = os.path.realpath(os.path.expanduser(c))
        return c if os.path.isdir(os.path.join(c, ".awt")) else None
    d = os.path.dirname(os.path.realpath(__file__))
    if os.path.isdir(os.path.join(d, ".awt")):
        return d
    d = cwd()
    while d:
        if os.path.isdir(os.path.join(d, ".awt")):
            return d
        if os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


def is_node_dir(path):
    return os.path.isdir(os.path.join(path, ".awt"))


def node_info(path):
    """kind, name and key of the node at path, from its first row. No node row reads as a legacy task."""
    info = dict(kind="task", name=os.path.basename(path), key=None, legacy=True)
    try:
        with open(os.path.join(path, ".awt", "events.jsonl"), "rb") as g:
            for ln in g:
                if not ln.strip():
                    continue
                try:
                    r = json.loads(ln.decode("utf-8"))
                except (ValueError, RecursionError):
                    return info
                if isinstance(r, dict) and r.get("type") == "node" and valid(r):
                    info.update(kind=r["kind"], name=r["name"], key=r.get("key"), legacy=False)
                return info
    except OSError:
        pass
    return info


def children(path):
    """Direct child nodes: only the reserved directories, symlinks never followed, .new-* ignored."""
    res = []
    for plural in PLURAL.values():
        d = os.path.join(path, plural)
        if os.path.islink(d) or not os.path.isdir(d):
            continue
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            p = os.path.join(d, n)
            if not n.startswith(".new-") and not os.path.islink(p) and is_node_dir(p):
                res.append(p)
    return res


def descendants(path, deadline=None):
    """[(path, depth)] in tree order, and whether a limit (or the optional time deadline) cut the walk short."""
    res, cut_ = [], [False]

    def walk(p, depth):
        for c in children(p):
            if len(res) >= K["nodes"] or (deadline is not None and time.time() >= deadline):
                cut_[0] = True
                return
            res.append((c, depth))
            if depth < K["depth"]:
                walk(c, depth + 1)
            else:
                cut_[0] = cut_[0] or bool(children(c))
    walk(path, 1)
    return res, cut_[0]


def parent(path):
    """The node two levels up when path sits directly in a reserved directory of a node, else None."""
    d = os.path.dirname(path)
    up = os.path.dirname(d)
    if os.path.basename(d) in PLURAL.values() and not os.path.islink(d) and is_node_dir(up):
        return up


def ancestors(path):
    """The parent chain, nearest first, at most K['depth'] levels, stopping after the first root."""
    res, p = [], os.path.realpath(path)
    while len(res) < K["depth"]:
        p = parent(p)
        if not p:
            break
        res.append(p)
        if node_info(p)["kind"] == "root":
            break
    return res


def load_at(path):
    global ROOT
    old, ROOT = ROOT, path
    try:
        return load()
    finally:
        ROOT = old


def attention(D):
    return [e for e in D["eff"].values() if e["state"] in ("begun", "unknown") or e["state"] == "planned" and e.get("origin") != "detected"]  # a detected `planned` is a call that never began (denied)


def summarize(path, base, depth=None):
    D = load_at(path)
    info = node_info(path)
    st = D["hist"][-1] if D["hist"] else None
    try:
        o = os.stat(os.path.join(path, "out.md"))
        out_ts, out_bytes = datetime.datetime.fromtimestamp(o.st_mtime, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ"), o.st_size
    except OSError:
        out_ts = out_bytes = None
    return dict(path=os.path.relpath(path, base), depth=depth, kind=info["kind"], name=info["name"], key=info["key"], status=D["status"],
                goal=(D["task"] or {}).get("goal", ""), now=st["now"] if st else None, state_ts=st["ts"] if st else None,
                out_ts=out_ts, out_bytes=out_bytes, open_questions=len(D["open_q"]), attention_effects=len(attention(D)))


# ---------- the one writer ----------
def check(typ, f):
    for k in REQ[typ]:
        if k not in f:
            die("%s needs %s" % (typ, k), "give a value for " + k, 2)
    for k, v in f.items():
        for s in (v if isinstance(v, list) else [v]):
            if not isinstance(s, str):
                continue
            try:
                s.encode("utf-8")
            except UnicodeEncodeError:
                die("%s.%s is not valid UTF-8" % (typ, k), "pass UTF-8 text")
            if not s.strip():
                die("%s.%s is empty" % (typ, k), "give it a value")
            cap = CAPS.get("%s.%s" % (typ, k))
            if cap and len(s) > cap:
                die("%s.%s is %d chars, cap is %d" % (typ, k, len(s), cap),
                    "use %s of at most %d chars" % (k, cap) if typ == "node" else "put the detail in docs/ and reference it from a shorter text")
            n = secret(s)
            if n:
                die("%s.%s matches secret pattern %s" % (typ, k, n), "remove the secret; reference where it lives instead")


def emit(typ, **f):
    f = {k: v for k, v in f.items() if v is not None}
    check(typ, dict(f, by=BY))
    row = dict(v=1, ts=now(), type=typ, host=HOST, by=BY, model=MODEL)
    if os.environ.get("AWT_SESSION", "").strip():
        row["session"] = os.environ["AWT_SESSION"].strip()
    row.update(f)
    data = (json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
    if len(data) > ROWMAX:
        die("event is %d bytes, max %d" % (len(data), ROWMAX), "put the detail in docs/ and reference it")
    p = P(".awt", "events.jsonl")
    fd = os.open(p, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        with open(p, "rb") as g:
            if g.seek(0, 2):
                g.seek(-1, 2)
                if g.read(1) != b"\n":
                    data = b"\n" + data
        if os.write(fd, data) != len(data):
            die("short write to events.jsonl", "check disk space and rerun")
    finally:
        os.close(fd)
    return row


# ---------- the one reader ----------
def valid(r):
    if not isinstance(r, dict):
        return False
    for k, v in r.items():
        if k in ("v", "attempt", "pid", "timeout"):
            ok = type(v) is int
        elif k in ("tags", "after"):
            ok = isinstance(v, list) and all(isinstance(x, str) for x in v)
        else:
            ok = isinstance(v, str)
        if not ok:
            return False
    t = r.get("type")
    if "ts" not in r or t not in REQ or any(k not in r for k in REQ[t]):
        return False
    for k, vals in ENUM.items():
        if k.split(".")[0] == t and r.get(k.split(".")[1]) not in vals:
            return False
    try:
        json.dumps(r, ensure_ascii=False).encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


REMOVED_FLAGS = ("--run", "--snapshot", "--verify", "--class", "--timeout")


def claim_path(e):
    return P(".awt", "claims", "%s.%s" % (e["key"], e["attempt"]))


def fold_effect(D, r):
    """Effect state machine (SPEC 6.2). `claimed` is the old name of `begun`; two legacy `claimed` rows for one attempt mean two processes ran it (legacy conflict), but a second `begun` row is quarantined. A claim file with no `begun` row (a crash between the two) reads as begun."""
    i, s, n = r["id"], r["step"], r.get("attempt", 1)
    legacy = s == "claimed"
    s = "begun" if legacy else s
    e = D["eff"].get(i)
    if e is None:
        if s != "planned" or not r.get("target") or not r.get("key"):
            return False
        e = D["eff"][i] = dict(r, attempt=n, hist=[], claims=0)
    else:
        cur = derive(e)
        if s == "planned":
            ok = n == e["attempt"] + 1 and cur in ("begun", "unknown")
        else:
            ok = n == e["attempt"] and (
                (s == "begun" and (e["step"] == "planned" or legacy and e["step"] == "begun")) or (s == "sent" and cur in ("planned", "begun", "unknown"))
                or (s == "unknown" and cur == "begun") or (s == "dropped" and cur == "planned"))
        if not ok:
            return False
        e["attempt"] = n
        if s == "planned":
            e["claims"] = 0
    e["step"] = s
    e["claims"] += legacy
    e["hist"].append(r)
    return True


def derive(e):
    return "begun" if e["step"] == "planned" and os.path.exists(claim_path(e)) else e["step"]


def load():
    unread = None
    try:
        with open(P(".awt", "events.jsonl"), "rb") as g:
            raw = g.read()
    except FileNotFoundError:
        raw = b""
    except OSError as x:
        raw, unread = b"", x.strerror or str(x)
    rows, bad, bad_lines = [], 0, []
    for n, ln in enumerate(raw.split(b"\n"), 1):
        if not ln.strip():
            continue
        try:
            r = json.loads(ln.decode("utf-8"))
        except (ValueError, RecursionError):
            bad += 1
            bad_lines.append(n)
            continue
        if valid(r):
            rows.append(r)
        else:
            bad += 1
            bad_lines.append(n)
    D = dict(rows=rows, task=None, status="active", states={}, hist=[], notes=[], dec={}, sup={}, q={}, ans={},
             refs={}, caps=[], docs=[], eff={}, bad_lines=bad_lines, unread=unread)
    for r in rows:
        t = r["type"]
        if t == "task":
            D["task"] = r
        elif t == "status":
            D["status"] = r["status"]
        elif t == "state":
            D["states"].pop(r.get("scope", "main"), None)
            D["states"][r.get("scope", "main")] = r
            D["hist"].append(r)
        elif t == "note":
            D["notes"].append(r)
        elif t == "decision":
            D["dec"][r["id"]] = r
            if "supersedes" in r:
                D["sup"][r["supersedes"]] = r["id"]
        elif t == "question":
            D["q"][r["id"]] = r
        elif t == "answer":
            D["ans"].setdefault(r["ref"], r)
        elif t == "ref":
            D["refs"][r["target"]] = r
        elif t == "capture":
            D["caps"].append(r)
        elif t == "doc":
            D["docs"].append(r)
        elif t == "effect" and not fold_effect(D, r):
            bad += 1
    for e in D["eff"].values():
        e["state"] = derive(e)
    D["bad"] = bad
    D["open_q"] = [q for i, q in D["q"].items() if i not in D["ans"]]
    D["cur_dec"] = [d for i, d in D["dec"].items() if i not in D["sup"]]
    return D


def current_superseder(D, i):
    while i in D["sup"]:
        i = D["sup"][i]
    return i


def get_eff(D, i):
    if i not in D["eff"]:
        die("no effect " + i, "./awt list effects", 4)
    return D["eff"][i]


# ---------- filesystem views ----------
def entries(tops):
    res = []
    for top in tops:
        p = P(top)
        if os.path.islink(p) or os.path.isfile(p):
            res.append(top)
            continue
        for dp, dns, fns in os.walk(p):
            dns[:] = sorted(d for d in dns if d != ".git" and not is_node_dir(os.path.join(dp, d)))
            for n in list(dns):
                if os.path.islink(os.path.join(dp, n)):
                    dns.remove(n)
                    res.append(rel(os.path.join(dp, n)))
            res += [rel(os.path.join(dp, n)) for n in fns]
    return sorted(res)


def section_files(name, all_):
    if name == "misc":
        skip = SKIPTOP | (set(PLURAL.values()) if not node_info(ROOT)["legacy"] else set())
        tops = ["misc", "legacy"] + sorted(n for n in os.listdir(ROOT) if n not in skip)
    else:
        tops = [name]
    res = entries([t for t in tops if os.path.lexists(P(t))])
    if not all_:
        res = [x for x in res if not x.startswith("docs/_superseded/")]
    return res


def file_title(path, caps):
    p = P(path)
    if os.path.islink(p):
        return "-> " + os.readlink(p)
    if path in caps:
        return caps[path][:K["title"]]
    if not os.path.isfile(p):
        return "(not a regular file)"
    try:
        with open(p, "rb") as g:
            b = g.read(K["head"])
    except OSError:
        return "(unreadable)"
    if b"\0" in b:
        return "(binary)"
    lines = [x.strip() for x in b.decode("utf-8", "replace").splitlines() if x.strip()]
    h = next((x for x in lines if x.startswith("# ")), lines[0] if lines else "")
    return h.lstrip("# ")[:K["title"]] if h.startswith("# ") else h[:K["title"]]


def newer_files(since):
    found, seen = [], 0
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = [d for d in dns if d != ".git" and not (dp == ROOT and d in (".awt", "scratch")) and not is_node_dir(os.path.join(dp, d))]
        for n in fns:
            if n == "BRIEF.md" and dp == ROOT:
                continue
            seen += 1
            try:
                m = os.lstat(os.path.join(dp, n)).st_mtime
            except OSError:
                continue
            if m > since:
                found.append((m, rel(os.path.join(dp, n))))
        if seen > K["walk"]:
            break
    return [p for _, p in sorted(found, reverse=True)]


def git(path, *args):
    return subprocess.run(["git", "-C", path] + list(args), capture_output=True, text=True, timeout=10)


# ---------- brief and listing ----------
def cut(s, n=None):
    n = n or K["line"]
    return s if len(s) <= n else s[:n - 1] + "~"


def fit(head, lines, key, sect, suffix=""):
    """head plus as many lines as fit the budget. The overflow line points at `awt list sect`; a first line that is too long is cut."""
    budget, o, n = BUDGET[key], [head], len(head) + 1
    more = lambda k: c("+%d more: ./awt list %s" % (k, sect)) + suffix
    reserve = len(more(999)) + 1
    for i, ln in enumerate(lines):
        room = budget - n - 1 - (reserve if i < len(lines) - 1 else 0)
        if len(ln) > room:
            if i or room < 20:
                o.append(more(len(lines) - i))
                break
            ln = cut(ln, room)
        o.append(ln)
        n += len(ln) + 1
    return "\n".join(o) + "\n"


def eff_next(e):
    if e["state"] == "planned":
        return "./awt effect begin %s, send it, then ./awt effect mark %s sent" % (e["id"], e["id"])
    if e["state"] == "begun":
        w = "legacy conflict: may have been sent twice; " if e["claims"] > 1 else ""
        return w + "send only if you ran begin yourself this session, else ask a person; then ./awt effect mark %s sent|not-sent (see effect show)" % e["id"]
    return "check the target, then ./awt effect mark %s sent|not-sent  (see ./awt effect show %s)" % (e["id"], e["id"])


def size(n):
    return "%d B" % n if n < 1024 else "%.1fK" % (n / 1024) if n < 1 << 20 else "%.1fM" % (n / (1 << 20))


def lineage_section(anc):
    """anc is nearest first. Printed outermost first; when over budget the outer levels are dropped, never the nearest."""
    lines = []
    for p in anc:
        i, D = node_info(p), load_at(p)
        lines.append(cut("%s %s [%s]: %s" % (i["kind"], i["name"], D["status"], (D["task"] or {}).get("goal", "")), 110))
    budget, kept, n = BUDGET["lineage"], [], len("## Lineage") + 1
    reserve = len("+9 outer levels") + 1
    for i, ln in enumerate(lines):
        if n + len(ln) + 1 + (reserve if i < len(lines) - 1 else 0) > budget:
            break
        kept.append(ln)
        n += len(ln) + 1
    head = ["+%d outer levels" % (len(lines) - len(kept))] if len(kept) < len(lines) else []
    return "## Lineage\n" + "\n".join(head + kept[::-1]) + "\n"


RANK = {"active": 0, "paused": 1, "done": 2}


def children_section(kids):
    rows = []
    for p in kids:
        r = summarize(p, ROOT)
        tail = "%s: %s" % (ago(r["state_ts"]), cut(r["now"], 100)) if r["state_ts"] else \
            "out.md %s, %s" % (ago(r["out_ts"]), size(r["out_bytes"])) if r["out_ts"] else "no state yet"
        n = r["open_questions"] + r["attention_effects"]
        rows.append((RANK.get(r["status"], 0), -epoch(r["state_ts"]) if r["state_ts"] else 0, "%s %s [%s]%s %s" % (
            r["kind"], r["name"], r["status"], " (%d open)" % n if n else "", tail)))
    rows.sort(key=lambda r: r[:2])
    return fit("## Children", [r[2] for r in rows], "children", "nodes")


def state_order(D, scope=None):
    """Current states, the requested scope first, then newest first."""
    return sorted(reversed(list(D["states"].values())), key=lambda r: not scope or r.get("scope", "main") == scope, reverse=True)


def task_of(anc):
    return next((p for p in anc if node_info(p)["kind"] == "task"), None)


def task_decisions(D):
    return [d for d in D["cur_dec"] if "rule" not in (d.get("tags") or [])]


def task_section(tp):
    """Agent nodes only: the nearest task's own context, within its own budgets."""
    D, t = load_at(tp), load_at(tp)["task"] or {}
    suf = " --dir " + shlex.quote(tp)
    o = [fit("## Task", ["Goal: " + cut(t.get("goal", "(none)"), 170), "Done means: " + cut(t.get("done_means", "(none)"), 170)], "task_goal", "state", suf)]
    sts = state_order(D)
    if sts:
        s = sts[0]
        o.append(fit("State", ["[%s] %s\nnow: %s\nnext: %s" % (s.get("scope", "main"), ago(s["ts"]), cut(s["now"], 330), cut(s["next"], 120))] +
                     ["[%s] %s: %s" % (x.get("scope", "main"), ago(x["ts"]), cut(x["now"], 100)) for x in sts[1:]], "task_state", "state", suf))
    if D["open_q"]:
        o.append(fit("Open questions", ["%s: %s" % (q["id"], cut(q["text"], 100)) for q in D["open_q"]], "task_questions", "questions", suf))
    att = attention(D)
    if att:
        o.append(fit("Effects needing attention", ["%s %s %s" % (e["id"], e["state"], cut(e["target"], 60)) for e in att], "task_effects", "effects", suf))
    ds = task_decisions(D)
    if ds:
        o.append(fit("Decisions", ["%s %s" % (d["id"], cut(d["choice"], 120)) for d in ds[::-1]], "task_decisions", "decisions", suf))
    return "".join(o)


def repo_refs(nodes):
    """repo refs of the nodes (nearest first) on this host, each path once."""
    seen, res = set(), []
    for D in nodes:
        for r in D["refs"].values():
            if r["kind"] == "repo" and r.get("host") == HOST and r.get("path") and r["path"] not in seen:
                seen.add(r["path"])
                res.append(r)
    return res


FRAMED = False  # set by `resume --hook --framed`: reference data only, no next-step hints


def brief(scope=None, git_section=True):
    D, o, info = load(), [], node_info(ROOT)
    anc, kids = ancestors(ROOT), children(ROOT)
    AD = [load_at(p) for p in anc]
    t = D["task"]
    o.append(fit("# awt task", ["Goal: " + cut(t["goal"], 250), "Done means: " + cut(t["done_means"], 250), "Status: " + D["status"]]
                 if t else ["Goal: (none recorded)" + ("" if anc or kids or not info["legacy"] or FRAMED else c(' ./awt init --goal "..." --done "..."')), "Status: " + D["status"]], "goal", "state"))
    if anc:
        o.append(lineage_section(anc))
        tp = task_of(anc)
        if info["kind"] == "agent" and tp:
            o.append(task_section(tp))
    sts = state_order(D, scope)
    if sts:
        s = sts[0]
        o.append(fit("## State", ["[%s] %s\nnow: %s\nnext: %s" % (s.get("scope", "main"), ago(s["ts"]), s["now"], s["next"])] +
                     ["[%s] %s: %s" % (x.get("scope", "main"), ago(x["ts"]), cut(x["now"], 100)) for x in sts[1:]], "state", "state"))
    if kids:
        o.append(children_section(kids))
    if D["open_q"]:
        o.append(fit("## Open questions", ["%s: %s" % (q["id"], cut(q["text"])) for q in D["open_q"]], "questions", "questions"))
    att = attention(D)
    if att:
        o.append(fit("## Effects needing attention", [cut(c("%s %s %s" % (e["id"], e["state"], e["target"]) + ("" if FRAMED else ": " + eff_next(e)))) for e in att], "effects", "effects"))
    ch = []
    if sts:
        # the plugin's stand-in handoff (scope auto) is not a handoff: measure from the agent's own
        since = epoch(next((r for r in sts if r.get("scope", "main") != "auto"), sts[0])["ts"])
        nf = newer_files(since)
        if nf:
            ch += ["%d files newer than state:" % len(nf)] + ["  " + cut(x) for x in nf[:K["newer"]]]
        for r in (repo_refs([D] + AD) if git_section else []):
            try:
                lg = git(r["path"], "log", "--since=%d" % int(since), "--format=%s", "-n", "5")
                dirty = git(r["path"], "status", "--porcelain")
                if lg.returncode or dirty.returncode:
                    raise OSError("git failed")
                subj = [x for x in lg.stdout.splitlines() if x]
                ch.append(cut("repo %s: %d new commits%s; %d dirty" % (os.path.basename(r["path"]), len(subj), (" (" + "; ".join(subj) + ")") if subj else "", len(dirty.stdout.splitlines()))))
            except Exception:
                ch.append("repo %s: git unavailable (degraded)" % os.path.basename(r["path"]))
    else:
        ch.append("No state yet; cannot tell what changed.")
    o.append(fit("## Changes since newest state", ch, "changes", "context"))
    inherited = []
    for p, AdD in list(zip(anc, AD))[::-1]:
        i = node_info(p)
        inherited += ["%s [rule, %s %s] %s" % (d["id"], i["kind"], i["name"], cut(d["choice"], 120)) for d in AdD["cur_dec"] if "rule" in (d.get("tags") or [])]
    if D["cur_dec"] or inherited:
        ds = D["cur_dec"][::-1]
        ds.sort(key=lambda d: "rule" not in (d.get("tags") or []))
        o.append(fit("## Decisions", ["%s %s%s" % (d["id"], "[rule] " if "rule" in (d.get("tags") or []) else "", cut(d["choice"], 120)) for d in ds] + inherited,
                     "decisions", "decisions", "; inherited: awt find --up rule" if inherited and not FRAMED else ""))
    refs = [ref_view(r) for r in D["refs"].values()]
    inv = "Inventory: %d refs (%d no-access), " % (len(refs), sum(r["access"] == "none" for r in refs)) + ", ".join(
        "%d %s" % (len(section_files(s, False)), s) for s in ("context", "docs", "outbox", "misc"))
    if D["bad"]:
        inv += "; %d quarantined rows" % D["bad"]
    o.append(fit("## More", [cut(inv, 140)] + ([] if FRAMED else [c("./awt list | ./awt find <term>")]) + (["WARNING: .awt/events.jsonl is unreadable (%s); showing nothing from it" % D["unread"]] if D["unread"] else []), "inventory", "state"))
    if not sts and not FRAMED:
        o.append(c('No handoff yet. Before stopping: ./awt state --now "..." --next "..."\n'))
    return "".join(o)


def node_rows(all_):
    ds, limit = descendants(ROOT)
    rows = [summarize(p, ROOT, d) for p, d in ds]
    if not all_:
        gone = set()
        keep = []
        for r in rows:
            parent = os.path.dirname(os.path.dirname(r["path"]))
            if r["status"] == "done" or parent in gone:
                gone.add(r["path"])
            else:
                keep.append(r)
        rows = keep
    return rows, limit


def ref_target(r):
    """Where a node ref points on this host: its key under the tree root first, then its stored path. None if neither resolves."""
    if r.get("key"):
        p = find_key(tree_top(ROOT), r["key"])
        if p:
            return p
    p = os.path.normpath(os.path.join(ROOT, r["path"])) if r.get("path") else None
    return p if p and is_node_dir(p) else None


def ref_view(r):
    if r["kind"] != "node":
        return r
    p = ref_target(r)
    return dict(r, path=os.path.relpath(p, ROOT), access=r["access"]) if p else dict(r, access="none")


JSON_KEYS = dict(
    refs="ts by model target title kind why access path branch key", decisions="ts by model id choice why tags supersedes superseded_by",
    questions="ts by model id text answer", effects="ts by model id target why body how state attempt", notes="ts by model id text", state="ts by model scope now next")


def shaped(name, rows):
    """Rows with one fixed key set per section: absent optional fields are null, tags is a list, scope defaults to main."""
    dflt = dict(tags=[], scope="main", model="unknown:legacy")
    return [{k: r.get(k, dflt.get(k)) for k in JSON_KEYS[name].split()} for r in rows]


def listing_json(name, D, all_):
    if name in ("nodes", "tree"):
        return node_rows(all_)[0]
    if name in ("context", "docs", "outbox", "misc"):
        caps = {c_["path"]: c_["title"] for c_ in D["caps"]}
        return [dict(path=f, title=file_title(f, caps)) for f in section_files(name, all_)]
    if name == "refs":
        return shaped(name, [ref_view(r) for r in D["refs"].values()])
    if name == "decisions":
        return shaped(name, [dict(d, superseded_by=current_superseder(D, d["id"]) if d["id"] in D["sup"] else None) for d in D["dec"].values() if all_ or d["id"] not in D["sup"]])
    if name == "questions":
        return shaped(name, [dict(q, answer=D["ans"][i]["text"] if i in D["ans"] else None) for i, q in D["q"].items() if all_ or i not in D["ans"]])
    if name == "effects":
        return shaped(name, [dict(e, how=e.get("how") or e.get("run")) for e in D["eff"].values() if all_ or e["state"] not in ("sent", "dropped")])
    if name == "notes":
        return shaped(name, D["notes"])
    return shaped("state", D["hist"] if all_ else D["states"].values())


def listing(name, D, all_):
    if name == "nodes":
        rows, limit = node_rows(all_)
        return ["%s %s %s [%s]%s" % (r["path"], r["kind"], r["name"], r["status"], " key=" + r["key"] if r["key"] else "") for r in rows] + (["+ more nodes not shown (limit)"] if limit else [])
    if name == "tree":
        rows, limit = node_rows(all_)
        return ["%s%s %s [%s]%s %s" % ("  " * (r["depth"] - 1), r["kind"], r["name"], r["status"], " ?%d" % (r["open_questions"] + r["attention_effects"]) if r["open_questions"] or r["attention_effects"] else "", cut(r["goal"], 60)) for r in rows] + (["+ more nodes not shown (limit)"] if limit else [])
    if name in ("context", "docs", "outbox", "misc"):
        caps = {c["path"]: c["title"] for c in D["caps"]}
        est = {e["body"]: e["state"] for e in D["eff"].values() if e.get("body")}
        return [("%s  %s" % (f, file_title(f, caps))).rstrip() + ("  [%s]" % est[f] if f in est else "") if not os.path.islink(P(f))
                else "%s %s" % (f, file_title(f, caps)) for f in section_files(name, all_)]
    if name == "refs":
        return ["%s [%s%s] %s  %s" % (r["kind"], r["access"], ", " + r["path"] + "@" + r.get("branch", "") if r["kind"] == "repo" else ", " + r["path"] if r["kind"] == "node" and r.get("path") else "", r["title"], r["target"]) for r in map(ref_view, D["refs"].values())]
    if name == "decisions":
        return ["%s%s %s -- %s" % (d["id"], " [%s]" % ",".join(d["tags"]) if d.get("tags") else "", d["choice"], d["why"]) + (" (superseded by %s)" % current_superseder(D, d["id"]) if d["id"] in D["sup"] else "")
                for d in D["dec"].values() if all_ or d["id"] not in D["sup"]]
    if name == "questions":
        return ["%s %s" % (q["id"], q["text"]) + (" => " + D["ans"][i]["text"] if i in D["ans"] else "") for i, q in D["q"].items() if all_ or i not in D["ans"]]
    if name == "effects":
        return ["%s %s %s attempt=%s%s" % (e["id"], e["state"], e["target"], e["attempt"], " body=" + e["body"] if e.get("body") else "")
                for e in D["eff"].values() if all_ or e["state"] not in ("sent", "dropped")]
    if name == "notes":
        return ["%s %s" % (n["id"], n["text"]) for n in D["notes"]]
    rows = D["hist"] if all_ else list(D["states"].values())
    return ["[%s] %s now: %s | next: %s" % (s.get("scope", "main"), ago(s["ts"]), s["now"], s["next"]) for s in rows]


# ---------- BRIEF.md: a derived file, never read back as state ----------
FANOUT = 20  # most agents below a task whose briefs a task write refreshes
WRITES = {"state", "note", "decide", "ask", "answer", "ref", "capture", "status"}


def write_brief(path, git_section=True):
    """Regenerate path/BRIEF.md from the log: temp file in .awt/, then rename. Nothing reads it back; any failure is silent."""
    global ROOT, A
    old, tmp = (ROOT, A), os.path.join(path, ".awt", "BRIEF.%d.tmp" % os.getpid())
    try:
        if not os.path.isdir(os.path.join(path, ".awt")):
            return
        ROOT = path
        A = "awt" if (not node_info(path)["legacy"] or parent(path)) else "./awt"
        ensure_gitignore(True)
        text = brief(git_section=git_section) + "Generated %s; ages above are as of then.\n" % now()[:19]
        with open(tmp, "w", encoding="utf-8") as g:
            g.write(text)
        os.replace(tmp, os.path.join(path, "BRIEF.md"))
    except (Exception, SystemExit):
        try:
            os.unlink(tmp)
        except OSError:
            pass
    finally:
        ROOT, A = old


def refresh_briefs(path):
    """After a write at path: its own brief, its parent's (children section) and, for a task, every agent below (task section)."""
    write_brief(path)  # only this one runs git; the others' repo lines wait for their own write or hook
    p = parent(path)
    if p:
        write_brief(p, False)
    try:
        if node_info(path)["kind"] == "task":
            agents = [q for q, _ in descendants(path)[0] if node_info(q)["kind"] == "agent"]
            if len(agents) <= FANOUT:  # a big fan-out would make every task write cost one file per agent; their next write or hook refreshes them
                for q in agents:
                    write_brief(q, False)
    except (Exception, SystemExit):
        pass


# ---------- verbs ----------
def create(path, text):
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        return False
    with os.fdopen(fd, "w", encoding="utf-8") as g:
        g.write(text)
    return True


def find_claude_md(d):
    home = os.path.realpath(os.path.expanduser("~/.claude"))
    while True:
        if os.path.realpath(d) != home and os.path.isfile(os.path.join(d, "CLAUDE.md")):
            return os.path.join(d, "CLAUDE.md")
        if os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


def slugify(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:50].strip("-") or "node"


def ensure_gitignore(existing_only=False):
    """Append the missing IGNORE lines; existing_only: only to a .gitignore that is already there (a pre-phase-2 node)."""
    gi = P(".gitignore")
    if existing_only and not os.path.exists(gi):
        return
    have = open(gi, encoding="utf-8", errors="replace").read() if os.path.exists(gi) else ""
    miss = [x for x in IGNORE if x not in have.splitlines()]
    if miss:
        with open(gi, "a", encoding="utf-8") as g:
            g.write(("" if not have or have.endswith("\n") else "\n") + "\n".join(miss) + "\n")
    return bool(miss)


def build_node(path, kind, name, key, goal, done):
    """Write a complete node at path. Rows go through emit(), so the secret scan and caps apply."""
    global ROOT
    old, ROOT = ROOT, path
    try:
        for d in NODE_DIRS[kind] + (".awt/claims",):
            os.makedirs(P(d), exist_ok=True)
        os.close(os.open(P(".awt", "events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644))
        emit("node", kind=kind, name=name, key=key)
        if goal:
            emit("task", goal=goal, done_means=done)
        ensure_gitignore()
        if kind == "task":
            create(P("AGENTS.md"), TREE_BLOCK)
            os.makedirs(P(".claude"), exist_ok=True)
            create(P(".claude", "settings.json"), SETTINGS_TREE)
    finally:
        ROOT = old


def tree_top(node):
    """The tree root: the nearest ancestor of kind root, else the outermost ancestor, else node (at most 8 levels up)."""
    for _ in range(K["depth"]):
        up = None if node_info(node)["kind"] == "root" else parent(node)
        if not up:
            break
        node = up
    return node


def find_key(top, key):
    """Path of the node under top (top included) whose key matches, or None. Reserved dirs only, no symlinks, limits as in SPEC."""
    todo, seen = [(top, 0)], 0
    while todo:
        node, depth = todo.pop()
        seen += 1
        if node_info(node)["key"] == key:
            return node
        if depth >= 8 or seen > 2000:
            continue
        for plural in PLURAL.values():
            d = os.path.join(node, plural)
            if os.path.islink(d) or not os.path.isdir(d):
                continue
            for n in sorted(os.listdir(d), reverse=True):
                p = os.path.join(d, n)
                if not n.startswith(".new-") and not os.path.islink(p) and is_node_dir(p):
                    todo.append((p, depth + 1))
    return None


def init_child(a):
    global ROOT
    kind = a.kind
    ROOT = find_root(a.dir)
    if not ROOT:
        die("no parent node", "cd into a node, set AWT_DIR or pass --dir; make a root with: awt init --kind root", 4)
    if not a.name:
        die("--kind %s needs --name" % kind, "give --name NAME", 2)
    if bool(a.goal) != bool(a.done):
        die("--goal and --done go together", "give both", 2)
    pk = node_info(ROOT)["kind"]
    if kind not in LEGAL[pk]:
        die("a %s cannot contain a %s" % (pk, kind), "a %s may contain: %s" % (pk, ", ".join(LEGAL[pk])))
    if kind == "task" and not a.goal:
        die("a task needs --goal and --done", "give both")
    goal = a.goal or a.name
    done = a.done or ("ongoing" if kind in ("project", "workspace") else "agent work recorded")
    check("node", dict(kind=kind, name=a.name, key=a.key, by=BY))
    check("task", dict(goal=goal, done_means=done, by=BY))
    base = P(PLURAL[kind])
    if os.path.islink(base):
        die("%s/ is a symlink" % PLURAL[kind], "replace it with a real directory inside " + ROOT)
    os.makedirs(base, exist_ok=True)
    lockfd = None
    if a.key:
        top = tree_top(ROOT)
        lockfd = os.open(os.path.join(top, ".awt", "events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            fcntl.flock(lockfd, fcntl.LOCK_EX)
        except OSError:
            os.close(lockfd)
            die("cannot lock %s" % top, "keyed init needs a local filesystem; put the tree on one")
    try:
        if a.key:
            p = find_key(top, a.key)
            if p:
                if not os.environ.get("AWT_NO_BRIEF"):
                    write_brief(p)  # a re-opened or pre-phase-2 agent gets a current brief
                return out("init %s %s" % (os.path.relpath(p, ROOT), node_info(p)["kind"]))
        tmp = os.path.join(base, ".new-" + os.urandom(4).hex())
        os.mkdir(tmp)
        try:
            build_node(tmp, kind, a.name, a.key, goal, done)
            slug, n = slugify(a.name), 1
            while True:
                final = os.path.join(base, slug if n == 1 else "%s-%d" % (slug, n))
                try:
                    os.rename(tmp, final)
                    break
                except OSError as x:
                    if x.errno in (errno.ENOTEMPTY, errno.EEXIST, errno.ENOTDIR) or os.path.lexists(final):
                        n += 1
                        continue
                    raise
        except BaseException:
            shutil.rmtree(tmp, ignore_errors=True)
            raise
        refresh_briefs(final)
        out("init %s %s" % (rel(final), kind))
    finally:
        if lockfd is not None:
            os.close(lockfd)


def hook_paths():
    """Where each provider's awt context hook lives; the environment variables are the providers' own."""
    home = os.path.expanduser("~")
    oc = os.environ.get("OPENCODE_CONFIG_DIR") or os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config"), "opencode")
    return dict(claude=os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude"), "settings.json"),
                opencode=os.path.join(oc, "plugins", "awt-context.js"),
                pi=os.path.join(os.environ.get("PI_CODING_AGENT_DIR") or os.path.join(home, ".pi", "agent"), "extensions", "awt-context.ts"))


def awt_path():
    """The path to pin: `awt` on PATH when it is this script, else the invoked path. Never resolved through symlinks, so a stable entry point stays stable."""
    me = sys.argv[0] if sys.argv and sys.argv[0] else __file__
    if os.sep not in me:
        me = shutil.which(me) or me
    me = os.path.abspath(me)
    onpath = shutil.which("awt")
    if onpath and os.path.realpath(onpath) == os.path.realpath(me):
        return os.path.abspath(onpath)
    return me


def hook_command():
    me = awt_path()
    return '[ -n "$AWT_DIR" ] || exit 0; %s resume --hook --framed 2>/dev/null; exit 0 # %s' % (shlex.quote(me), HOOK_MARK)


def is_awt_hook(entry):
    return isinstance(entry, dict) and any(isinstance(h, dict) and HOOK_MARK in str(h.get("command", "")) for h in entry.get("hooks") or [] if isinstance(h, dict))


def write_atomic(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.awt-tmp-%d" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    with os.fdopen(fd, "w", encoding="utf-8") as g:
        g.write(text)
    os.replace(tmp, path)


def merge_claude_settings(path, uninstall):
    """Add or remove the SessionStart `compact` hook. Returns what happened; every other key and every other hook stays as it was,
    even in an entry that also holds awt's hook. A symlinked settings file is followed: the target is written."""
    path = os.path.realpath(path)
    for attempt in range(3):
        try:
            with open(path, encoding="utf-8") as g:
                raw = g.read()
            sig = os.stat(path)
            sig = (sig.st_mtime_ns, sig.st_size)
            st = json.loads(raw) if raw.strip() else {}
        except FileNotFoundError:
            raw, sig, st = None, None, {}
        except ValueError:
            die("%s is not valid JSON; awt will not touch it" % path, "fix the file by hand, then run this again")
        if not isinstance(st, dict) or not isinstance(st.get("hooks", {}), dict) or not isinstance(st.get("hooks", {}).get("SessionStart", []), list):
            die("%s has an unexpected hooks shape; awt will not touch it" % path, "make hooks.SessionStart a list, then run this again")
        hooks = st.setdefault("hooks", {})
        ss = hooks.setdefault("SessionStart", [])
        ours = lambda h: isinstance(h, dict) and HOOK_MARK in str(h.get("command", ""))
        mine = [h for e in ss if isinstance(e, dict) for h in (e.get("hooks") or []) if ours(h)]
        entry = {"matcher": "compact", "hooks": [{"type": "command", "timeout": 10, "command": hook_command()}]}
        if uninstall:
            if not mine:
                return "absent"
            res = "removed"
        else:
            if len(mine) == 1 and mine[0] == entry["hooks"][0] and any(isinstance(e, dict) and e.get("matcher") == "compact" and mine[0] in (e.get("hooks") or []) for e in ss):
                return "unchanged"
            res = "updated" if mine else "installed"
        kept = []
        for e in ss:
            if isinstance(e, dict) and isinstance(e.get("hooks"), list) and any(ours(h) for h in e["hooks"]):
                e["hooks"] = [h for h in e["hooks"] if not ours(h)]
                if not e["hooks"]:
                    continue
            kept.append(e)
        ss[:] = kept + ([] if uninstall else [entry])
        if uninstall:
            if not ss:
                del hooks["SessionStart"]
            if not hooks:
                del st["hooks"]
        mode = os.stat(path).st_mode & 0o777 if raw is not None else 0o600
        if raw is not None:
            bak = "%s.awt-bak-%s-%d" % (path, datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f"), os.getpid())
            shutil.copy2(path, bak)
            prune_backups(path)
            res += " (backup %s)" % bak
        try:
            cur = os.stat(path)
            changed = (cur.st_mtime_ns, cur.st_size) != sig
        except FileNotFoundError:
            changed = sig is not None
        if changed:  # something else (Claude Code itself) wrote the file since we read it: read again
            continue
        write_atomic(path, json.dumps(st, indent=2, ensure_ascii=False) + "\n", mode)
        return res
    die("%s keeps changing while awt reads it" % path, "close the running provider, then run this again")


def prune_backups(path, keep=5):
    d, base = os.path.dirname(path), os.path.basename(path) + ".awt-bak-"
    for old in sorted(x for x in os.listdir(d) if x.startswith(base))[:-keep]:
        try:
            os.remove(os.path.join(d, old))
        except OSError:
            pass


def install_file(path, text, uninstall):
    try:
        with open(path, encoding="utf-8") as g:
            cur = g.read()
    except FileNotFoundError:
        cur = None
    if cur is not None and not cur.startswith("// awt:"):
        die("%s is not an awt file; awt will not touch it" % path, "move it away, then run this again")
    if uninstall:
        if cur is None:
            return "absent"
        os.remove(path)
        return "removed"
    if cur == text:
        return "unchanged"
    write_atomic(path, text)
    return "updated" if cur is not None else "installed"


def cmd_hooks(a):
    """init --hooks: put the awt record into each provider's context after a compaction, silently. Touches only the provider's own files."""
    if a.kind or a.goal or a.done or a.name or a.key:
        die("--hooks stands alone", "run it without --goal, --done, --kind, --name or --key", 2)
    want = ["claude", "opencode", "pi"] if a.hooks == "all" else [a.hooks]
    paths = hook_paths()
    me = json.dumps(awt_path())
    for prov in want:
        p = paths[prov]
        if prov == "claude":
            res = merge_claude_settings(p, a.uninstall)
        else:
            res = install_file(p, (OC_PLUGIN if prov == "opencode" else PI_EXT).replace("__AWT_BIN__", me), a.uninstall)
        out("hooks %s: %s %s" % (prov, res, p))


def hook_state(prov):
    """(state, pinned path): installed, missing, or stale (the pinned awt is gone or not executable)."""
    p = hook_paths()[prov]
    try:
        with open(p, encoding="utf-8") as g:
            txt = g.read()
        if prov == "claude":
            hs = [h for e in json.loads(txt)["hooks"]["SessionStart"] if isinstance(e, dict) and e.get("matcher") == "compact"
                  for h in e.get("hooks") or [] if isinstance(h, dict) and HOOK_MARK in str(h.get("command", ""))]
            if not hs:
                return "missing", None
            tok = shlex.split(hs[0]["command"].split("; ", 1)[1])
            pin = tok[tok.index("resume") - 1]
        else:
            if "--framed" not in txt:
                return "missing", None
            m = re.search(r'execFile(?:Sync)?\(("(?:[^"\\]|\\.)*")', txt)
            pin = json.loads(m.group(1))
    except Exception:
        return "missing", None
    return ("installed" if os.path.isfile(pin) and os.access(pin, os.X_OK) else "stale"), pin


def hook_checks(line):
    """doctor: one line per detected provider; warns when the compaction hook is missing or pins an awt that is gone. Reads only; never fails."""
    for prov, p in hook_paths().items():
        cfg = os.path.dirname(os.path.dirname(p)) if prov != "claude" else os.path.dirname(p)
        if not os.path.isdir(cfg):
            continue
        st, pin = hook_state(prov)
        if st == "installed":
            line("ok", "%s compaction hook installed" % prov)
        elif st == "stale":
            line("warn", "%s compaction hook pins %s, which is missing or not executable; after a compaction the agent will not get the awt record (ask the person to re-run: awt init --hooks %s)" % (prov, pin, prov))
        else:
            line("warn", "%s compaction hook missing; after a compaction the agent will not get the awt record (ask the person to run: awt init --hooks %s; agents do not run it)" % (prov, prov))


def cmd_init(a):
    global ROOT
    if a.uninstall and not a.hooks:
        die("--uninstall needs --hooks", "awt init --hooks claude|opencode|pi|all --uninstall", 2)
    if a.hooks:
        return cmd_hooks(a)
    if a.kind and a.kind != "root":
        return init_child(a)
    ROOT = a.dir or os.environ.get("AWT_DIR") or cwd()
    if not ROOT:
        die("the current directory no longer exists", "cd to a real directory or pass --dir PATH")
    ROOT = os.path.realpath(os.path.expanduser(ROOT))
    if bool(a.goal) != bool(a.done):
        die("--goal and --done go together", "give both", 2)
    if (a.name or a.key) and not a.kind:
        die("--name and --key need --kind", "give --kind root|project|workspace|task|agent, or drop them", 2)
    tree = a.kind == "root"
    ni = node_info(ROOT)
    if not ni["legacy"] and ni["kind"] != a.kind:
        die("%s is a %s node; init cannot turn it into %s" % (ROOT, ni["kind"], "a " + a.kind if a.kind else "a standalone task"),
            "add children with: awt init --kind KIND --name NAME")
    if tree and ni["legacy"]:
        try:
            has_rows = os.path.getsize(os.path.join(ROOT, ".awt", "events.jsonl")) > 0
        except OSError:
            has_rows = False
        if has_rows:
            die("%s already has records and no node row" % ROOT, "a root needs a directory without .awt records; use an empty one")
    for d in (("workspaces",) if tree else ("context", "docs", "outbox", "misc", "scratch")) + (".awt/claims",):
        os.makedirs(P(d), exist_ok=True)
    os.close(os.open(P(".awt", "events.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644))
    made = []
    ag = P("AGENTS.md")
    block = TREE_BLOCK if tree else AGENTS_BLOCK
    if not os.path.exists(ag):
        create(ag, block)
        made.append("AGENTS.md")
    else:
        with open(ag, encoding="utf-8", errors="replace") as g:
            txt = g.read()
        if BLOCK_BEGIN not in txt:
            with open(ag, "a", encoding="utf-8") as g:
                g.write(("" if not txt or txt.endswith("\n") else "\n") + "\n" + block)
            made.append("AGENTS.md(block)")
    D0 = load()
    t = D0["task"]
    if create(P("README.md"), (TREE_README if tree else README).format(goal=(a.goal or (t or {}).get("goal") or ("Node tree" if tree else "Task workspace")).splitlines()[0])):
        made.append("README.md")
    if ensure_gitignore():
        made.append(".gitignore")
    if not tree:
        os.makedirs(P(".claude"), exist_ok=True)
        if create(P(".claude", "settings.json"), SETTINGS):
            made.append(".claude/settings.json")
        else:
            print("note: .claude/settings.json exists; merge this snippet yourself:\n" + SETTINGS)
    cm = find_claude_md(ROOT)
    if cm:
        print("warning: %s exists; Claude Code may then skip AGENTS.md. Add the line @AGENTS.md to it." % cm, file=sys.stderr)
    if tree and not any(r["type"] == "node" for r in D0["rows"]):
        emit("node", kind="root", name=a.name or os.path.basename(ROOT) or "root", key=a.key)
        made.append("node")
    if a.goal and (not t or (t["goal"], t["done_means"]) != (a.goal, a.done)):
        emit("task", goal=a.goal, done_means=a.done)
        made.append("task")
    refresh_briefs(ROOT)
    out("init %s: %s" % (ROOT, " ".join(made) or "nothing to change"))


def resume_json(scope):
    D = load()
    info = node_info(ROOT)
    t = D["task"] or {}
    anc = ancestors(ROOT)
    sts = state_order(D, scope)
    tp = task_of(anc) if info["kind"] == "agent" else None
    task = None
    if tp:
        TD = load_at(tp)
        task = dict(summarize(tp, ROOT, -(anc.index(tp) + 1)), done_means=(TD["task"] or {}).get("done_means"), state=(state_order(TD) or [None])[0],
                    open_questions=TD["open_q"], attention_effects=attention(TD), decisions=task_decisions(TD))
    return dict(node=dict(kind=info["kind"], name=info["name"], key=info["key"], legacy=info["legacy"]), status=D["status"], goal=t.get("goal"),
                done_means=t.get("done_means"), state=sts[0] if sts else None, open_questions=D["open_q"], attention_effects=attention(D), decisions=D["cur_dec"],
                lineage=[summarize(p, ROOT, -i - 1) for i, p in list(enumerate(anc))[::-1]], children=[summarize(p, ROOT, 1) for p in children(ROOT)],
                task=task, brief=brief(scope))


def cmd_resume(a):
    if getattr(a, "json", False):
        print(json.dumps(resume_json(getattr(a, "scope", None)), ensure_ascii=False, default=str))
        return
    if getattr(a, "framed", False) and not a.hook:
        die("--framed goes with --hook", "awt resume --hook --framed", 2)
    if a.hook:
        try:
            if a.framed and not (a.dir or os.environ.get("AWT_DIR")):
                return  # compaction context is for agents that have a node, never for whatever directory the hook runs in
            r = find_root(a.dir)
            if r:
                globals()["ROOT"] = r
                set_cmd()
                globals()["FRAMED"] = bool(a.framed)
                sys.stdout.write((FRAME + "\n" if a.framed else "") + brief())
                sys.stdout.flush()
                if not a.framed and not os.environ.get("AWT_NO_BRIEF"):
