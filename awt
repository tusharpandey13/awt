def store_inputs(store, root):
    """[(kind, path, size)] sorted: the canonical files and node logs a build reads. Sizes only, so the list is a function of the inputs' content (the logs are append-only)."""
    res = []
    for dp, dns, fns in os.walk(os.path.join(store, "log")):
        dns.sort()
        res += [("canonical", os.path.join(dp, f), os.path.getsize(os.path.join(dp, f))) for f in sorted(fns) if f.endswith(".jsonl")]
    for p in node_paths(root):
        try:
            res.append(("node", os.path.join(p, ".awt", "events.jsonl"), os.path.getsize(os.path.join(p, ".awt", "events.jsonl"))))
        except OSError:
            pass
    return res


def node_paths(root):
    if not root:
        return []
    top = tree_top(root)
    return [top] + [p for p, _ in descendants(top)[0]]


def top_of(root):
    return os.path.realpath(tree_top(root)) if root else ""


def input_keys(store, root, inputs):
    """{(kind, path relative to the store or the tree top): size}: what a build records and what freshness compares."""
    top = top_of(root)
    return {(k, os.path.relpath(p, store if k == "canonical" else top)): n for k, p, n in inputs}


def fingerprint(store, root, inputs=None):
    keys = input_keys(store, root, store_inputs(store, root) if inputs is None else inputs)
    return sha(json.dumps([top_of(root)] + [(k, p, n) for (k, p), n in sorted(keys.items())]).encode())


def ingest_tree(store, explicit):
    """The node whose tree store.db indexes. AWT_ROOT, then --dir, then the tree recorded by the last ingest (so cron, a bare directory or a second tree do not change
    what store.db holds), then the caller's own tree. A tree named by AWT_ROOT or --dir, or the first one found, is recorded in ingest/tree."""
    mark = os.path.join(store, "ingest", "tree")
    want = os.environ.get("AWT_ROOT") or explicit
    root = find_root(want) if want else None
    try:
        with open(mark, encoding="utf-8") as g:
            cur = g.read().strip()
    except OSError:
        cur = None
    if not root and cur:
        root = find_root(cur)
    root = root or find_root(None)
    if root:
        top = top_of(root)
        if cur != top and (want or not cur or not os.path.isdir(os.path.join(cur, ".awt"))):
            private_dir(os.path.join(store, "ingest"), store)
            tmp = "%s.%d.tmp" % (mark, os.getpid())
            with open(tmp, "w", encoding="utf-8") as g:
                g.write(top + "\n")
            os.replace(tmp, mark)
    return root


def store_fresh(store, root):
    try:
        db = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(os.path.join(store, "store.db")), uri=True, timeout=busy_s(5))
        try:
            m = dict(db.execute("SELECT key, value FROM schema_meta"))
        finally:
            db.close()
        return m.get("schema_version") == str(SCHEMA_VERSION) and m.get("inputs") == fingerprint(store, root)
    except sqlite3.Error:
        return False


def record_text(fields):
    """The FTS text of a record, from its stored fields JSON (so a delete can recompute exactly what an insert indexed)."""
    r = json.loads(fields)
    text = " ".join(str(v) if not isinstance(v, list) else " ".join(map(str, v)) for k, v in sorted(r.items()) if k not in ("v", "ts", "type", "host", "by", "model", "session"))
    return u(text[:FTS_CAP])


def fts_add(db, kind, ref, text):
    """One contentless FTS row; fts_ref maps its rowid back to the row it indexes."""
    db.execute("INSERT INTO fts_text(rowid, text) VALUES (?, ?)", (db.execute("INSERT INTO fts_ref(kind, ref) VALUES (?, ?)", (kind, ref)).lastrowid, text))


def fts_row(db, kind, cur, text):
    """FTS row for a row just inserted with INSERT OR IGNORE (nothing when it was ignored or has no text)."""
    if text and cur.rowcount == 1:
        fts_add(db, kind, cur.lastrowid, text[:FTS_CAP])


def fts_drop(db, rows):
    """Remove FTS rows given [(fts rowid, the exact text indexed)]; a contentless table needs the text back."""
    for i, text in rows:
        db.execute("INSERT INTO fts_text(fts_text, rowid, text) VALUES ('delete', ?, ?)", (i, text))
        db.execute("DELETE FROM fts_ref WHERE id=?", (i,))


def u(s):
    """s as text SQLite can hold: lone surrogates (valid in JSON, not in UTF-8) become ?."""
    return s.encode("utf-8", "replace").decode("utf-8") if isinstance(s, str) else s


def blocks_of(content):
    if isinstance(content, str):
        return [{"type": "text", "text": content}]
    return [b for b in content if isinstance(b, dict)] if isinstance(content, list) else []


def block_text(c):
    if isinstance(c, str):
        return c
    return "\n".join(b["text"] for b in c if isinstance(b, dict) and isinstance(b.get("text"), str)) if isinstance(c, list) else ""


def ms_between(a, b):
    """Milliseconds from ISO time a to b, or None."""
    try:
        f = lambda x: datetime.datetime.fromisoformat(x.replace("Z", "+00:00"))
        return int(round((f(b) - f(a)).total_seconds() * 1000))
    except (AttributeError, ValueError, TypeError):
        return None


def sqlint(x):
    """x when it is an integer SQLite can hold (a signed 64-bit one), else None: a transcript or ccusage figure out of range is stored as missing, never raises."""
    return x if isinstance(x, int) and not isinstance(x, bool) and -2**63 <= x < 2**63 else None


def put_usage(db, sid, provider, mid, turn, resp, inp, out, cr, cw, cost, lat, api=None):
    """One usage row for an assistant message (grain `message`). Counts are kept only when they are SQLite integers; cost only when the transcript carried one (cost_source computed)."""
    n, lat = sqlint, sqlint(lat)
    cost = cost if isinstance(cost, (int, float)) and not isinstance(cost, bool) and math.isfinite(cost) else None
    db.execute("INSERT OR REPLACE INTO usage VALUES (?,'message',?,NULL,?,?,?,NULL,?,?,?,?,?,?,?,?,?,NULL)", ("m:%s:%s" % (sid, mid), sid, provider, mid, turn, resp, n(inp), n(out), n(cr), n(cw),
               cost, "computed" if cost is not None else None, lat, api))


def derive_claude(db, sid, rows, place):
    """messages, turns, tool_calls and the session row of one canonical claude file. A turn starts at each user message that carries text (not only tool results)."""
    conv = cwd_ = model = first = last = None
    real = lambda x: x if isinstance(x, str) and x.strip() and x != "<synthetic>" else None
    turns, calls, turn = [], {}, -1
    uses, tsof, first_parent = {}, {}, {}  # uses: API message id -> its last record's usage (a streamed message is written as several records that repeat it); first_parent: API id -> parentUuid of its first record (the request)
    for seq, r in rows:
        if not isinstance(r, dict):
            continue
        ts = r.get("timestamp") if isinstance(r.get("timestamp"), str) else None
        tsof[r.get("uuid")] = ts
        conv, cwd_ = r.get("sessionId") if isinstance(r.get("sessionId"), str) and r.get("sessionId") else conv, cwd_ or r.get("cwd")  # the last sessionId: a resumed file starts with copies of the old session's records
        first = first or ts
        last = max(last, ts) if last and ts else last or ts
        m = r.get("message")
        if r.get("type") not in ("user", "assistant") or not isinstance(m, dict):
            continue
        bl = blocks_of(m.get("content"))
        text = u("\n".join(b["text"] for b in bl if b.get("type") == "text" and isinstance(b.get("text"), str)))
        if r["type"] == "user" and not r.get("isMeta") and any(b.get("type") == "text" for b in bl):
            turn += 1
            turns.append([sid + ":%d" % turn, turn, ts, ts, None, None])
        if turns and ts:
            turns[-1][3] = max(turns[-1][3] or ts, ts)
        rm = m.get("model") if r["type"] == "assistant" and isinstance(m.get("model"), str) and m.get("model") else None
        if real(rm):
            model = model or rm
            if turns:
                turns[-1][4] = turns[-1][4] or rm
                turns[-1][5] = rm
        mid = r.get("uuid") or "%s#%d" % (sid, seq)
        stop = m.get("stop_reason")
        cur = db.execute("INSERT OR IGNORE INTO messages(message_id, turn_id, session_id, seq, role, ts, text, parent_id, response_finish_reasons, response_model) VALUES (?,?,?,?,?,?,?,?,?,?)", (mid, turns[-1][0] if turns else None, sid, seq, m.get("role") or r["type"], ts,
                         text, r.get("parentUuid"), json.dumps([stop]) if isinstance(stop, str) else None, rm))
        fts_row(db, "message", cur, text)
        if r["type"] == "assistant" and isinstance(m.get("usage"), dict):
            api = m["id"] if isinstance(m.get("id"), str) else mid
            first_parent.setdefault(api, r.get("parentUuid"))
            uses[api] = (mid, turns[-1][0] if turns else None, real(rm), m["usage"], ms_between(tsof.get(first_parent[api]), ts) if ts and tsof.get(first_parent[api]) else None, m["id"] if isinstance(m.get("id"), str) else None)
        for b in bl:
            if b.get("type") == "tool_use" and isinstance(b.get("id"), str):
                args = u(json.dumps(b.get("input"), ensure_ascii=False, sort_keys=True, separators=(",", ":")))
                cur = db.execute("INSERT OR IGNORE INTO tool_calls VALUES (?,?,?,?,?,NULL,NULL,NULL,?,NULL)", (b["id"], mid, sid, b.get("name"), args, ts))
                calls[b["id"]] = cur.lastrowid if cur.rowcount == 1 else None
                fts_row(db, "tool_call", cur, args)
            elif b.get("type") == "tool_result" and calls.get(b.get("tool_use_id")):
                t = u(block_text(b.get("content")))
                db.execute("UPDATE tool_calls SET result_excerpt=?, result_sha256=?, is_error=?, ended_at=? WHERE rowid=?",
                           (t[:EXCERPT], sha(t.encode("utf-8")), 1 if b.get("is_error") else 0, ts, calls[b["tool_use_id"]]))
    db.executemany("INSERT INTO turns VALUES (?,?,?,?,?,NULL,0,?,?)", [(t[0], sid, t[1], t[2], t[3], t[4], t[5]) for t in turns])
    for mid_, turn_, resp_, us, lat, api_ in uses.values():
        put_usage(db, sid, "claude_code", mid_, turn_, resp_, us.get("input_tokens"), us.get("output_tokens"), us.get("cache_read_input_tokens"), us.get("cache_creation_input_tokens"), None, lat, api_)
    node, conf = place("claude_code", conv or sid, cwd_)
    db.execute("INSERT INTO sessions VALUES (?,?,?,?,?,?,?,?,?,?,?)", (sid, "claude_code", conv or sid, node, conf, cwd_, model, first, last, "claude", ADAPTER))


def pi_path(rows):
    """(ids on the active branch, or None when the branch cannot be told): the chain of `parentId` from the last entry that has an id back to the root. pi appends every entry to the leaf,
    so the last entry is where the person is; entries off that chain belong to branches they went back from. None (everything counts) when the chain ends at a missing parent or ids are absent."""
    byid = {r["id"]: r for _, r in rows if isinstance(r, dict) and isinstance(r.get("id"), str) and r.get("type") != "session"}
    if not byid:
        return None
    path, cur = set(), next(r["id"] for _, r in reversed(rows) if isinstance(r, dict) and r.get("id") in byid)
    while cur in byid and cur not in path:
        path.add(cur)
        cur = byid[cur].get("parentId")
    return path if cur is None else None


def pi_edit_text(rep):
    """What a `context_edit` replacement says: null (the entry is left out of the model's context) is empty text; {content: string | blocks} its text."""
    c = rep.get("content") if isinstance(rep, dict) else None
    return u(c if isinstance(c, str) else block_text(c)) if rep is not None else ""


def derive_pi(db, sid, rows, place):
    """pi session file: a `session` header, then entries linked by id and parentId. The active branch (see pi_path) is the conversation: a turn starts at each user message with text on it, and only it
    sets the models. Messages on abandoned branches are rows with active 0 and no turn. A `context_edit` on the active branch replaces the text of its target message (null: empty); the original stays in canonical.
    role user, assistant (text, thinking, toolCall blocks), toolResult or system; `custom`, `custom_message`, `compaction` and other entries are kept in canonical only."""
    conv = cwd_ = model = first = last = cur = None  # model: the session's first; cur: the model in effect now
    turns, calls = [], {}
    path = pi_path(rows)
    live = lambda r: path is None or not isinstance(r.get("id"), str) or r["id"] in path
    edits = {r["targetId"]: r.get("replacement") for _, r in rows if isinstance(r, dict) and r.get("type") == "context_edit" and isinstance(r.get("targetId"), str) and live(r)}
    for seq, r in rows:
        if not isinstance(r, dict):
            continue
        ts = r.get("timestamp") if isinstance(r.get("timestamp"), str) else None
        first = first or ts
        last = max(last, ts) if last and ts else last or ts
        if r.get("type") == "session":
            conv, cwd_ = conv or r.get("id"), cwd_ or r.get("cwd")
            continue
        act = live(r)
        if r.get("type") == "model_change" and act:
            cur = r.get("modelId") if isinstance(r.get("modelId"), str) else cur
            model = model or cur
        m = r.get("message")
        if r.get("type") != "message" or not isinstance(m, dict):
            continue
        role = m.get("role")
        bl = blocks_of(m.get("content"))
        text = u("\n".join(b["text"] for b in bl if b.get("type") == "text" and isinstance(b.get("text"), str)))
        if act and r.get("id") in edits:
            text = pi_edit_text(edits[r["id"]])
        if act and role == "user" and any(b.get("type") == "text" for b in bl):
            turns.append([sid + ":%d" % len(turns), len(turns), ts, ts, cur, None])
        if act and turns and ts:
            turns[-1][3] = max(turns[-1][3] or ts, ts)
        resp = m["model"] if role == "assistant" and isinstance(m.get("model"), str) else None
        if resp and act:
            cur, model = resp, model or resp
            if turns:
                turns[-1][4], turns[-1][5] = turns[-1][4] or resp, resp
        mid = r.get("id") or "%s#%d" % (sid, seq)
        stop = m.get("stopReason")
        c = db.execute("INSERT OR IGNORE INTO messages(message_id, turn_id, session_id, seq, role, ts, text, parent_id, response_finish_reasons, response_model, active) VALUES (?,?,?,?,?,?,?,?,?,?,?)", (mid, turns[-1][0] if turns and act else None, sid, seq, role, ts, text, r.get("parentId"),
                       json.dumps([stop]) if isinstance(stop, str) else None, resp, 1 if act else 0))
        fts_row(db, "message", c, text)
        if role == "assistant" and isinstance(m.get("usage"), dict):
            us = m["usage"]
            put_usage(db, sid, "pi", mid, turns[-1][0] if turns and act else None, resp, us.get("input"), us.get("output"), us.get("cacheRead"), us.get("cacheWrite"),
                      us["cost"].get("total") if isinstance(us.get("cost"), dict) else None, m.get("durationMs") if isinstance(m.get("durationMs"), int) else None)
        for b in bl:
            if role == "assistant" and b.get("type") == "toolCall" and isinstance(b.get("id"), str):
                args = u(json.dumps(b.get("arguments"), ensure_ascii=False, sort_keys=True, separators=(",", ":")))
                c = db.execute("INSERT OR IGNORE INTO tool_calls VALUES (?,?,?,?,?,NULL,NULL,NULL,?,NULL)", (b["id"], mid, sid, b.get("name"), args, ts))
                calls[b["id"]] = c.lastrowid if c.rowcount == 1 else None
                fts_row(db, "tool_call", c, args)
        if role == "toolResult" and calls.get(m.get("toolCallId")):
            t = u(block_text(m.get("content")))
            db.execute("UPDATE tool_calls SET result_excerpt=?, result_sha256=?, is_error=?, ended_at=? WHERE rowid=?",
                       (t[:EXCERPT], sha(t.encode("utf-8")), 1 if m.get("isError") else 0, ts, calls[m["toolCallId"]]))
    db.executemany("INSERT INTO turns(turn_id, session_id, seq, started_at, ended_at, outcome, paseo_turn, request_model, response_model) VALUES (?,?,?,?,?,NULL,0,?,?)", [(t[0], sid, t[1], t[2], t[3]) + tuple(t[4:6]) for t in turns])
    node, conf = place("pi", conv or sid, cwd_)
    db.execute("INSERT INTO sessions VALUES (?,?,?,?,?,?,?,?,?,?,?)", (sid, "pi", conv or sid, node, conf, cwd_, model, first, last, "pi", ADAPTER))


def derive_opencode(db, sid, rows, place):
    """opencode canonical file: rows {table, id, session_id, time_created, time_updated, data} for session, message and part; the last row per (table, id) wins.
    A turn starts at each user message. A message's text is its text parts; a `tool` part is a tool call (status error: the error text is the result)."""
    cur_ = {"session": {}, "message": {}, "part": {}}
    for _, r in rows:
        if isinstance(r, dict) and r.get("table") in cur_:
            if r.get("deleted") is True:  # a tombstone: opencode deleted the row (revert, deleted session)
                cur_[r["table"]].pop(r.get("id"), None)
            elif isinstance(r.get("data"), dict):
                cur_[r["table"]][r.get("id")] = r
    ss = next(iter(cur_["session"].values()), None)
    if ss is None:
        return
    srt = lambda d: sorted(d.values(), key=lambda r: (r.get("time_created") or 0, str(r.get("id"))))
    parts = {}
    for r in srt(cur_["part"]):
        parts.setdefault(r.get("message_id"), []).append(r)
    iso = lambda ms: iso_ms(ms) if isinstance(ms, (int, float)) else None
    model, last, turns, seq = None, ss.get("time_updated"), [], 0  # model: the session's first (a user message's, else an assistant's)
    for r in srt(cur_["message"]):
        d, mid = r["data"], r["id"]
        t0 = (d.get("time") or {}).get("created") if isinstance(d.get("time"), dict) else None
        ts = iso(t0 if isinstance(t0, (int, float)) else r.get("time_created"))
        last = max(last or 0, r.get("time_updated") or 0)
        role = d.get("role")
        um = d.get("model") if isinstance(d.get("model"), dict) and isinstance(d["model"].get("modelID"), str) else None
        if role == "user":
            model = model or (um and um["modelID"])
            turns.append([sid + ":%d" % len(turns), len(turns), ts, ts, um and um["modelID"], None])
        if turns and ts:
            turns[-1][3] = max(turns[-1][3] or ts, ts)
        resp = d["modelID"] if role == "assistant" and isinstance(d.get("modelID"), str) else None
        if resp:
            model = model or resp
            if turns:
                turns[-1][4], turns[-1][5] = turns[-1][4] or resp, resp
        ps = parts.get(mid, [])
        text = u("\n".join(p["data"]["text"] for p in ps if p["data"].get("type") == "text" and isinstance(p["data"].get("text"), str)))
        fin = d.get("finish")
        c = db.execute("INSERT OR IGNORE INTO messages(message_id, turn_id, session_id, seq, role, ts, text, parent_id, response_finish_reasons, response_model) VALUES (?,?,?,?,?,?,?,?,?,?)", (mid, turns[-1][0] if turns else None, sid, seq, role, ts, text, d.get("parentID"),
                       json.dumps([fin]) if isinstance(fin, str) else None, resp))
        seq += 1
        fts_row(db, "message", c, text)
        if role == "assistant" and isinstance(d.get("tokens"), dict):
            tk, tm_ = d["tokens"], d.get("time") if isinstance(d.get("time"), dict) else {}
            ca = tk.get("cache") if isinstance(tk.get("cache"), dict) else {}
            put_usage(db, sid, "opencode", mid, turns[-1][0] if turns else None, resp, tk.get("input"), tk.get("output"), ca.get("read"), ca.get("write"), d.get("cost"),
                      int(tm_["completed"] - tm_["created"]) if all(isinstance(tm_.get(x), (int, float)) and not isinstance(tm_.get(x), bool) and math.isfinite(tm_[x]) for x in ("completed", "created")) else None)
        for p in ps:
            pd = p["data"]
            if pd.get("type") != "tool":
                continue
            st = pd.get("state") if isinstance(pd.get("state"), dict) else {}
            tm = st.get("time") if isinstance(st.get("time"), dict) else {}
            args = u(json.dumps(st.get("input"), ensure_ascii=False, sort_keys=True, separators=(",", ":")))
            res = st.get("error") if st.get("status") == "error" else st.get("output")
            res = u(res) if isinstance(res, str) else None
            c = db.execute("INSERT OR IGNORE INTO tool_calls VALUES (?,?,?,?,?,?,?,?,?,?)", (pd.get("callID") or p["id"], mid, sid, pd.get("tool"), args,
                           res[:EXCERPT] if res is not None else None, sha(res.encode("utf-8")) if res is not None else None,
                           {"completed": 0, "error": 1}.get(st.get("status")), iso(tm.get("start")), iso(tm.get("end")) if res is not None else None))
            fts_row(db, "tool_call", c, args)
    db.executemany("INSERT INTO turns(turn_id, session_id, seq, started_at, ended_at, outcome, paseo_turn, request_model, response_model) VALUES (?,?,?,?,?,NULL,0,?,?)", [(t[0], sid, t[1], t[2], t[3]) + tuple(t[4:6]) for t in turns])
    conv = ss["data"].get("id") or sid
    node, conf = place("opencode", conv, ss["data"].get("directory"))
    db.execute("INSERT INTO sessions VALUES (?,?,?,?,?,?,?,?,?,?,?)", (sid, "opencode", conv, node, conf, ss["data"].get("directory"), model, iso(ss.get("time_created")), iso(last), "opencode", ADAPTER))


def paseo_view(db):
    """({agent id: agent record}, [turn/permission events]) from the canonical paseo rows already in db."""
    agents, events = {}, []
    for (raw,) in db.execute("SELECT raw FROM canonical WHERE src='paseo' ORDER BY file, seq"):
        a = json.loads(raw)
        if isinstance(a, dict) and a.get("event"):
            events.append(a)
        elif isinstance(a, dict) and isinstance(a.get("id"), str):
            agents[a["id"]] = a
    return agents, events


def paseo_join(agents):
    """{(provider, provider session id): "paseo:agent/<id>"}; None when two agents share a session (no join)."""
    pj = {}
    for a in agents.values():
        if isinstance(a.get("sessionId"), str):
            k = ({"claude": "claude_code"}.get(a.get("provider"), a.get("provider")), a["sessionId"])
            pj[k] = "paseo:agent/" + a["id"] if k not in pj else None
    return pj


def paseo_model(m):
    """A Paseo model as the transcripts name it: bare (`testprov/x` is `x`); `<provider>:default` names no model and is not filled."""
    if not isinstance(m, str) or not m or m.endswith(":default"):
        return None
    return m.split("/", 1)[1] if "/" in m and m.split("/", 1)[1] else m


def apply_paseo(db, agents, events):
    """Paseo's own record of what happened, laid over the sessions the transcripts gave. Idempotent: it first undoes its earlier pass, so it can run after any change.
    A `turn` event marks the first not yet claimed session turn that began within 5 s before its start and before the next event's start (no offset: the provider writes the user message after Paseo starts the turn): `outcome`, `paseo_turn` 1,
    and `request_model` when the transcript gave none (paseo_fill remembers which). A `permission` event is a row; `permission_resolved` with the same agent and request id fills decision and decider."""
    db.execute("UPDATE turns SET request_model=NULL WHERE turn_id IN (SELECT turn_id FROM paseo_fill)")
    db.execute("UPDATE turns SET outcome=NULL, paseo_turn=0 WHERE paseo_turn=1")
    db.execute("DELETE FROM paseo_fill")
    db.execute("DELETE FROM permissions")
    sess = {}
    for aid, a in sorted(agents.items()):
        if isinstance(a.get("sessionId"), str):
            r = db.execute("SELECT session_id, node_id FROM sessions WHERE provider_name=? AND conversation_id=? ORDER BY session_id LIMIT 1",
                           ({"claude": "claude_code"}.get(a.get("provider"), a.get("provider")), a["sessionId"])).fetchone()
            if r:
                sess[aid] = r
    evs = lambda kind: [e for e in events if e.get("event") == kind]
    by = {}
    for e in evs("turn"):
        by.setdefault(e["agentId"], []).append(e)
    for aid, es in sorted(by.items()):
        if aid not in sess:
            continue
        es.sort(key=lambda e: (epoch(e.get("startedAt") or e.get("ts") or ""), e["eid"]))
        free = [(t, epoch(st or "")) for t, st in db.execute("SELECT turn_id, started_at FROM turns WHERE session_id=? ORDER BY seq", (sess[aid][0],))]
        for i, e in enumerate(es):
            model = paseo_model(e.get("model"))
            lo = epoch(e.get("startedAt") or "") - 5
            hi = epoch(es[i + 1].get("startedAt") or "") if i + 1 < len(es) else float("inf")
            hit = next(((t, x) for t, x in free if lo <= x < hi), None)
            if hit:
                free.remove(hit)
                if model and db.execute("SELECT request_model IS NULL FROM turns WHERE turn_id=?", (hit[0],)).fetchone()[0]:
                    db.execute("INSERT OR IGNORE INTO paseo_fill VALUES (?)", (hit[0],))
                db.execute("UPDATE turns SET outcome=?, paseo_turn=1, request_model=COALESCE(request_model, ?) WHERE turn_id=?", (e.get("outcome"), model, hit[0]))
    res = {(e["agentId"], e.get("requestId")): e for e in evs("permission_resolved")}
    for e in sorted(evs("permission"), key=lambda e: (e.get("ts") or "", e["eid"])):
        r = res.get((e["agentId"], e.get("requestId")))
        s_ = sess.get(e["agentId"])
        db.execute("INSERT OR IGNORE INTO permissions(request_id, session_id, agent_id, node_id, tool_name, target, decision, decided_by, ts, decided_at) VALUES (?,?,?,?,?,?,?,?,?,?)",
                   (e.get("requestId"), s_ and s_[0], e["agentId"], s_ and s_[1], e.get("tool"), e.get("target"),
                    (r or {}).get("decision") or "unanswered", (r or {}).get("decidedBy"), e.get("ts"), (r or {}).get("ts")))


def derive_nodes(db, root):
    """nodes, projects, records and effects from the node logs of the whole tree; returns {realpath: node_id} for the session join (unique paths only)."""
    seen, join, rids = set(), {}, set()
    top = os.path.realpath(tree_top(root)) if root else None
    paths = [os.path.realpath(p) for p in node_paths(root)]
    ids = {}
    for p in paths:
        key = node_info(p)["key"]
        i = key if key and key not in seen else "path:" + os.path.relpath(p, top)
        seen.add(i)
        ids[p] = i
    pid = {}
    db.execute("INSERT INTO projects(project_id, name) VALUES ('unassigned', 'unassigned')")
    for p in paths:
        info, D = node_info(p), load_at(p)
        par = parent(p)
        par = ids.get(os.path.realpath(par)) if par and p != top else None
        proj = pid.get(par, "unassigned") if par else "unassigned"
        i = ids[p]
        if info["kind"] == "project":
            proj = i
            db.execute("INSERT INTO projects VALUES (?,?,?,?,NULL,'project',?,?,NULL)", (i, i, info["name"], info["key"], D["rows"][0]["ts"] if D["rows"] else None, D["rows"][-1]["ts"] if D["rows"] else None))
        pid[i] = proj
        db.execute("INSERT INTO nodes VALUES (?,?,?,?,?,?,?,?)", (i, info["kind"], info["name"], os.path.relpath(p, top), par, proj, D["status"], (D["task"] or {}).get("goal")))
        join[p] = i
        for n, r in enumerate(D["rows"]):
            rid = r.get("id") if r["type"] != "effect" else None
            rid = rid if rid and rid not in rids else "%s#%d" % (i, n)
            rids.add(rid)
            origin = r["by"] if r.get("by") in ("person", "plugin") else "agent"
            fj = json.dumps(r, sort_keys=True)
            cur = db.execute("INSERT INTO records(record_id, node_id, type, ts, by, fields, origin, model) VALUES (?,?,?,?,?,?,?,?)", (rid, i, r["type"], r["ts"], r.get("by"), fj, origin, r.get("model") or "unknown:legacy"))
            fts_add(db, "record", cur.lastrowid, record_text(fj))
        for e in D["eff"].values():
            hist = e["hist"]
            begun = next((h for h in hist if h["step"] in ("begun", "claimed")), None)
            sent = next((h for h in reversed(hist) if h["step"] == "sent" and h.get("ref")), None)
            db.execute("INSERT OR IGNORE INTO effects VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)", (e["id"], i, e["target"], e["key"], e["state"], e["attempt"], e.get("origin") or "declared", e.get("rule"),
                       begun and begun.get("by"), begun and begun["ts"], sent and sent["ref"], e.get("tool_call_id"), e.get("of") if isinstance(e.get("of"), str) else None,
                       e["seen"] if e.get("seen") in ("before", "after") else None))
    return {p: i for p, i in join.items() if list(join.values()).count(i) == 1}, set(join.values())


def derive_ccusage(db, sid, rows, place):
    """One ccusage session (the last row of the file wins): a usage row per model, grain `session_model`, cost_source `ccusage`. session_id is filled in after all files are read (match_usage)."""
    raw = next((r for _, r in reversed(rows) if isinstance(r, dict) and isinstance(r.get("modelBreakdowns"), list)), None)
    if raw is None:
        return
    prov = {"claude": "claude_code"}.get(raw.get("agent"), raw.get("agent"))
    n = sqlint
    for b in raw["modelBreakdowns"]:
        db.execute("INSERT OR REPLACE INTO usage VALUES (?,'session_model',NULL,?,?,NULL,NULL,NULL,?,?,?,?,?,?,'ccusage',NULL,NULL,?)", ("c:%s:%s" % (sid, b["modelName"]), raw.get("period"), prov, b["modelName"], n(b.get("inputTokens")), n(b.get("outputTokens")),
                   n(b.get("cacheReadTokens")), n(b.get("cacheCreationTokens")), b["cost"] if isinstance(b.get("cost"), (int, float)) and not isinstance(b.get("cost"), bool) and math.isfinite(b["cost"]) else None, raw.get("lastActivity")))


def match_usage(db):
    """Join ccusage rows to the sessions ingested here (the provider's session id, conversation_id), and give message rows their turn's request model."""
    db.execute("UPDATE usage SET session_id=(SELECT s.session_id FROM sessions s WHERE s.conversation_id=usage.conversation_id AND s.provider_name=usage.provider_name ORDER BY s.session_id LIMIT 1) WHERE grain='session_model'")
    db.execute("UPDATE usage SET conversation_id=(SELECT s.conversation_id FROM sessions s WHERE s.session_id=usage.session_id) WHERE grain='message'")
    db.execute("UPDATE usage SET request_model=(SELECT t.request_model FROM turns t WHERE t.turn_id=usage.turn_id) WHERE grain='message'")


DERIVE = {"claude": derive_claude, "pi": derive_pi, "opencode": derive_opencode, "ccusage": derive_ccusage}


def join_records(db):
    """records.session_id and turn_id: a record joins the session its `session` (AWT_SESSION) or `by` names, by session id or conversation id; it joins the turn that was open at its `ts`, only inside the session's span. Otherwise both stay null."""
    sess = {}
    for sid, conv, a, b in db.execute("SELECT session_id, conversation_id, started_at, ended_at FROM sessions ORDER BY session_id"):
        sess.setdefault(conv, (sid, a, b))
        sess[sid] = (sid, a, b)
    turns = {}
    for sid, tid, a in db.execute("SELECT session_id, turn_id, started_at FROM turns ORDER BY session_id, seq"):
        turns.setdefault(sid, []).append((a or "", tid))
    ups = []
    db.execute("UPDATE records SET session_id=NULL, turn_id=NULL WHERE session_id IS NOT NULL OR turn_id IS NOT NULL")
    for rid, ts, by, fields in db.execute("SELECT record_id, ts, by, fields FROM records ORDER BY rowid").fetchall():
        try:
            key = json.loads(fields).get("session") or by
        except ValueError:
            continue
        hit = sess.get(key)
        if not hit:
            continue
        tid = None
        if hit[1] and hit[2] and hit[1] <= ts <= hit[2]:
            tid = next((t for a, t in reversed(turns.get(hit[0], [])) if a <= ts), None)
        ups.append((hit[0], tid, rid))
    db.executemany("UPDATE records SET session_id=?, turn_id=? WHERE record_id=?", ups)


def read_upto(path, size):
    """The first size bytes of a canonical file as lines, one at a time (it only grows; bytes past size belong to the next build)."""
    left = size
    with open(path, "rb") as g:
        for ln in g:
            if left <= 0:
                return
            yield ln[:left]
            left -= len(ln)


def file_rows(path, size):
    """The parsed canonical rows (src, session, seq, raw) of one file; a line that does not parse is skipped."""
    for ln in read_upto(path, size):
        try:
            r = json.loads(ln)
            yield r["src"], r["session"], int(r["seq"]), r["raw"]
        except (ValueError, KeyError, TypeError):
            pass


def drop_file(db, rel):
    """Remove everything derived from one canonical file (its session id is the file's name)."""
    sid = os.path.splitext(os.path.basename(rel))[0]
    fts_drop(db, db.execute("SELECT r.id, substr(m.text, 1, ?) FROM messages m JOIN fts_ref r ON r.kind='message' AND r.ref=m.rowid WHERE m.session_id=? AND m.text != ''", (FTS_CAP, sid)).fetchall())
    fts_drop(db, db.execute("SELECT r.id, substr(t.args, 1, ?) FROM tool_calls t JOIN fts_ref r ON r.kind='tool_call' AND r.ref=t.rowid WHERE t.session_id=? AND t.args != ''", (FTS_CAP, sid)).fetchall())
    db.execute("DELETE FROM paseo_fill WHERE turn_id IN (SELECT turn_id FROM turns WHERE session_id=?)", (sid,))
    for t in ("messages", "tool_calls", "turns", "sessions"):
        db.execute("DELETE FROM %s WHERE session_id=?" % t, (sid,))
    db.execute("DELETE FROM usage WHERE (grain='message' AND session_id=?) OR (grain='session_model' AND substr(usage_id, 1, ?)=?)", (sid, len(sid) + 3, "c:%s:" % sid))
    db.execute("DELETE FROM canonical WHERE file=?", (rel,))


def drop_nodes(db):
    fts_drop(db, [(i, record_text(f)) for i, f in db.execute("SELECT r.id, x.fields FROM records x JOIN fts_ref r ON r.kind='record' AND r.ref=x.rowid").fetchall()])
    for t in ("records", "effects", "nodes", "projects"):
        db.execute("DELETE FROM " + t)


def sync_into(db, store, root, inputs, fresh):
    """Bring db in line with inputs (taken before anything was read). Canonical-derived tables are re-derived per changed file; records, nodes, projects and effects
    (the small node-log tables) when any node log changed. fresh: db is empty, so everything is new."""
    keys = input_keys(store, root, inputs)
    top = top_of(root)
    prev = {} if fresh else {(k, p): (n, e) for k, p, n, e in db.execute("SELECT kind, path, size, errors FROM build_state")}
    path_of = {(k, os.path.relpath(p, store if k == "canonical" else top)): p for k, p, _ in inputs}
    nodes_changed = fresh or any(prev.get(k, (None,))[0] != n for k, n in keys.items() if k[0] == "node") or any(k[0] == "node" and k not in keys for k in prev)
    changed = [k for k, n in keys.items() if k[0] == "canonical" and prev.get(k, (None,))[0] != n]
    for k in sorted(prev):
        if k[0] == "canonical" and (k not in keys or k in changed):
            drop_file(db, k[1])
    if nodes_changed:
        drop_nodes(db)
        join, node_ids = derive_nodes(db, root)
    else:
        join = {os.path.join(top, p) if p != "." else top: i for i, p in db.execute("SELECT node_id, path FROM nodes")}
        node_ids = {i for i, in db.execute("SELECT node_id FROM nodes")}
    if os.environ.get("AWT_TEST_BUILD_SLEEP"):
        time.sleep(float(os.environ["AWT_TEST_BUILD_SLEEP"]))  # test hook: a build that takes a while
    errors = {k: prev[k][1] for k in keys if k in prev and k not in changed and k[0] == "canonical"}
    first_src = {}  # file -> src of its first row; the rows themselves are not kept (one file's rows are in memory at a time)
    for k in sorted(changed):
        errors[k] = 0
        for batch in itertools.zip_longest(*[file_rows(path_of[k], keys[k])] * 2000):
            rows = [r for r in batch if r is not None]
            first_src.setdefault(k, rows[0][0])
            db.executemany("INSERT OR IGNORE INTO canonical VALUES (?,?,?,?,?)", [(a, b, c, k[1], json.dumps(d, separators=(",", ":"))) for a, b, c, d in rows])
            errors[k] += sum(1 for r in rows if isinstance(r[3], dict) and "_unparsed" in r[3])
    gone = any(k[0] == "canonical" and k not in keys for k in prev)
    paseo = lambda k: first_src.get(k) == "paseo"
    paseo_changed = any(paseo(k) for k in first_src) or any(k[0] == "canonical" and k not in keys and k[1].split(os.sep)[:2] == ["log", "paseo"] for k in prev)
    agents, events = paseo_view(db)
    pj = paseo_join(agents)

    def place(provider, conv, cwd):
        """(node id, join_confidence): the provider session id Paseo recorded for an agent whose node exists, else the cwd of exactly one node, else nothing."""
        n = pj.get((provider, conv))
        if n in node_ids:
            return n, "session_id"
        n = join.get(cwd) if cwd else None
        return (n, "cwd") if n else (None, None)
    for k in sorted(first_src):
        if first_src[k] in DERIVE:
            sid = os.path.splitext(os.path.basename(k[1]))[0]
            db.execute("SAVEPOINT derive")
            try:
                if os.environ.get("AWT_TEST_DERIVE_RAISE") == sid:
                    raise ValueError("test hook")  # test hook: a file whose derivation fails
                DERIVE[first_src[k]](db, sid, [(r[2], r[3]) for r in file_rows(path_of[k], keys[k])], place)
                if os.environ.get("AWT_TEST_DERIVE_RAISE_AFTER") == sid:
                    raise ValueError("test hook")  # test hook: a derivation that fails after it wrote its rows
                db.execute("RELEASE derive")
            except Exception:  # one file that cannot be derived (a value SQLite refuses, an odd record) is a counted error and leaves its derived rows out; it never stops the build
                db.execute("ROLLBACK TO derive")
                db.execute("RELEASE derive")
                errors[k] += 1
    if not fresh and (nodes_changed or paseo_changed):  # placement depends on the node logs and on Paseo's agent records, not only on the file
        db.executemany("UPDATE sessions SET node_id=?, join_confidence=? WHERE session_id=?",
                       [place(prov, conv, cwd_) + (sid,) for sid, prov, conv, cwd_ in db.execute("SELECT session_id, provider_name, conversation_id, cwd FROM sessions").fetchall()])
    if fresh or paseo_changed or changed or gone:
        apply_paseo(db, agents, events)
    if nodes_changed or changed or any(k[0] == "canonical" and k not in keys for k in prev):
        join_records(db)
    if fresh or changed or gone:
        match_usage(db)
    db.execute("DELETE FROM ingest_sources")
    for src, _, _ in SOURCES:
        try:
            with open(os.path.join(store, "ingest", src + ".offsets.json"), encoding="utf-8") as g:
                st = json.load(g)
            for rp, e in sorted(st["files"].items()):
                who = os.path.splitext(os.path.basename(e.get("out") or ""))[0]
                db.execute("INSERT INTO ingest_sources VALUES (?,?,?,?,?,?,?)", (src, rp, e.get("inode"), e.get("offset"), st.get("adapter"), st.get("last_run"),
                           sum(v or 0 for k, v in errors.items() if os.path.splitext(os.path.basename(k[1]))[0] == who)))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            pass
    db.execute("DELETE FROM build_state")
    db.executemany("INSERT INTO build_state VALUES (?,?,?,?)", [(k, p, n, errors.get((k, p), 0)) for (k, p), n in sorted(keys.items())])
    db.executemany("INSERT OR REPLACE INTO schema_meta VALUES (?,?)", [("schema_version", str(SCHEMA_VERSION)), ("semconv_version", SEMCONV), ("adapter", str(ADAPTER)),
                                                                          ("tree", top), ("inputs", fingerprint(store, root, inputs))])


def build_store(store, root, inputs):
    """Rebuild store.db from canonical JSONL and the node logs. Same inputs give the same file: rows are inserted in sorted path and line order, nothing in it is a clock or an id generated at build time."""
    final = os.path.join(store, "store.db")
    tmp = "%s.%d.tmp" % (final, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.close(fd)
    db = sqlite3.connect(tmp, isolation_level=None)
    try:
        db.executescript("PRAGMA page_size=4096; PRAGMA journal_mode=MEMORY; PRAGMA synchronous=OFF; BEGIN;" + DDL)
        sync_into(db, store, root, inputs, True)
        for q in INDEXES.split(";"):
            if q.strip():
                db.execute(q)
        db.execute("COMMIT")
        return counts(db)
    except BaseException:
        db.close()
        os.unlink(tmp)
        raise
    finally:
        try:
            db.close()
        except sqlite3.Error:
            pass
        if os.path.exists(tmp):
            os.chmod(tmp, 0o600)
            os.rename(tmp, final)


def counts(db):
    return {t: db.execute("SELECT count(*) FROM " + t).fetchone()[0] for t in ("sessions", "messages", "records")}


def busy_s(default):
    """Seconds to wait for a locked store.db (AWT_TEST_BUSY_S shortens it in tests)."""
    return float(os.environ.get("AWT_TEST_BUSY_S") or default)


def store_meta(store):
    """schema_meta of store.db as a dict; None when there is no store.db, {} when it cannot be read (not SQLite, no schema_meta)."""
    path = os.path.join(store, "store.db")
    if not os.path.isfile(path):
        return None
    try:
        db = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(path), uri=True, timeout=busy_s(5))
        try:
            return dict(db.execute("SELECT key, value FROM schema_meta"))
        finally:
            db.close()
    except sqlite3.Error as x:
        return {"busy": "1"} if "locked" in str(x) else {}  # a busy store is not an old one


NEWER_FIX = "install the newer awt"


def store_newer(meta):
    """True when store.db was written by a newer awt (a schema version above this one's): this awt never rebuilds, writes or migrates it."""
    sv = str((meta or {}).get("schema_version"))
    return sv.isdigit() and int(sv) > SCHEMA_VERSION


def store_old(meta, root=None):
    """Why an existing store.db cannot be updated in place (None when it can): another schema, adapter or tree. Only `awt ingest --rebuild` replaces such a store."""
    if meta.get("busy"):
        return None
    if not meta:
        return "store.db cannot be read"
    if meta.get("schema_version") != str(SCHEMA_VERSION):
        sv = str(meta.get("schema_version"))
        if store_newer(meta):
            return "store schema %s > %d: this awt is older than the store" % (sv, SCHEMA_VERSION)
        return "store schema %s %s %d" % (sv, "<" if sv.isdigit() and int(sv) < SCHEMA_VERSION else "!=", SCHEMA_VERSION)
    if meta.get("adapter") != str(ADAPTER):
        return "store adapter %s != %d" % (meta.get("adapter"), ADAPTER)
    if root is not None and meta.get("tree") != top_of(root):
        return "store was built for another tree"
    return None


REBUILD_FIX = "awt ingest --rebuild"


def rebuild_need(store):
    """Bytes of free disk a full build needs: the build writes a second store.db next to the old one (kept until the rename), about as big as the old one or as the canonical logs, plus a margin."""
    def size(p):
        return sum(os.path.getsize(os.path.join(dp, f)) for dp, _, fns in os.walk(p) for f in fns if os.path.isfile(os.path.join(dp, f)))
    old = os.path.getsize(os.path.join(store, "store.db")) if os.path.isfile(os.path.join(store, "store.db")) else 0
    return int(1.2 * max(old, size(os.path.join(store, "log")))) + 256 * 2**20


def free_bytes(store):
    if os.environ.get("AWT_TEST_FREE_BYTES"):
        return int(os.environ["AWT_TEST_FREE_BYTES"])  # test hook: a disk with this much free
    st = os.statvfs(store)
    return st.f_bavail * st.f_frsize


def human(n):
    for unit in ("B", "KB", "MB"):
        if n < 1024:
            return "%d %s" % (n, unit)
        n /= 1024.0
    return "%.1f GB" % n


class StoreChanged(Exception):
    """store.db changed under update_store (another schema): a skip with a warning, never a write."""


def update_store(store, root, inputs):
    """Update a store.db that sync_store found current in schema, adapter and tree, in place. Raises sqlite3.Error (a lock that does not clear, a damaged file); the caller leaves the store as it was."""
    db = sqlite3.connect(os.path.join(store, "store.db"), isolation_level=None, timeout=busy_s(30))
    try:
        db.execute("BEGIN IMMEDIATE")
        try:
            sv = dict(db.execute("SELECT key, value FROM schema_meta")).get("schema_version")  # re-read under the write lock: another awt may have rebuilt it since sync_store looked
            if sv != str(SCHEMA_VERSION):
                db.execute("ROLLBACK")
                raise StoreChanged("store schema is now %s, this awt writes %d" % (sv, SCHEMA_VERSION))
            sync_into(db, store, root, inputs, False)
            db.execute("COMMIT")
        except StoreChanged:
            raise
        except BaseException:
            db.execute("ROLLBACK")
            raise
        return counts(db)
    finally:
        db.close()


def stale_tmp(store):
    return sorted(f for f in os.listdir(store) if f.startswith("store.db.") and f.endswith(".tmp")) if os.path.isdir(store) else []


HOOK_BUILD_CAP = 64 * 2**20  # a hook or pipe may build a store that does not exist yet only when the canonical logs are this small


def warn(msg):
    print("warn: " + msg, file=sys.stderr)


def sync_store(store, root, force, quiet=False):
    """Normal ingest brings store.db up to date when it is missing or its inputs changed (their sizes: a stat per file); else it leaves it alone. Only changed files are re-derived.
    A full build (a temp file, the same code on an empty db) happens for --rebuild (force), and for a store that does not exist yet (a hook or pipe: quiet, only when the logs are small).
    A store of another schema, adapter or tree, unreadable, or locked is never rebuilt on its own: it stays as it is, and a warning names `awt ingest --rebuild` (quiet: silent; awt doctor warns).
    A full build first needs free disk (rebuild_need) and refuses with a fix line otherwise."""
    if not fts_ok():
        die("this Python's sqlite3 has no FTS5 (sqlite %s)" % (sqlite3.sqlite_version if sqlite3 else "missing"), "use a Python whose sqlite3 has FTS5 (python.org builds and Homebrew have it); awt doctor checks this")
    if force or not store_fresh(store, root):
        lock = os.open(os.path.join(store, "ingest", "store.lock"), os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(lock, fcntl.LOCK_EX)
            for f in stale_tmp(store):  # a killed build leaves its temp file; the lock is held, so none is live
                try:
                    os.unlink(os.path.join(store, f))
                except OSError:
                    pass
            meta = store_meta(store)
            if store_newer(meta):  # never rebuild, write or migrate a store from a newer awt (--rebuild included)
                if not quiet:
                    warn("%s: %s; store.db was left as it is (canonical logs are still ingested)" % (store_old(meta), NEWER_FIX))
                return None
            if not force and meta is not None and store_old(meta, root):
                if not quiet:
                    warn("%s: run `%s` once (find keeps using the old store.db; the build needs about %s of free disk)" % (store_old(meta, root), REBUILD_FIX, human(rebuild_need(store))))
                return None
            if force or not store_fresh(store, root):
                inputs = store_inputs(store, root)  # before anything is read: a write that lands mid-build leaves the fingerprint stale, never fresh
                if meta is not None and not force:
                    try:
                        return update_store(store, root, inputs)
                    except StoreChanged as x:
                        if not quiet:
                            warn("store.db was not updated (%s); run awt ingest again" % x)
                        return None
                    except sqlite3.Error as x:  # a lock that did not clear in 30 s, or a damaged file: never a reason for a full build
                        if not quiet:
                            warn("store.db was not updated (%s); run awt ingest again later%s" % (x, ", or `%s` if it stays" % REBUILD_FIX if "locked" not in str(x) else ""))
                        return None
                if not force and quiet and sum(os.path.getsize(os.path.join(dp, f)) for dp, _, fns in os.walk(os.path.join(store, "log")) for f in fns) > HOOK_BUILD_CAP:
                    return None  # a hook or pipe does nothing heavy: `awt ingest` builds it
                need, free = rebuild_need(store), free_bytes(store)
                if free < need:
                    if quiet:
                        return None
                    die("not enough free disk to build store.db: %s free, need about %s" % (human(free), human(need)),
                        "free that much space (awt ui no longer copies the store), or point AWT_STORE at a bigger volume, then: %s" % REBUILD_FIX)
                return build_store(store, root, inputs)
        finally:
            os.close(lock)


def session_hits(term, limit):
    """None when there is no usable store.db, else message and tool-call lines ranked by FTS5 bm25."""
    path = os.path.join(store_dir(), "store.db")
    if sqlite3 is None or not os.path.isfile(path):
        return None
    try:
        db = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(path), uri=True)
        try:
            res = []
            phrase = '"%s"' % term.replace('"', '""')
            for kind, ref in db.execute("SELECT r.kind, r.ref FROM fts_text JOIN fts_ref r ON r.id = fts_text.rowid WHERE fts_text MATCH ? AND r.kind IN ('message', 'tool_call') ORDER BY bm25(fts_text), fts_text.rowid LIMIT ?", (phrase, limit)):
                if kind == "message":
                    sid, mid, seq, role, text = db.execute("SELECT session_id, message_id, seq, role, text FROM messages WHERE rowid=?", (ref,)).fetchone()
                    head = "message:%s#%d [%s]" % (sid, seq, role)
                else:
                    sid, tid, name, text = db.execute("SELECT session_id, tool_call_id, tool_name, args FROM tool_calls WHERE rowid=?", (ref,)).fetchone()
                    head = "tool_call:%s:%s [%s]" % (sid, tid, name)
                i = max(text.lower().find(term.lower()), 0)
                res.append("%s: %s" % (head, text[max(0, i - 40):i + 80].replace("\n", " ")))
            return res
        finally:
            db.close()
    except sqlite3.Error:
        return None


# ---------- main ----------
class Parser(argparse.ArgumentParser):
    def error(self, message):  # usage errors keep exit 2 and gain a fix: line (I3)
        die("%s: %s" % (self.prog, message), "%s --help" % self.prog, 2)


def build():
    p = Parser(prog="awt", add_help=False)
    sp = p.add_subparsers(dest="verb")

    def V(parent, name, pos=(), opt=()):
        q = parent.add_parser(name)
        for n, kw in pos:
            q.add_argument(n, **kw)
        for fl, kw in opt:
            q.add_argument(*fl, **kw)
        return q
    T, F = {}, dict(action="store_true")
    V(sp, "init", opt=[(("--goal",), T), (("--done",), T), (("--kind",), dict(choices=KINDS)), (("--name",), T), (("--key",), T),
                         (("--hooks",), dict(choices=["claude", "opencode", "pi", "all"])), (("--uninstall",), F)])
    V(sp, "resume", opt=[(("--hook",), F), (("--framed",), F), (("--scope",), {}), (("--json",), F)])
    V(sp, "list", [("section", dict(nargs="?", choices=LISTS))], [(("--all",), F), (("--json",), F), (("--since",), T), (("--down",), F)])
    V(sp, "find", [("term", dict(nargs="?"))], [(("--up",), F), (("--down",), F), (("--tree",), F), (("--like",), T), (("--limit",), dict(type=int)), (("--sessions",), F)])
    V(sp, "state", opt=[(("--now",), dict(required=True)), (("--next",), dict(required=True)), (("--scope",), T)])
    V(sp, "note", [("text", T)])
    V(sp, "decide", [("choice", T)], [(("--why",), dict(required=True)), (("--supersedes",), T), (("--tag",), dict(action="append")), (("--related",), dict(type=int))])
    V(sp, "ask", [("text", T)], [(("--related",), dict(type=int))])
    V(sp, "answer", [("id", T), ("text", T)])
    V(sp, "ref", [("target", T)], [(("--title",), dict(required=True)), (("--why",), T), (("--kind",), T), (("--no-access",), F)])
    V(sp, "capture", [("file", dict(nargs="?"))], [(("--from",), dict(required=True, dest="from_")), (("--title",), dict(required=True)), (("--ref",), T)])
    V(sp, "status", [("value", dict(choices=ENUM["status.status"]))])
    V(sp, "doctor", opt=[(("--staged",), F)])
    V(sp, "ingest", opt=[(("--source",), dict(choices=["claude", "pi", "opencode", "paseo", "ccusage", "all"], default="claude")), (("--hook",), F), (("--rebuild",), F), (("--stdin",), F), (("--event",), F)])
    V(sp, "ui", opt=[(("--port",), dict(type=int, default=8777)), (("--print-metadata",), F)])
    V(sp, "help")
    es = V(sp, "effect").add_subparsers(dest="eop")
    V(es, "apply", [("rest", dict(nargs=argparse.REMAINDER))])  # removed; refused after parsing
    V(es, "plan", opt=[(("--target",), dict(required=True)), (("--body",), T), (("--how",), T), (("--after",), dict(action="append")), (("--again",), F), (("--why",), T)])
    V(es, "begin", [("id", T)])
    V(es, "show", [("id", T)])
    V(es, "mark", [("id", T), ("to", dict(choices=["sent", "not-sent", "unknown", "dropped"]))], [(("--ref",), T), (("--why",), T)])
    for q in list(es.choices.values()):  # removed flags: hidden, accepted, refused after parsing so option values are never mistaken for them
        for f in REMOVED_FLAGS:
            q.add_argument(f, dest="gone", nargs="?", action="append", help=argparse.SUPPRESS)
    return p


def main(argv):
    global ROOT, BY, MODEL
    BY = os.environ.get("AWT_BY") or "agent"
    flag = None
    for f in (sys.stdout, sys.stderr):
        f.reconfigure(encoding="utf-8", errors="backslashreplace")
    rest, d, i = [], None, 0
    while i < len(argv):
        x = argv[i]
        if x in ("--dir", "--by", "--model") and i + 1 < len(argv):
            if x == "--dir":
                d = argv[i + 1]
            elif x == "--by":
                BY = argv[i + 1]
            else:
                flag = argv[i + 1]
            i += 2
            continue
        if x.startswith(("--dir=", "--by=", "--model=")):
            if x.startswith("--dir="):
                d = x[6:]
            elif x.startswith("--by="):
                BY = x[5:]
            else:
                flag = x[8:]
        else:
            rest.append(x)
        i += 1
    # model: --model, then AWT_MODEL (an agent's env, so not for a person), else unknown:unset (SPEC, Model tracking)
    MODEL = (flag or "").strip() or ("" if BY == "person" else os.environ.get("AWT_MODEL", "").strip()) or "unknown:unset"
    if rest[:1] == ["--version"]:
        return out("awt " + VERSION)
    if rest[:2] == ["help", "agents"]:
        return out(AGENT_REF)
    if not rest or rest[0] in ("help", "--help", "-h"):
        return out(USAGE)
    if rest[:1] == ["supersede"]:
        die("supersede was removed: move the file yourself and note it",
            "mkdir -p docs/_superseded && mv -n docs/old.md docs/_superseded/ && test ! -e docs/old.md && awt note \"docs/new.md replaces docs/old.md: WHY\"", 2)
    if rest[:1] == ["save"]:
        die("save was removed: git does the commit, and doctor --staged does the secret check",
            "git add -A && awt doctor --staged && git commit -m MESSAGE   (put awt doctor --staged in .git/hooks/pre-commit to run it on every commit)", 2)
    a = build().parse_args(rest)
    if a.verb == "effect" and (a.eop == "apply" or getattr(a, "gone", None) is not None):
        die("effect apply, --run, --snapshot, --verify, --class and --timeout were removed: awt never runs commands",
            "send it yourself; ./awt effect plan --target T [--body FILE] [--how TEXT], ./awt effect begin ID, then ./awt effect mark ID sent", 2)
    a.dir = d
    if a.verb is None or (a.verb == "effect" and not a.eop):
        die("missing verb", USAGE.splitlines()[0], 2)
    if a.verb == "help":
        return out(USAGE)
    if a.verb == "init":
        return cmd_init(a)
    if a.verb == "resume" and a.hook:
        return cmd_resume(a)
    if a.verb == "ingest":
        return cmd_ingest(a)
    if a.verb == "ui":
        return cmd_ui(a)
    if a.verb == "doctor" and a.staged:
        return doctor_staged(a)
    ROOT = find_root(d)
    set_cmd()
    if not ROOT:
        if a.verb == "doctor":
            return cmd_doctor(a)
        die("no task found", "./awt init", 4)
    globals()[("eff_" + a.eop) if a.verb == "effect" else ("cmd_" + a.verb)](a)
    if a.verb in WRITES or (a.verb == "effect" and a.eop != "show"):
        refresh_briefs(ROOT)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
        sys.stdout.flush()
    except PermissionError as x:
        print("error: permission denied: %s" % x.filename, file=sys.stderr)
        print("fix: a person should run: %s" % shlex.join(["./awt"] + sys.argv[1:]), file=sys.stderr)
        sys.exit(3)
    except BrokenPipeError:
        sys.exit(0)
    except Exception as x:
        die("%s: %s" % (type(x).__name__, x), "run ./awt doctor; if the cause is not the path or file named above, report this line")
