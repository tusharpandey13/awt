STOPWORDS = set("""a about after all also an and any are as at be been but by can could did do does for from had has have he her his how i if in into
is it its may me might more most my no not of on one or our out she so some than that the their them then there these they this to too up
us was we were what when where which who why will with would you your""".split())


def words(text):
    """The meaning-bearing words of a text: lowercase [a-z0-9][a-z0-9_./-]+ tokens, stopwords and tokens under 3 characters dropped, no repeats."""
    seen = []
    for w in re.findall(r"[a-z0-9][a-z0-9_./-]+", text.lower()):
        w = w.strip("._/-")
        if len(w) >= 3 and w not in STOPWORDS and w not in seen:
            seen.append(w)
    return seen


def recall_rows(D, prefix, skip=None):
    """Candidate records of one node for recall: (sort ts, words, line, rule?). Current decisions, questions, notes, refs, the main state."""
    at = " @" + prefix if prefix else ""
    res = []

    def add(r, ident, text, line, rule=False):
        res.append((r["ts"], set(words(ident + " " + text)), line, rule))
    for d in D["cur_dec"]:
        if d["id"] != skip:
            tag = " [%s]" % ",".join(d["tags"]) if d.get("tags") else ""
            add(d, d["id"], d["choice"] + " " + d["why"], "%s%s%s: %s (why: %s)" % (d["id"], at, tag, d["choice"], d["why"]), "rule" in (d.get("tags") or []))
    for i, q in D["q"].items():
        if i != skip:
            ans = D["ans"].get(i)
            add(q, i, q["text"] + (" " + ans["text"] if ans else ""), "%s%s: %s%s" % (i, at, q["text"], " → " + ans["text"] if ans else ""))
    for n in D["notes"]:
        if n["id"] != skip:
            add(n, n["id"], n["text"], "%s%s: %s" % (n["id"], at, n["text"]))
    for r in D["refs"].values():
        add(r, "", r["title"] + " " + r.get("why", ""), "ref%s: %s%s <%s>" % (at, r["title"], " (why: %s)" % r["why"] if r.get("why") else "", r["target"]))
    st = D["states"].get("main")
    if st:
        add(st, "", st["now"] + " " + st["next"], "state%s: %s | next: %s" % (at, st["now"], st["next"]))
    return res


def recall(text, limit, nodes, skip=None, deadline=None, width=200):
    """(lines, stopped): the best-matching records across the --tree node set, ranked by rarity of the shared words. Unreadable nodes are skipped; show_related swallows anything else."""
    q = words(text)
    if not q:
        return [], False
    cands, stopped = [], False
    anchor = tree_top(ROOT)
    for p in nodes:
        if deadline is not None and time.time() >= deadline:
            stopped = True
            break
        try:
            cands += recall_rows(load_at(p), "" if p == ROOT else shown(p, anchor, True), skip)
        except Exception:
            continue
    if os.environ.get("AWT_TEST_RECALL_FAULT"):  # a test hook: proves a failure here cannot undo a write
        raise RuntimeError("injected recall fault")
    df = {}
    for _, ws, _, _ in cands:
        for w in ws:
            df[w] = df.get(w, 0) + 1
    need = 1 if len(q) <= 2 else 2
    scored = []
    for ts, ws, line, rule in cands:
        shared = [w for w in q if w in ws]
        if len(shared) >= need:
            scored.append((sum(math.log(1 + len(cands) / df[w]) for w in shared) * (1.5 if rule else 1), ts, line))
    scored.sort(key=lambda x: (x[0], x[1]), reverse=True)
    return [cut(" ".join(l.split()), width) for _, _, l in scored[:limit]], stopped


def find_like(a):
    if a.term is not None:
        die("--like cannot be combined with a TERM", 'awt find --like "text"', 2)
    limit = 10 if a.limit is None else a.limit
    if not 1 <= limit <= K["hits"]:
        die("--limit must be 1 to %d" % K["hits"], 'awt find --like "text" --limit 10', 2)
    narrow = (a.up or a.down) and not a.tree
    nodes, over = scope_nodes(not narrow, a.up, a.down)
    lines, _ = recall(a.like, limit, nodes)
    for l in lines or ["no related records"]:
        out(l)
    if over:
        out("+ " + LIMIT)


def find_in(root, term, prefix):
    global ROOT
    old, ROOT = ROOT, root
    try:
        return _find_here(term, prefix)
    finally:
        ROOT = old


def _find_here(term, prefix):
    hits = []

    def snip(text, i):
        return text[max(0, i - 40):i + 80].replace("\n", " ")

    for r in load()["rows"]:
        text = " ".join(str(v) if not isinstance(v, list) else " ".join(map(str, v)) for k, v in r.items() if k not in ("v", "ts", "type", "host", "by"))
        i = text.lower().find(term)
        if i >= 0:
            hits.append("event:%s%s: %s" % (r.get("id") or r["type"], " @" + prefix if prefix else "", snip(text, i)))
    me = os.path.realpath(__file__)
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = sorted(d for d in dns if d not in (".git", "scratch") and not (dp == ROOT and d == ".awt") and not os.path.islink(os.path.join(dp, d))
                        and not is_node_dir(os.path.join(dp, d)))
        for n in sorted(fns):
            p = os.path.join(dp, n)
            if os.path.islink(p) or os.path.realpath(p) == me or (dp == ROOT and n == "awt"):
                continue
            try:
                if not os.path.isfile(p) or os.path.getsize(p) > K["big"]:
                    continue
                with open(p, "rb") as g:
                    b = g.read()
            except OSError:
                continue
            if b"\0" in b:
                continue
            for ln, line in enumerate(b.decode("utf-8", "replace").splitlines(), 1):
                i = line.lower().find(term)
                if i >= 0:
                    hits.append("%s:%d: %s" % (os.path.join(prefix, rel(p)) if prefix else rel(p), ln, snip(line, i)))
    return hits


