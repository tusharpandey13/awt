def infer_kind(t):
    lt = t.lower()
    host = re.sub(r"^\w+://", "", lt).split("/")[0]
    if os.path.exists(os.path.join(os.path.expanduser(t), ".git")):
        return "repo"
    if "slack.com" in lt:
        return "slack"
    if "atlassian.net/wiki" in lt or "confluence" in lt:
        return "confluence"
    if "atlassian.net/browse" in lt or "jira" in host or re.fullmatch(r"[A-Z]+-[0-9]+", t):
        return "jira"
    if "/pull/" in lt or "/merge_requests/" in lt:
        return "pr"
    return "link" if re.match(r"^\w+://", lt) else "other"


def cmd_ref(a):
    kind = a.kind or infer_kind(a.target)
    extra = {}
    if kind == "repo":
        p = os.path.abspath(os.path.expanduser(a.target))
        try:
            br = git(p, "rev-parse", "--abbrev-ref", "HEAD").stdout.strip() or "unknown"
        except Exception:
            br = "unknown"
        extra = dict(path=p, branch=br)
    emit("ref", target=a.target, title=a.title, kind=kind, why=a.why, access="none" if a.no_access else "ok", **extra)
    out("ref %s %s" % (kind, a.target))


def cmd_capture(a):
    if a.file and a.file != "-":
        try:
            with open(a.file, "rb") as g:
                raw = g.read()
        except OSError as x:
            die("cannot read %s: %s" % (a.file, x.strerror), "give a readable FILE, or pipe the text in", 4)
    else:
        raw = sys.stdin.buffer.read()
    body, n = raw.decode("utf-8", "replace").strip(), 0
    if not body:
        die("capture body is empty", "pipe the text in or pass FILE")
    for name, rx in SECRETS:
        body, k = rx.subn("[REDACTED:%s]" % name, body)
        n += k
    h = sha(body.encode("utf-8"))
    D = load()
    for c in D["caps"]:
        if c["sha"] == h:
            return out("%s already captured (no change)" % c["path"])
    slug = re.sub(r"[^a-z0-9]+", "-", a.title.lower()).strip("-")[:50].strip("-") or "capture"
    base = time.strftime("%Y%m%d", time.gmtime()) + "-" + slug
    path, i = "context/%s.md" % base, 1
    while os.path.exists(P(path)):
        i += 1
        path = "context/%s-%d.md" % (base, i)
    check("capture", dict(path=path, **{"from": a.from_, "title": a.title, "sha": h}, **({"ref": a.ref} if a.ref else {})))
    head = "---\nsource: %s\ntitle: %s\ncaptured: %s\nref: %s\n---\n\n" % (a.from_, a.title, now(), a.ref or "")
    realdir("context")
    tmp = P("context", ".tmp-" + os.urandom(4).hex())
    create(tmp, head + body + "\n")
    os.rename(tmp, P(path))
    emit("capture", path=path, title=a.title, sha=h, ref=a.ref, **{"from": a.from_})
    out("%s captured%s" % (path, " (%d secrets redacted)" % n if n else ""))


def cmd_supersede(a):
    old, new = inside(a.old), inside(a.new)
    for p in (old, new):
        if not p.startswith(P("docs") + os.sep):
            die("%s is not under docs/" % rel(p), "only docs/ files can be superseded")
        if not os.path.isfile(p):
            die("%s does not exist" % rel(p), "check the path", 4)
    if old == new:
        die("OLD and NEW are the same file", "give two different docs")
    dst = P("docs", "_superseded", os.path.basename(old))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    realdir("docs/_superseded")
    stem, ext = os.path.splitext(dst)
    i = 1
    while os.path.lexists(dst):
        i += 1
        dst = "%s-%d%s" % (stem, i, ext)
    check("doc", dict(path=rel(old), action="supersede", by_doc=rel(new), **({"why": a.why} if a.why else {})))
    os.rename(old, dst)
    emit("doc", path=rel(old), action="supersede", by_doc=rel(new), why=a.why)
    out("%s superseded by %s (moved to %s)" % (rel(old), rel(new), rel(dst)))


def cmd_status(a):
    if a.value == "done":
        D = load()
        bl = ["question %s open" % q["id"] for q in D["open_q"]] + [
            "effect %s is %s" % (e["id"], e["state"]) for e in D["eff"].values() if e["state"] in ("planned", "claimed", "unknown", "conflict")]
        if bl:
            die("cannot mark done: " + "; ".join(bl), "answer the questions and mark or drop the effects first")
    emit("status", status=a.value)
    out("status " + a.value)


# ---------- effects ----------
def eff_plan(a):
    fcntl.flock(os.open(P(".awt", "events.jsonl"), os.O_RDONLY | os.O_CREAT, 0o644), fcntl.LOCK_EX)  # held to exit: check-then-write must not interleave
    D = load()
    if not a.body and not a.run:
        die("need --body or --run", "add --body outbox/x.md and/or --run CMD", 2)
    body = bsha = None
    if a.body:
        p = inside(a.body)
        if not os.path.isfile(p):
            die("--body must be a regular file: " + a.body, "write the draft into outbox/ first")
        body = rel(p)
        with open(p, "rb") as g:
            bsha = sha(g.read())
    if a.cls == "overwrite" and not a.snapshot:
        die("overwrite effects need --snapshot", "add --snapshot 'CMD that prints the current content'")
    for x in a.after or []:
        get_eff(D, x)
    nonce = os.urandom(8).hex() if a.again else ""
    key = sha(json.dumps([a.target, a.run or "", bsha or "", a.cls, nonce]).encode())
    for e in D["eff"].values():
        if e["key"] == key:
            if e["state"] == "dropped":
                die("%s was dropped" % e["id"], "plan it again with --again")
            return out("%s %s (already planned, nothing written)" % (e["id"], e["state"]))
    if not a.again:
        for e in D["eff"].values():
            if e["target"] == a.target and e["state"] in ("unknown", "conflict"):
                die("%s on %s is %s; it may already have been sent" % (e["id"], a.target, e["state"]),
                    "check with a person, ./awt effect mark %s sent|not-sent, or plan with --again" % e["id"])
    i = new_id("e")
    emit("effect", id=i, step="planned", attempt=1, target=a.target, key=key, body=body, body_sha=bsha, run=a.run,
         **{"class": a.cls}, snapshot=a.snapshot, verify=a.verify, after=a.after, why=a.why)
    nxt = "./awt effect apply %s --target %s" % (i, shlex.quote(a.target)) if a.run else \
        "send %s by hand, then ./awt effect mark %s sent" % (body, i)
    out("%s planned; next: %s" % (i, nxt))


def eff_show(a):
    e = get_eff(load(), a.id)
    for k, v in e.items():
        if k not in ("hist", "claims", "chost", "manual"):
            out("%s: %s" % (k, v))
    out("history:")
    for r in e["hist"]:
        out("  %s %s attempt=%s %s" % (r["ts"], r["step"], r.get("attempt", 1), r.get("reason") or r.get("ref") or r.get("why") or ""))
    if e.get("body"):
        out("body path: " + e["body"])
        try:
            with open(P(e["body"]), encoding="utf-8", errors="replace") as g:
                out("----\n" + g.read())
        except OSError:
            out("(body unreadable)")


def sh(cmd, env, logf, timeout):
    p = subprocess.Popen(["sh", "-c", cmd], cwd=ROOT, env=env, stdout=logf, stderr=subprocess.STDOUT, start_new_session=True)
    try:
        return p.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.wait()
        return "timeout"


def eff_apply(a):
    if a.timeout < 1:
        die("--timeout must be at least 1", "give a number of seconds, 1 or more", 2)
    D = load()
    e = get_eff(D, a.id)
    if e["state"] != "planned":
        die("%s is %s, not planned" % (a.id, e["state"]), "never resend an unknown effect; ask a person, then ./awt effect mark %s sent|not-sent" % a.id)
    if not e.get("run"):
        die("%s is manual; no command to run (body: %s)" % (a.id, e.get("body")), "send it by hand, then ./awt effect mark %s sent" % a.id)
    if a.target != e["target"]:
        die("--target does not match the planned target", "use --target " + shlex.quote(e["target"]))
    for x in e.get("after") or []:
        if D["eff"].get(x, {}).get("state") != "sent":
            die("prerequisite %s is not sent" % x, "send %s first" % x)
    bpath = ""
    if e.get("body"):
        bpath = P(e["body"])
        try:
            with open(bpath, "rb") as g:
                ok = sha(g.read()) == e.get("body_sha")
        except OSError:
            ok = False
        if not ok:
            die("body changed since planning", "plan again: ./awt effect plan --target %s --body %s ..." % (shlex.quote(e["target"]), e["body"]))
    env = dict(os.environ, AWT_BODY=bpath, AWT_TARGET=e["target"])
    for d in ("blobs", "runs", "claims"):
        os.makedirs(P(".awt", d), exist_ok=True)
    if e.get("snapshot"):
        try:
            r = subprocess.run(["sh", "-c", e["snapshot"]], cwd=ROOT, env=env, capture_output=True, timeout=a.timeout)
        except subprocess.TimeoutExpired:
            die("snapshot timed out after %ss; nothing was consumed" % a.timeout, "fix the --snapshot command and plan again")
        if r.returncode or not r.stdout:
            die("snapshot failed or printed nothing; nothing was consumed", "fix the --snapshot command and plan again")
        with open(P(".awt", "blobs", sha(r.stdout)), "wb") as g:
            g.write(r.stdout)
    e2 = load()["eff"][a.id]
    if (e2["step"], e2["attempt"]) != ("planned", e["attempt"]):
        die("%s changed while it was being prepared (now %s)" % (a.id, e2["step"]), "check ./awt effect show " + a.id)
    try:
        os.close(os.open(claim_path(e), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644))
    except FileExistsError:
        die("someone else is sending %s" % a.id, "check ./awt effect show " + a.id)
    emit("effect", id=a.id, step="claimed", attempt=e["attempt"], pid=os.getpid(), timeout=a.timeout * (2 if e.get("verify") else 1))
    log = P(".awt", "runs", "%s.%s.log" % (a.id, e["attempt"]))
    with open(log, "wb") as lg:
        rc = sh(e["run"], env, lg, a.timeout)
        reason = None
        if rc == "timeout":
            reason = "timeout after %ss" % a.timeout
        elif rc != 0:
            reason = "exit code %s" % rc
        elif e.get("verify"):
            vr = sh(e["verify"], env, lg, a.timeout)
            if vr != 0:
                reason = "verify failed (%s)" % vr
    if reason:
        emit("effect", id=a.id, step="unknown", attempt=e["attempt"], reason=reason)
        die("%s is unknown: %s (log %s)" % (a.id, reason, rel(log)), "it may have been sent; ask a person, then ./awt effect mark %s sent|not-sent" % a.id)
    emit("effect", id=a.id, step="sent", attempt=e["attempt"], via="apply")
    out("%s sent (log %s)" % (a.id, rel(log)))


def eff_mark(a):
    e = get_eff(load(), a.id)
    st, n = e["state"], e["attempt"]
    if st == "claimed":
        die("%s is being sent by a live process" % a.id, "wait for it to finish")
    legal = {"planned": ["sent"] if e["manual"] else [], "unknown": ["sent", "not-sent"], "conflict": ["sent", "not-sent"]}
    if a.to == "dropped" and st == "planned":
        pass
    elif a.to not in legal.get(st, []):
        die("cannot mark %s %s from %s" % (a.id, a.to, st), "legal marks from %s: %s" % (st, ", ".join(legal.get(st, []) + (["dropped"] if st == "planned" else [])) or "none (terminal)"))
    if a.to == "not-sent":
        emit("effect", id=a.id, step="planned", attempt=n + 1, why=a.why)
    else:
        emit("effect", id=a.id, step=a.to, attempt=n, ref=a.ref, why=a.why, via="mark")
    out("%s %s" % (a.id, a.to))


# ---------- doctor and save ----------
def netmount(path):
    try:
        best = ("", "")
        for ln in subprocess.run(["mount"], capture_output=True, text=True, timeout=5).stdout.splitlines():
            m = re.match(r"(.+?) on (.+?) \((\w[\w.]*)", ln)
            if m and (path == m.group(2) or path.startswith(m.group(2).rstrip("/") + "/")) and len(m.group(2)) >= len(best[0]):
                best = (m.group(2), m.group(3))
        return best[1] in ("nfs", "smbfs", "afpfs", "cifs", "webdav", "osxfuse", "macfuse") or best[1].startswith("fuse.")
    except Exception:
        return False


def cmd_doctor(a):
    global ROOT
    res = []

    def line(level, msg):
        res.append(level)
        out("%s %s" % (level, msg))

    line("ok" if sys.version_info >= (3, 9) else "fail", "python %d.%d" % sys.version_info[:2])
    ROOT = find_root(a.dir)
    if not ROOT:
        line("fail", "no task root (./awt init)")
        sys.exit(1)
    line("ok", "task root " + ROOT)
    pr = P(".awt", ".probe-%d" % os.getpid())
    try:
        fd = os.open(pr, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL, 0o644)
        os.write(fd, b"a")
        os.lseek(fd, 0, 0)
        os.write(fd, b"b")
        os.close(fd)
        with open(pr, "rb") as g:
            good = g.read() == b"ab"
        try:
            os.close(os.open(pr, os.O_WRONLY | os.O_CREAT | os.O_EXCL))
            good = False
        except FileExistsError:
            pass
        os.unlink(pr)
        line("ok" if good else "fail", "O_APPEND and O_EXCL behave")
    except OSError as x:
        line("fail", "O_APPEND/O_EXCL probe failed: %s" % x)
    ag = P("AGENTS.md")
    has = os.path.exists(ag) and BLOCK_BEGIN in open(ag, encoding="utf-8", errors="replace").read()
    line("ok" if has else "fail", "AGENTS.md has the awt block" if has else "AGENTS.md lacks the awt block (./awt init)")
    try:
        r = subprocess.run([sys.executable, os.path.realpath(__file__), "--dir", ROOT, "resume", "--hook"], capture_output=True, text=True, timeout=30)
        line("ok" if r.returncode == 0 and r.stdout.strip() else "fail", "resume --hook prints a brief")
    except Exception as x:
        line("fail", "resume --hook did not run: %s" % x)
    D = load()
    line("fail" if D["unread"] else "ok", "events.jsonl unreadable: %s (fix .awt/events.jsonl)" % D["unread"] if D["unread"] else "events.jsonl is readable")
    line("warn" if D["bad"] else "ok", "%d quarantined rows%s" % (D["bad"], " (.awt/events.jsonl lines: %s)" % ", ".join(map(str, D["bad_lines"][:20])) if D["bad_lines"] else ""))
    odd = any(m in ROOT for m in ("iCloud", "Dropbox", "OneDrive", "Google Drive")) or netmount(ROOT)
    line("warn" if odd else "ok", "path is a sync folder or network mount" if odd else "path is local")
    cm = find_claude_md(ROOT)
    line("warn" if cm else "ok", "CLAUDE.md at %s may hide AGENTS.md (add @AGENTS.md)" % cm if cm else "no CLAUDE.md in the way")
    try:
        with open(P(".claude", "settings.json"), encoding="utf-8") as g:
            st = g.read()
        good = "awt resume --hook" in st and "awt effect apply" in st
    except OSError:
        good = False
    line("ok" if good else "warn", "settings has the awt hook and ask rule" if good else ".claude/settings.json lacks the awt hook or ask rule")
    x = os.access(P("awt"), os.X_OK)
    line("ok" if x else "warn", "awt is executable" if x else "awt is not executable here (chmod +x awt)")
    try:
        rem = git(ROOT, "remote").stdout.split() if git(ROOT, "rev-parse", "--show-toplevel").stdout.strip() == ROOT else []
    except Exception:
        rem = []
    line("warn" if rem else "ok", "git remote %s: task data would be pushed if committed; check it is private" % rem[0] if rem else "no git remote")
    bad = [e["id"] for e in D["eff"].values() if e["state"] in ("unknown", "conflict")]
    line("warn" if bad else "ok", "open unknown/conflict effects: " + " ".join(bad) if bad else "no unknown effects")
    sys.exit(1 if "fail" in res else 0)


def cmd_save(a):
    def g(*x):
        try:
            return subprocess.run(["git", "-C", ROOT] + list(x), capture_output=True, text=True)
        except FileNotFoundError:
            die("git is not installed or not on PATH", "install git; awt never installs it")
    r = g("rev-parse", "--show-toplevel")
    if r.returncode:
        die("not a git repo", "git init  (in %s; awt never runs it)" % ROOT)
    if os.path.realpath(r.stdout.strip()) != ROOT:
        die("task sits inside another repo (%s)" % r.stdout.strip(), "git init  (in %s)" % ROOT)
    nested = []
    for dp, dns, fns in os.walk(ROOT):
        dns[:] = [d for d in dns if d != ".git"]
        if dp != ROOT and (".git" in os.listdir(dp)):
            nested.append(rel(dp))
            dns[:] = []
    if g("add", "-A", "--", ".", *[":(exclude)" + n for n in nested]).returncode:
        die("git add failed", "run git status in " + ROOT)
    held = []
    for f in [x for x in g("diff", "--cached", "--name-only", "-z").stdout.split("\0") if x]:
        try:
            if os.path.getsize(P(f)) > K["big"]:
                continue
            with open(P(f), "rb") as fh:
                b = fh.read()
        except OSError:
            continue
        n = None if b"\0" in b else secret(b.decode("utf-8", "replace"))
        if n:
            g("reset", "-q", "--", f)
            held.append("%s (%s)" % (f, n))
    for n in nested:
        print("note: nested git repo not saved: " + n, file=sys.stderr)
    for h in held:
        print("note: unstaged, looks like a secret: " + h, file=sys.stderr)
    if g("diff", "--cached", "--quiet").returncode == 0:
        return out("nothing to commit")
    r = g("commit", "--no-gpg-sign", "-q", "-m", a.message)
    if r.returncode:
        die("git commit failed: " + (r.stderr or r.stdout).strip(), "set git user.name and user.email")
    out("saved %s" % g("rev-parse", "--short", "HEAD").stdout.strip())


# ---------- main ----------
def build():
    p = argparse.ArgumentParser(prog="awt", add_help=False)
    sp = p.add_subparsers(dest="verb")

    def V(parent, name, pos=(), opt=()):
        q = parent.add_parser(name)
        for n, kw in pos:
            q.add_argument(n, **kw)
        for fl, kw in opt:
            q.add_argument(*fl, **kw)
        return q
    T, F = {}, dict(action="store_true")
    V(sp, "init", opt=[(("--goal",), T), (("--done",), T), (("--kind",), dict(choices=KINDS)), (("--name",), T), (("--key",), T)])
    V(sp, "resume", opt=[(("--hook",), F), (("--scope",), {})])
    V(sp, "list", [("section", dict(nargs="?", choices=SECTIONS))], [(("--all",), F)])
    V(sp, "find", [("term", T)])
    V(sp, "state", opt=[(("--now",), dict(required=True)), (("--next",), dict(required=True)), (("--scope",), T)])
    V(sp, "note", [("text", T)])
    V(sp, "decide", [("choice", T)], [(("--why",), dict(required=True)), (("--supersedes",), T), (("--tag",), dict(action="append"))])
    V(sp, "ask", [("text", T)])
    V(sp, "answer", [("id", T), ("text", T)])
    V(sp, "ref", [("target", T)], [(("--title",), dict(required=True)), (("--why",), T), (("--kind",), T), (("--no-access",), F)])
    V(sp, "capture", [("file", dict(nargs="?"))], [(("--from",), dict(required=True, dest="from_")), (("--title",), dict(required=True)), (("--ref",), T)])
    V(sp, "supersede", [("old", T), ("new", T)], [(("--why",), T)])
    V(sp, "status", [("value", dict(choices=ENUM["status.status"]))])
    V(sp, "doctor")
    V(sp, "save", [("message", T)])
    V(sp, "help")
    es = V(sp, "effect").add_subparsers(dest="eop")
    V(es, "plan", opt=[(("--target",), dict(required=True)), (("--body",), T), (("--run",), T), (("--class",), dict(dest="cls", choices=["additive", "overwrite"], default="additive")),
                       (("--snapshot",), T), (("--verify",), T), (("--after",), dict(action="append")), (("--again",), F), (("--why",), T)])
    V(es, "show", [("id", T)])
    V(es, "apply", [("id", T)], [(("--target",), dict(required=True)), (("--timeout",), dict(type=int, default=K["timeout"]))])
    V(es, "mark", [("id", T), ("to", dict(choices=["sent", "not-sent", "dropped"]))], [(("--ref",), T), (("--why",), T)])
    return p


def main(argv):
    global ROOT, BY
    BY = os.environ.get("AWT_BY") or "agent"
    for f in (sys.stdout, sys.stderr):
        f.reconfigure(encoding="utf-8", errors="backslashreplace")
    rest, d, i = [], None, 0
    while i < len(argv):
        x = argv[i]
        if x in ("--dir", "--by") and i + 1 < len(argv):
            if x == "--dir":
                d = argv[i + 1]
            else:
                BY = argv[i + 1]
            i += 2
            continue
        if x.startswith("--dir=") or x.startswith("--by="):
            if x.startswith("--dir="):
                d = x[6:]
            else:
                BY = x[5:]
        else:
            rest.append(x)
        i += 1
    if rest[:1] == ["--version"]:
        return out("awt " + VERSION)
    if rest[:2] == ["help", "agents"]:
        return out(AGENT_REF)
    if not rest or rest[0] in ("help", "--help", "-h"):
        return out(USAGE)
    a = build().parse_args(rest)
    a.dir = d
    if a.verb is None or (a.verb == "effect" and not a.eop):
        die("missing verb", USAGE.splitlines()[0], 2)
    if a.verb == "help":
        return out(USAGE)
    if a.verb == "init":
        return cmd_init(a)
    if a.verb == "resume" and a.hook:
        return cmd_resume(a)
    ROOT = find_root(d)
    if not ROOT:
        if a.verb == "doctor":
            return cmd_doctor(a)
        die("no task found", "./awt init", 4)
    globals()[("eff_" + a.eop) if a.verb == "effect" else ("cmd_" + a.verb)](a)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
        sys.stdout.flush()
    except PermissionError as x:
        print("error: permission denied: %s" % x.filename, file=sys.stderr)
        print("fix: a person should run: %s" % shlex.join(["./awt"] + sys.argv[1:]), file=sys.stderr)
        sys.exit(3)
    except BrokenPipeError:
        sys.exit(0)
    except Exception as x:
        die("%s: %s" % (type(x).__name__, x), "run ./awt doctor; if the cause is not the path or file named above, report this line")
