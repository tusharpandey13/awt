def related_limit(a):
    """How many related records decide and ask list: --related, else AWT_RELATED, else 3. A bad flag is a usage error; a bad variable is ignored."""
    if a.related is not None:
        if not 0 <= a.related <= 20:
            die("--related must be 0 to 20", "awt decide ... --related 3", 2)
        return a.related
    v = os.environ.get("AWT_RELATED")
    if v:
        try:
            if 0 <= int(v) <= 20:
                return int(v)
        except ValueError:
            pass
        print("warning: AWT_RELATED=%s ignored (use 0 to 20); using 3" % v[:40], file=sys.stderr)
    return 3


def related_ms():
    """The lookup budget in ms: AWT_RELATED_MS (a test hook), else 2000; anything that is not a number of at least 0 means 2000."""
    try:
        v = float(os.environ.get("AWT_RELATED_MS", "2000"))
        return v if v >= 0 and v == v and v != float("inf") else 2000.0
    except ValueError:
        return 2000.0


def show_related(text, limit, skip):
    """The write is already done and printed; nothing here may change its outcome."""
    if not limit:
        return
    try:
        deadline = time.time() + related_ms() / 1000  # taken before the tree walk
        nodes, over = scope_nodes(True, False, False, deadline)
        lines, stopped = recall(text, limit, nodes, skip, deadline, 200 - len("related: "))
        stopped = stopped or (over and time.time() >= deadline)
        for l in lines:
            out("related: " + l)
        if stopped:
            out("related: (lookup stopped at 2 s; run awt find --like ...)")
    except Exception:
        pass


