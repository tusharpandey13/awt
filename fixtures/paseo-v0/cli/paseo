#!/bin/sh
# Stand-in for the paseo CLI: serves captured JSON shapes. Used by tests/test_migrate_paseo.py.
d="$(cd "$(dirname "$0")" && pwd)"
args="$*"
case "$args" in
  "project ls --json") cat "$d/project-ls.json" ;;
  "workspace ls --json") cat "$d/workspace-ls.json" ;;
  "ls -a -g --json") cat "$d/ls.json" ;;
  "inspect "*" --json") id="${2}"; cat "$d/inspect-$id.json" ;;
  *) echo "stub paseo: unsupported: $args" >&2; exit 2 ;;
esac
